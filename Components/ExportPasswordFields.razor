@* Password + confirmation for an encrypted (AES-256) Excel export. The parent owns the values
   and validates them with ProtectedExport.Validate before saving. *@

<div class="export-password">
    <div class="export-password-head">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Set a password for this file</span>
    </div>
    <div class="export-password-fields">
        <div class="export-password-field">
            <label class="export-card-filter-label" for="@($"{IdPrefix}-pw")">Password</label>
            <input id="@($"{IdPrefix}-pw")" class="filter-select export-password-input"
                   type="@(_show ? "text" : "password")" autocomplete="new-password"
                   value="@Password" @oninput="e => PasswordChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                   @onkeydown="HandleKeyDown" disabled="@Disabled" />
        </div>
        <div class="export-password-field">
            <label class="export-card-filter-label" for="@($"{IdPrefix}-pw2")">Confirm password</label>
            <input id="@($"{IdPrefix}-pw2")" class="filter-select export-password-input"
                   type="@(_show ? "text" : "password")" autocomplete="new-password"
                   value="@Confirmation" @oninput="e => ConfirmationChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                   @onkeydown="HandleKeyDown" disabled="@Disabled" />
        </div>
        <label class="export-password-show">
            <input type="checkbox" checked="@_show" @onchange="e => _show = e.Value is true" disabled="@Disabled" />
            <span>Show</span>
        </label>
    </div>

    @* Live checks, so what is still missing is visible before Save is pressed. *@
    <ul class="export-password-checks" aria-live="polite">
        <li class="@CheckClass(LongEnough)">
            @CheckIcon(LongEnough)
            <span>At least @ProtectedExport.MinPasswordLength characters</span>
        </li>
        <li class="@CheckClass(Matches)">
            @CheckIcon(Matches)
            <span>Both entries match</span>
        </li>
    </ul>

    @if (Error is not null)
    {
        <p class="export-password-hint export-password-hint--error" role="alert">@Error</p>
    }
    else
    {
        <p class="export-password-hint">
            Excel asks for this password every time the file is opened. It is not stored anywhere,
            so a lost password cannot be recovered.
        </p>
    }
</div>

@code {
    /// <summary>Makes the input ids unique when more than one instance can exist on a page.</summary>
    [Parameter] public string IdPrefix { get; set; } = "export";

    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }

    [Parameter] public string Confirmation { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ConfirmationChanged { get; set; }

    /// <summary>Shown in place of the hint, e.g. after a failed attempt to save.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Invoked when Enter is pressed in either field, so the dialog can be completed from the keyboard.</summary>
    [Parameter] public EventCallback OnSubmit { get; set; }

    private bool _show;

    private bool LongEnough => Password.Length >= ProtectedExport.MinPasswordLength;
    private bool Matches => Password.Length > 0 && Password == Confirmation;

    private static string CheckClass(bool met) => met ? "export-password-check export-password-check--met" : "export-password-check";

    private static RenderFragment CheckIcon(bool met) => met
        ? @<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        : @<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>;

    private Task HandleKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" && !Disabled ? OnSubmit.InvokeAsync() : Task.CompletedTask;
}
