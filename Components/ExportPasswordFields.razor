@* Password + confirmation for an encrypted (AES-256) Excel export. The parent owns the values
   and validates them with ProtectedExport.Validate before saving. *@

<div class="export-password">
    <div class="export-password-head">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>The file is saved as a password-protected Excel workbook (AES-256).</span>
    </div>
    <div class="export-password-fields">
        <div class="export-password-field">
            <label class="export-card-filter-label" for="@($"{IdPrefix}-pw")">Password</label>
            <input id="@($"{IdPrefix}-pw")" class="filter-select export-password-input"
                   type="@(_show ? "text" : "password")" autocomplete="new-password"
                   value="@Password" @oninput="e => PasswordChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                   disabled="@Disabled" />
        </div>
        <div class="export-password-field">
            <label class="export-card-filter-label" for="@($"{IdPrefix}-pw2")">Confirm password</label>
            <input id="@($"{IdPrefix}-pw2")" class="filter-select export-password-input"
                   type="@(_show ? "text" : "password")" autocomplete="new-password"
                   value="@Confirmation" @oninput="e => ConfirmationChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
                   disabled="@Disabled" />
        </div>
        <label class="export-password-show">
            <input type="checkbox" checked="@_show" @onchange="e => _show = e.Value is true" disabled="@Disabled" />
            <span>Show</span>
        </label>
    </div>
    <p class="export-password-hint @(Error is null ? "" : "export-password-hint--error")" role="@(Error is null ? null : "alert")">
        @(Error ?? $"At least {ProtectedExport.MinPasswordLength} characters. Excel asks for it when the file is opened. The password is not stored — if it is lost the file cannot be opened.")
    </p>
</div>

@code {
    /// <summary>Makes the input ids unique when more than one instance can exist on a page.</summary>
    [Parameter] public string IdPrefix { get; set; } = "export";

    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }

    [Parameter] public string Confirmation { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ConfirmationChanged { get; set; }

    /// <summary>Shown in place of the hint, e.g. after a failed attempt to save.</summary>
    [Parameter] public string? Error { get; set; }

    [Parameter] public bool Disabled { get; set; }

    private bool _show;
}
