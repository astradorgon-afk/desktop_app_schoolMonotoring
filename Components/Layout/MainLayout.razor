@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="admin-sidebar @(_collapsed ? "collapsed" : "")">
        <NavMenu Collapsed="@_collapsed" OnToggle="ToggleSidebar" />
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div class="topbar-left">
                <span class="topbar-breadcrumb">Attendance & Classroom Monitor</span>
            </div>
            <div class="topbar-right">
                <span class="topbar-user">admin@example.com</span>
                <button class="topbar-logout" @onclick="Logout">Logout</button>
            </div>
        </header>

        <main class="admin-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _collapsed;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private void ToggleSidebar()
    {
        _collapsed = !_collapsed;
    }

    private void Logout()
    {
        Navigation.NavigateTo("/login");
    }
}
