@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@using AttendanceUI.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation

@inherits LayoutComponentBase

@if (_isReady)
{
    <div class="admin-shell">
        <div class="admin-bg-blob" style="position:absolute;top:-20%;right:-10%;width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,0.08) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:0;"></div>
        <div class="admin-bg-blob" style="position:absolute;bottom:-15%;left:-5%;width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,0.06) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:0;"></div>
        <div class="admin-bg-blob" style="position:absolute;top:40%;left:50%;width:400px;height:400px;background:radial-gradient(circle,rgba(59,130,246,0.05) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:0;"></div>

        <aside class="admin-sidebar @(_collapsed ? "collapsed" : "")">
            <NavMenu Collapsed="@_collapsed" OnToggle="ToggleSidebar" Role="@_currentSession?.Role" />
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div class="topbar-left">
                    <span class="topbar-breadcrumb">@(_isTeacher ? "Teacher Portal" : _isStudent ? "Student Portal" : "Attendance & Classroom Monitor")</span>
                </div>
                <div class="topbar-right">
                    <span class="topbar-user">@_currentSession?.DisplayName</span>
                    <span class="topbar-role">@_currentSession?.Role.ToString()</span>
                    <button class="topbar-logout" @onclick="Logout">Logout</button>
                </div>
            </header>

            <main class="admin-content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool _collapsed;
    private UserSession? _currentSession;
    private bool _isReady;
    private bool _isTeacher;
    private bool _isStudent;

    protected override async Task OnInitializedAsync()
    {
        _currentSession = await AuthService.GetCurrentSessionAsync();

        if (_currentSession is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _isTeacher = _currentSession.Role == UserRole.TEACHER;
        _isStudent = _currentSession.Role == UserRole.STUDENT;
        _isReady = true;
    }

    private void ToggleSidebar()
    {
        _collapsed = !_collapsed;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
