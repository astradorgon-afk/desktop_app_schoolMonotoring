@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@using AttendanceUI.Services
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@inherits LayoutComponentBase
@implements IDisposable

@if (_isReady)
{
    <div class="admin-shell">
        <div class="admin-bg-blob" style="position:absolute;top:-20%;right:-10%;width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,0.08) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:0;"></div>
        <div class="admin-bg-blob" style="position:absolute;bottom:-15%;left:-5%;width:500px;height:500px;background:radial-gradient(circle,rgba(139,92,246,0.06) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:0;"></div>
        <div class="admin-bg-blob" style="position:absolute;top:40%;left:50%;width:400px;height:400px;background:radial-gradient(circle,rgba(59,130,246,0.05) 0%,transparent 70%);border-radius:50%;pointer-events:none;z-index:0;"></div>

        <aside class="admin-sidebar @(_collapsed ? "collapsed" : "") @(_navOpen ? "mobile-open" : "")">
            <NavMenu Collapsed="@_collapsed" OnToggle="ToggleSidebar" Role="@_currentSession?.Role" />
        </aside>

        @* Backdrop for the mobile drawer. Hidden above the mobile breakpoint. *@
        <div class="admin-scrim @(_navOpen ? "is-open" : "")" @onclick="CloseNav"></div>

        <div class="admin-main">
            <header class="admin-topbar">
                <div class="topbar-left">
                    <button class="topbar-menu-btn" @onclick="ToggleNav" aria-label="@(_navOpen ? "Close navigation" : "Open navigation")" aria-expanded="@_navOpen">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                    <span class="topbar-breadcrumb">@(_isTeacher ? "Teacher Portal" : _isStudent ? "Student Portal" : "Attendance & Classroom Monitor")</span>
                </div>
                <div class="topbar-right">
                    <button class="theme-toggle" @onclick="ToggleTheme" title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")">
                        @if (_isDark)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                        }
                    </button>
                    <span class="topbar-user">@_currentSession?.DisplayName</span>
                    <span class="topbar-role">@_currentSession?.Role.ToString()</span>
                    <button class="topbar-logout" @onclick="Logout">Logout</button>
                </div>
            </header>

            <main class="admin-content">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool _collapsed;
    private bool _navOpen;
    private UserSession? _currentSession;
    private bool _isReady;
    private bool _isTeacher;
    private bool _isStudent;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        _currentSession = await AuthService.GetCurrentSessionAsync();

        if (_currentSession is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var theme = await JS.InvokeAsync<string>("window.__theme.get");
        _isDark = theme == "dark";

        _isTeacher = _currentSession.Role == UserRole.TEACHER;
        _isStudent = _currentSession.Role == UserRole.STUDENT;
        _isReady = true;

        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.__theme.init");
        }
    }

    private void ToggleSidebar()
    {
        _collapsed = !_collapsed;
    }

    // ── Mobile drawer ──
    // Below the mobile breakpoint the sidebar slides in over the content instead of
    // taking a 260px column, which would leave ~150px for the page on a phone.

    private void ToggleNav() => _navOpen = !_navOpen;

    private void CloseNav() => _navOpen = false;

    // Picking a destination should dismiss the drawer, otherwise it covers the page
    // that was just navigated to.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!_navOpen)
        {
            return;
        }

        _navOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private async Task ToggleTheme()
    {
        var result = await JS.InvokeAsync<string>("window.__theme.toggle");
        _isDark = result == "dark";
        StateHasChanged();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}
