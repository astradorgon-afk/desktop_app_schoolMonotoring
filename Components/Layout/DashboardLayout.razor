@using AttendanceUI.Models.Auth
@using AttendanceUI.Services
@using Microsoft.JSInterop
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@inherits LayoutComponentBase

@if (_isReady)
{
    <div class="dash-shell">
        <AppErrorBoundary @ref="_errorBoundary">
            @Body
        </AppErrorBoundary>
    </div>
}

@code {
    private AppErrorBoundary? _errorBoundary;
    private bool _isReady;

    // A new page arrives as new parameters: clear any error the previous page left behind.
    protected override void OnParametersSet() => _errorBoundary?.Recover();

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();

        if (session is null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _isReady = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.__theme.init");
        }
    }
}
