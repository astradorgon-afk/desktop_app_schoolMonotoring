@page "/analytics"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using System.Text.Json
@implements IAsyncDisposable
@inject IAuthService AuthService
@inject ITeacherService TeacherService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageHeader Title="Analytics" Subtitle="@(_isTeacher ? "Your class attendance breakdown" : "Attendance breakdown, trends, and classroom insights")">
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading analytics...</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else if (_data is null)
{
    @if (_isTeacher)
    {
        <div style="padding:0 32px;">
            <div class="page-card" style="text-align:center;padding:64px 32px;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:16px;color:var(--clr-text-muted);">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
                <h3 style="color:var(--clr-text-secondary);margin-bottom:8px;">No Data Yet</h3>
                <p class="text-muted">Start taking attendance to see your analytics here.</p>
            </div>
        </div>
    }
}
else if (_data is not null)
{
    var circumference = 326.7;
    var overallRate = _data.OverallAttendanceRate;
    var overallOffset = circumference * (1 - overallRate / 100);

    var hasTodaySessions = _data.TotalTodayRecords > 0;
    var todayPct = hasTodaySessions ? Math.Round((double)_data.PresentToday / _data.TotalTodayRecords * 100, 1) : 0;
    var todayOffset = hasTodaySessions ? circumference * (1 - todayPct / 100) : circumference;

    var lateOffset = circumference * (1 - _data.LateRate / 100);
    var absentOffset = circumference * (1 - _data.AbsentRate / 100);

    <div class="analytics-grid">
        <div class="ring-card">
            <div class="ring-label">Overall Attendance</div>
            <svg class="ring-svg" viewBox="0 0 120 120">
                <circle class="ring-bg" cx="60" cy="60" r="52" />
                <circle class="ring-fill" cx="60" cy="60" r="52" stroke-dasharray="326.7" stroke-dashoffset="@overallOffset" transform="rotate(-90 60 60)" />
                <text x="60" y="56" text-anchor="middle" class="ring-value">@overallRate%</text>
                <text x="60" y="72" text-anchor="middle" class="ring-sub">@_data.TotalRecords records</text>
            </svg>
        </div>
        <div class="ring-card">
            <div class="ring-label">Present Today</div>
            <svg class="ring-svg" viewBox="0 0 120 120">
                <circle class="ring-bg" cx="60" cy="60" r="52" />
                <circle class="ring-fill ring-fill--green" cx="60" cy="60" r="52" stroke-dasharray="326.7" stroke-dashoffset="@todayOffset" transform="rotate(-90 60 60)" />
                <text x="60" y="56" text-anchor="middle" class="ring-value">@(hasTodaySessions ? $"{todayPct}%" : "—")</text>
                <text x="60" y="72" text-anchor="middle" class="ring-sub">@(hasTodaySessions ? $"{_data.PresentToday} / {_data.TotalTodayRecords}" : "No sessions")</text>
            </svg>
        </div>
        <div class="ring-card">
            <div class="ring-label">Late Rate</div>
            <svg class="ring-svg" viewBox="0 0 120 120">
                <circle class="ring-bg" cx="60" cy="60" r="52" />
                <circle class="ring-fill ring-fill--yellow" cx="60" cy="60" r="52" stroke-dasharray="326.7" stroke-dashoffset="@lateOffset" transform="rotate(-90 60 60)" />
                <text x="60" y="56" text-anchor="middle" class="ring-value">@(_data.LateRate)%</text>
                <text x="60" y="72" text-anchor="middle" class="ring-sub">@_data.TotalLate late</text>
            </svg>
        </div>
        <div class="ring-card">
            <div class="ring-label">Absent Rate</div>
            <svg class="ring-svg" viewBox="0 0 120 120">
                <circle class="ring-bg" cx="60" cy="60" r="52" />
                <circle class="ring-fill ring-fill--red" cx="60" cy="60" r="52" stroke-dasharray="326.7" stroke-dashoffset="@absentOffset" transform="rotate(-90 60 60)" />
                <text x="60" y="56" text-anchor="middle" class="ring-value">@(_data.AbsentRate)%</text>
                <text x="60" y="72" text-anchor="middle" class="ring-sub">@_data.TotalAbsent absent</text>
            </svg>
        </div>
    </div>

    <div class="analytics-content">
        <div class="chart-card chart-card--wide">
            <h2 class="card-heading">Attendance by Day of Week</h2>
            <div class="chart-container" style="height:200px;">
                <canvas id="chart-dow"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <h2 class="card-heading">Attendance by Class</h2>
            @if (_data.SectionStats.Count == 0)
            {
                <p style="text-align:center;padding:32px 0;color:var(--clr-text-muted);">No class data yet.</p>
            }
            else
            {
                <div class="chart-container" style="height:200px;">
                    <canvas id="chart-class"></canvas>
                </div>
            }
        </div>
    </div>

    <div class="analytics-footer">
        <div class="chart-card">
            <h2 class="card-heading">Monthly Trend</h2>
            @if (_data.MonthlyTrends.Count > 1)
            {
                <div class="chart-container" style="height:220px;">
                    <canvas id="chart-trend"></canvas>
                </div>
            }
            else if (_data.MonthlyTrends.Count == 1)
            {
                var single = _data.MonthlyTrends[0];
                <div style="text-align:center;padding:24px 0;">
                    <div style="font-size:48px;font-weight:700;color:#6366f1;margin-bottom:4px;">@single.Percentage%</div>
                    <div style="font-size:14px;color:var(--clr-text-secondary);">@single.Label attendance rate</div>
                    <div style="margin-top:12px;font-size:12px;color:var(--clr-text-muted);">More months will appear as data accumulates.</div>
                </div>
            }
            else
            {
                <div style="text-align:center;padding:32px 0;color:var(--clr-text-muted);">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:8px;">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                    </svg>
                    <p>Not enough data for a trend yet.</p>
                </div>
            }
            @if (_data.MonthlyTrends.Count > 0)
            {
                var trendAvg = Math.Round(_data.MonthlyTrends.Average(m => m.Percentage), 1);
                <div class="trend-summary">
                    <div class="trend-stat">
                        <span class="trend-stat-value">@trendAvg%</span>
                        <span class="trend-stat-label">Average</span>
                    </div>
                    @if (_data.MonthlyTrends.Count > 1)
                    {
                        <div class="trend-stat">
                            <span class="trend-stat-value @(_data.TrendChange > 0 ? "trend-stat-value--up" : (_data.TrendChange < 0 ? "trend-stat-value--down" : ""))">
                                @(_data.TrendChange > 0 ? "+" : "")@(_data.TrendChange)%
                            </span>
                            <span class="trend-stat-label">vs Last Month</span>
                        </div>
                    }
                    <div class="trend-stat">
                        <span class="trend-stat-value">@_data.TotalStudents</span>
                        <span class="trend-stat-label">Total Students</span>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private TeacherAnalyticsData? _data;
    private bool _isLoading = true;
    private bool _isTeacher;
    private bool _didInit;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    private static readonly JsonSerializerOptions _json = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null && !_didInit)
        {
            _didInit = true;
            await InitCharts();
        }
    }

    private async Task InitCharts()
    {
        if (_data is null) return;

        if (_data.MonthlyTrends.Count > 1)
        {
            var labels = _data.MonthlyTrends.Select(m => m.Label).ToArray();
            var values = _data.MonthlyTrends.Select(m => m.Percentage).ToArray();
            await JS.InvokeVoidAsync("AttendanceCharts.initLineChart", "chart-trend", labels, values);
        }

        if (_data.DayOfWeekStats.Count > 0)
        {
            var labels = _data.DayOfWeekStats.Select(d => d.Day[..3]).ToArray();
            var values = _data.DayOfWeekStats.Select(d => d.Percentage).ToArray();
            var p500 = new[] { "rgba(99, 102, 241, 0.7)" };
            var colors = values.Select(_ => "rgba(99, 102, 241, 0.7)").ToArray();
            await JS.InvokeVoidAsync("AttendanceCharts.initBarChart", "chart-dow", labels, values, colors);
        }

        if (_data.SectionStats.Count > 0)
        {
            var labels = _data.SectionStats.Select(s => s.SectionName).ToArray();
            var values = _data.SectionStats.Select(s => s.Percentage).ToArray();
            var palette = new[] { "#6366f1", "#22c55e", "#eab308", "#ef4444", "#8b5cf6", "#06b6d4", "#f97316", "#ec4899" };
            var colors = values.Select((_, i) => palette[i % palette.Length]).ToArray();
            await JS.InvokeVoidAsync("AttendanceCharts.initBarChart", "chart-class", labels, values, colors);
        }
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            _isTeacher = session.Role == UserRole.TEACHER;

            if (_isTeacher)
            {
                var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
                if (teacher is null)
                {
                    _error = "Teacher profile not found.";
                    return;
                }
                _data = await TeacherService.GetTeacherAnalyticsAsync(teacher.Id, _cts.Token);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load analytics: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
