@page "/analytics"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject IAuthService AuthService
@inject ITeacherService TeacherService
@inject NavigationManager Navigation

@* Teachers see their own classes; the super administrator sees the whole school. *@
@if (_checking)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading analytics…</p>
    </div>
}
else if (_error is not null)
{
    <PageHeader Title="Analytics" Subtitle="Your class attendance breakdown" />
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else if (_teacherId is { } teacherId)
{
    <AnalyticsView Title="Analytics" Subtitle="Attendance in your classes: trends, sections and subjects" TeacherId="teacherId" />
}
else
{
    <AnalyticsView Title="Analytics" Subtitle="Attendance breakdown, trends, and classroom insights" />
}

@code {
    private bool _checking = true;
    private long? _teacherId;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            switch (session.Role)
            {
                case UserRole.TEACHER:
                    var teacher = await TeacherService.GetByUserIdAsync(session.UserId);
                    if (teacher is null)
                        _error = "Teacher profile not found.";
                    else
                        _teacherId = teacher.Id;
                    break;
                case UserRole.SUPERADMIN:
                    break; // school-wide view
                default:
                    _error = "Analytics are available to teachers and administrators.";
                    break;
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load analytics: {ex.Message}";
        }
        finally
        {
            _checking = false;
        }
    }
}
