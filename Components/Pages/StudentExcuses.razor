@page "/student/excuses"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject IStudentExcuseService ExcuseService
@inject IStudentPortalService StudentPortalService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<PageHeader Title="Excuse Letters" Subtitle="Explain an absence and attach a medical certificate or parent's letter">
    <div class="header-actions">
        <span class="header-date">@DateTime.Now.ToString("MMM dd, yyyy")</span>
    </div>
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading excuse letters...</p>
    </div>
}
else if (_fatal is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_fatal</span>
    </div>
}
else
{
    <div class="excuse-layout">
        <div class="page-card">
            <h3 class="excuse-card-title">File an excuse</h3>
            <p class="excuse-card-sub">Your adviser or subject teacher will review it. Once approved, the absences in those dates change to <strong>Excused</strong>.</p>

            @if (_formError is not null)
            {
                <div class="error-banner" style="margin-bottom:14px;">@_formError</div>
            }
            @if (_formSuccess is not null)
            {
                <div class="success-banner" style="margin-bottom:14px;">@_formSuccess</div>
            }

            <div class="excuse-form">
                <div class="excuse-row">
                    <div>
                        <label class="form-label" for="ex-from">From</label>
                        <input id="ex-from" type="date" class="form-input" max="@Today.ToString("yyyy-MM-dd")" @bind="_startDate" />
                    </div>
                    <div>
                        <label class="form-label" for="ex-to">To</label>
                        <input id="ex-to" type="date" class="form-input" max="@Today.ToString("yyyy-MM-dd")" @bind="_endDate" />
                    </div>
                </div>
                <div>
                    <label class="form-label" for="ex-cat">Reason type</label>
                    <select id="ex-cat" class="form-input" @bind="_category">
                        @foreach (var c in Categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="ex-reason">Details</label>
                    <textarea id="ex-reason" class="form-input" rows="4" maxlength="1000" placeholder="e.g. I had a fever and stayed home on doctor's advice." @bind="_reason"></textarea>
                </div>
                <div>
                    <label class="form-label" for="ex-file">Attachment <span class="excuse-optional">(optional · photo or PDF, up to 5 MB)</span></label>
                    <InputFile id="ex-file" class="form-input" accept="image/*,application/pdf" OnChange="OnFileSelected" />
                    @if (_attachmentName is not null)
                    {
                        <div class="excuse-file">
                            <span>@_attachmentName</span>
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="ClearAttachment">Remove</button>
                        </div>
                    }
                </div>
                <div>
                    <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_busy">
                        @if (_busy) { <span class="spinner-sm"></span> }
                        Submit excuse
                    </button>
                </div>
            </div>
        </div>

        <div class="page-card" style="padding:0;">
            <div style="padding:20px 24px 12px;">
                <h3 class="excuse-card-title">My excuse letters</h3>
            </div>
            @if (_items.Count == 0)
            {
                <p class="text-muted" style="padding:0 24px 24px;margin:0;">You haven't filed any excuse letters yet.</p>
            }
            else
            {
                <div class="excuse-list">
                    @foreach (var e in _items)
                    {
                        <div class="excuse-item">
                            <div class="excuse-item-head">
                                <div>
                                    <div class="excuse-item-title">@(e.Category ?? "Excuse") · @FormatRange(e.StartDate, e.EndDate)</div>
                                    <div class="excuse-item-meta">Filed @e.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")</div>
                                </div>
                                <span class="excuse-status excuse-status--@e.Status.ToLowerInvariant()">@e.Status</span>
                            </div>
                            <div class="excuse-item-body">@e.Reason</div>
                            @if (e.ReviewNotes is not null || e.ReviewedByName is not null)
                            {
                                <div class="excuse-item-review">
                                    @(e.ReviewedByName is not null ? $"{e.ReviewedByName}: " : "")@(e.ReviewNotes ?? (e.Status == "APPROVED" ? "Approved" : "Rejected"))
                                </div>
                            }
                            <div class="excuse-item-actions">
                                @if (e.HasAttachment)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => OpenAttachmentAsync(e.Id)">View attachment</button>
                                }
                                @if (e.IsPending)
                                {
                                    <button class="btn btn-ghost btn-sm" @onclick="() => CancelAsync(e.Id)" disabled="@_busy">Cancel</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private const long MaxAttachmentBytes = 5 * 1024 * 1024;
    private static readonly string[] Categories = ["Sick", "Medical appointment", "Family emergency", "Bereavement", "School activity", "Other"];

    private readonly CancellationTokenSource _cts = new();
    private UserSession? _session;
    private long _studentId;
    private bool _isLoading = true;
    private bool _busy;
    private string? _fatal;
    private string? _formError;
    private string? _formSuccess;
    private List<StudentExcuseView> _items = [];

    private DateOnly _startDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly _endDate = DateOnly.FromDateTime(DateTime.Today);
    private string _category = Categories[0];
    private string _reason = "";
    private byte[]? _attachment;
    private string? _attachmentName;
    private string? _attachmentType;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    protected override async Task OnInitializedAsync()
    {
        _session = await AuthService.GetCurrentSessionAsync();
        if (_session is null) { Navigation.NavigateTo("/login"); return; }
        if (_session.Role != UserRole.STUDENT)
        {
            _fatal = "Excuse letters are filed from a student account.";
            _isLoading = false;
            return;
        }

        try
        {
            var student = await StudentPortalService.GetStudentByUserIdAsync(_session.UserId, _cts.Token);
            if (student is null)
            {
                _fatal = "Student profile not found.";
                return;
            }
            _studentId = student.Id;

            _fatal = await ExcuseService.EnsureAvailableAsync(_cts.Token);
            if (_fatal is null)
                _items = await ExcuseService.GetForStudentAsync(_studentId, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _fatal = $"Failed to load excuse letters: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _formError = null;
        var file = e.File;
        if (file.Size > MaxAttachmentBytes)
        {
            _formError = "That file is larger than 5 MB. Please attach a smaller photo or PDF.";
            ClearAttachment();
            return;
        }
        if (!file.ContentType.StartsWith("image/") && file.ContentType != "application/pdf")
        {
            _formError = "Only photos and PDF files can be attached.";
            ClearAttachment();
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxAttachmentBytes, _cts.Token);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms, _cts.Token);
            _attachment = ms.ToArray();
            _attachmentName = file.Name;
            _attachmentType = file.ContentType;
        }
        catch (Exception ex)
        {
            _formError = $"Could not read the file: {ex.Message}";
            ClearAttachment();
        }
    }

    private void ClearAttachment()
    {
        _attachment = null;
        _attachmentName = null;
        _attachmentType = null;
    }

    private async Task SubmitAsync()
    {
        _formError = null;
        _formSuccess = null;
        if (_session is null) return;

        if (string.IsNullOrWhiteSpace(_reason))
        {
            _formError = "Please describe the reason for your absence.";
            return;
        }
        if (_endDate < _startDate)
        {
            _formError = "The \"To\" date cannot be before the \"From\" date.";
            return;
        }
        if (_endDate > Today)
        {
            _formError = "You can only file an excuse for today or earlier.";
            return;
        }

        _busy = true;
        try
        {
            var created = await ExcuseService.SubmitAsync(new SubmitStudentExcuse
            {
                StudentId = _studentId,
                Reason = _reason,
                Category = _category,
                StartDate = _startDate,
                EndDate = _endDate,
                Attachment = _attachment,
                AttachmentName = _attachmentName,
                AttachmentType = _attachmentType
            }, _session, _cts.Token);

            _items.Insert(0, created);
            _reason = "";
            ClearAttachment();
            _formSuccess = "Excuse submitted. You'll see the result here once a teacher reviews it.";
        }
        catch (InvalidOperationException ex)
        {
            _formError = ex.Message;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _formError = $"Failed to submit: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync(long id)
    {
        if (_session is null) return;
        _busy = true;
        _formError = null;
        _formSuccess = null;
        try
        {
            if (await ExcuseService.CancelAsync(id, _studentId, _session, _cts.Token))
                _items.RemoveAll(i => i.Id == id);
            else
                _formError = "This request can no longer be cancelled.";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _formError = $"Failed to cancel: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OpenAttachmentAsync(long id)
    {
        if (_session is null) return;
        try
        {
            var file = await ExcuseService.GetAttachmentAsync(id, _session, _cts.Token);
            if (file is { } f)
                await AttachmentOpener.OpenAsync(f.Data, f.Name);
        }
        catch (Exception ex)
        {
            _formError = $"Could not open the attachment: {ex.Message}";
        }
    }

    private static string FormatRange(DateOnly start, DateOnly end)
        => start == end ? start.ToString("MMM dd, yyyy") : $"{start:MMM dd} – {end:MMM dd, yyyy}";

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
