@page "/admin/settings"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@inject IAttendanceSettingsService SettingsService
@inject IAuthService AuthService
@implements IDisposable

<PageHeader Title="Attendance Settings" Subtitle="School-wide rules applied when teachers scan student QR codes" />

@if (!_authorized)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>You do not have permission to change attendance settings.</span>
    </div>
}
else if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading settings...</p>
    </div>
}
else
{
    <div style="padding:0 32px 32px;max-width:640px;">
        @if (_error is not null)
        {
            <div class="error-banner" style="margin-bottom:16px;">@_error</div>
        }
        @if (_saved)
        {
            <div class="success-banner" style="margin-bottom:16px;">Settings saved. New scans use these rules immediately.</div>
        }

        <div class="page-card">
            <div style="display:flex;flex-direction:column;gap:20px;">
                <div>
                    <label class="form-label" for="set-grace">Late grace period (minutes)</label>
                    <input id="set-grace" type="number" min="0" max="120" class="form-input" style="max-width:160px;" @bind="_grace" />
                    <p class="text-muted" style="font-size:12px;margin:6px 0 0;">
                        Students scanned more than this many minutes after the scheduled start are marked <strong>Late</strong>.
                        Currently a class starting at 7:30 AM marks students late from @LateFrom.
                    </p>
                </div>
                <div style="display:flex;gap:10px;">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">
                        @if (_busy) { <span class="spinner-sm"></span> }
                        Save settings
                    </button>
                    <button class="btn btn-ghost" @onclick="ResetDefaults" disabled="@_busy">Restore default (15 min)</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private UserSession? _session;
    private bool _authorized = true;
    private bool _isLoading = true;
    private bool _busy;
    private bool _saved;
    private string? _error;
    private int _grace = AttendanceRules.Default.LateGraceMinutes;

    private string LateFrom => new TimeOnly(7, 30).AddMinutes(Math.Clamp(_grace, 0, 120) + 1).ToString("h:mm tt");

    protected override async Task OnInitializedAsync()
    {
        _session = await AuthService.GetCurrentSessionAsync();
        _authorized = _session?.Role == UserRole.SUPERADMIN;
        if (!_authorized)
        {
            _isLoading = false;
            return;
        }

        try
        {
            var rules = await SettingsService.GetRulesAsync(_cts.Token);
            _grace = rules.LateGraceMinutes;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to load settings: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ResetDefaults()
    {
        _grace = AttendanceRules.Default.LateGraceMinutes;
        _saved = false;
    }

    private async Task SaveAsync()
    {
        if (_session is null) return;
        _busy = true;
        _saved = false;
        _error = null;
        try
        {
            _error = await SettingsService.SaveRulesAsync(new AttendanceRules(_grace),
                _session.UserId, _session.DisplayName, _session.Role.ToString(), _cts.Token);
            _saved = _error is null;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to save settings: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
