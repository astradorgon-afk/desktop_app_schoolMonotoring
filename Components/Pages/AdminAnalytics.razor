@page "/admin/analytics"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject IAuthService AuthService

@if (_checking)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading analytics…</p>
    </div>
}
else if (!_authorized)
{
    <PageHeader Title="Admin Analytics" Subtitle="System-wide attendance breakdown, trends, and institutional insights" />
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>Only the super administrator can view admin analytics.</span>
    </div>
}
else
{
    <AnalyticsView Title="Admin Analytics" Subtitle="System-wide attendance breakdown, trends, and institutional insights" />
}

@code {
    private bool _checking = true;
    private bool _authorized;

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        _authorized = session?.Role == UserRole.SUPERADMIN;
        _checking = false;
    }
}
