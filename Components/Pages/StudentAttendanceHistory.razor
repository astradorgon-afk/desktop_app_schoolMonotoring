@page "/student/attendance"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject IStudentPortalService StudentPortalService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageHeader Title="Attendance History" Subtitle="@($"Full attendance record for {_fullName}")">
    <div class="header-actions">
        <a href="/student/dashboard" class="btn-login" style="text-decoration:none;padding:8px 16px;font-size:13px;display:inline-flex;align-items:center;gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Back to Dashboard
        </a>
    </div>
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading attendance history...</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else
{
    <div style="padding:0 32px 32px;">
        <div class="page-card">
            @if (_records.Count == 0)
            {
                <div style="text-align:center;padding:48px 0;color:#94a3b8;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
                    </svg>
                    <p>No attendance records found.</p>
                </div>
            }
            else
            {
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                    <span style="font-size:13px;color:#64748b;">@_records.Count record(s)</span>
                </div>
                <div style="overflow-x:auto;">
                    <table style="width:100%;border-collapse:collapse;font-size:13px;">
                        <thead>
                            <tr style="border-bottom:2px solid #e2e8f0;">
                                <th style="text-align:left;padding:10px 12px;color:#64748b;font-weight:600;white-space:nowrap;">Date</th>
                                <th style="text-align:left;padding:10px 12px;color:#64748b;font-weight:600;white-space:nowrap;">Subject</th>
                                <th style="text-align:left;padding:10px 12px;color:#64748b;font-weight:600;white-space:nowrap;">Teacher</th>
                                <th style="text-align:center;padding:10px 12px;color:#64748b;font-weight:600;white-space:nowrap;">Status</th>
                                @if (_records.Any(r => !string.IsNullOrEmpty(r.Reason)))
                                {
                                    <th style="text-align:left;padding:10px 12px;color:#64748b;font-weight:600;white-space:nowrap;">Reason</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in _records)
                            {
                                var (statusColor, statusBg) = record.Status switch
                                {
                                    "PRESENT" => ("#22c55e", "#f0fdf4"),
                                    "LATE" => ("#eab308", "#fefce8"),
                                    "ABSENT" => ("#ef4444", "#fef2f2"),
                                    _ => ("#64748b", "#f8fafc")
                                };

                                <tr style="border-bottom:1px solid #f1f5f9;">
                                    <td style="padding:10px 12px;color:#1e293b;white-space:nowrap;">@record.Date.ToString("MMM dd, yyyy")</td>
                                    <td style="padding:10px 12px;color:#1e293b;">@record.Subject</td>
                                    <td style="padding:10px 12px;color:#64748b;">@(record.Teacher ?? "—")</td>
                                    <td style="padding:10px 12px;text-align:center;">
                                        <span style="display:inline-block;padding:2px 10px;border-radius:4px;background:@statusBg;color:@statusColor;font-weight:600;font-size:12px;white-space:nowrap;">@record.Status</span>
                                    </td>
                                    @if (_records.Any(r => !string.IsNullOrEmpty(r.Reason)))
                                    {
                                        <td style="padding:10px 12px;color:#64748b;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@record.Reason">@(record.Reason ?? "—")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private List<StudentAttendanceHistoryView> _records = [];
    private string _fullName = "";
    private bool _isLoading = true;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var student = await StudentPortalService.GetStudentByUserIdAsync(session.UserId, _cts.Token);
            if (student is null)
            {
                _error = "Student profile not found.";
                return;
            }

            _fullName = student.FullName;
            _records = await StudentPortalService.GetAttendanceHistoryAsync(student.Id, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
