@page "/student/attendance"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject IStudentPortalService StudentPortalService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageHeader Title="Attendance History" Subtitle="@($"Full attendance record for {_fullName}")">
    <div class="header-actions">
        <a href="/student/dashboard" class="btn-login" style="text-decoration:none;padding:8px 16px;font-size:13px;display:inline-flex;align-items:center;gap:6px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Back to Dashboard
        </a>
    </div>
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading attendance history...</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else
{
    var showReason = _records.Any(r => !string.IsNullOrEmpty(r.Reason));

    <div class="students-table-wrapper">
        <table class="students-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Subject</th>
                    <th>Teacher</th>
                    <th style="text-align:center;">Status</th>
                    @if (showReason)
                    {
                        <th>Reason</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_records.Count == 0)
                {
                    <tr><td colspan="@(showReason ? 5 : 4)" class="empty-state">No attendance records found.</td></tr>
                }
                else
                {
                    @foreach (var record in _records)
                    {
                        <tr>
                            <td style="white-space:nowrap;">@record.Date.ToString("MMM dd, yyyy")</td>
                            <td>@record.Subject</td>
                            <td style="color:var(--clr-text-secondary);">@(record.Teacher ?? "—")</td>
                            <td style="text-align:center;">
                                <span class="att-badge @StatusBadgeClass(record.Status)">@record.Status</span>
                            </td>
                            @if (showReason)
                            {
                                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@record.Reason">@(record.Reason ?? "—")</td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<StudentAttendanceHistoryView> _records = [];
    private string _fullName = "";
    private bool _isLoading = true;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    private static string StatusBadgeClass(string status) => status switch
    {
        "PRESENT" => "att-badge--present",
        "LATE" => "att-badge--late",
        "ABSENT" => "att-badge--absent",
        "EXCUSED" => "att-badge--excused",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var student = await StudentPortalService.GetStudentByUserIdAsync(session.UserId, _cts.Token);
            if (student is null)
            {
                _error = "Student profile not found.";
                return;
            }

            _fullName = student.FullName;
            _records = await StudentPortalService.GetAttendanceHistoryAsync(student.Id, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
