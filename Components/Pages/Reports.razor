@page "/reports"
@page "/admin/export"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using AttendanceUI.Services
@inject IReportService ReportService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageHeader Title="@(_canExport ? "Reports & Export" : "Reports")"
            Subtitle="@(_tab == ReportsTab.Export ? "Export school records to password-protected Excel files" : "Attendance analytics and section breakdowns")">
    <div class="header-actions">
        @if (_tab == ReportsTab.Overview)
        {
            <button class="btn btn-primary" @onclick="OpenPreview" disabled="@(_data is null)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span>Export Excel</span>
            </button>
        }
        else
        {
            <span class="header-date">@DateTime.Now.ToString("MMM dd, yyyy")</span>
        }
    </div>
</PageHeader>

@if (_canExport)
{
    <div class="reports-tabs" role="tablist" aria-label="Reports sections">
        <button type="button" role="tab" id="reports-tab-overview" aria-controls="reports-panel-overview"
                aria-selected="@(_tab == ReportsTab.Overview)"
                class="@(_tab == ReportsTab.Overview ? "tab-btn tab-btn--active" : "tab-btn")"
                @onclick="() => SelectTab(ReportsTab.Overview)">Overview</button>
        <button type="button" role="tab" id="reports-tab-export" aria-controls="reports-panel-export"
                aria-selected="@(_tab == ReportsTab.Export)"
                class="@(_tab == ReportsTab.Export ? "tab-btn tab-btn--active" : "tab-btn")"
                @onclick="() => SelectTab(ReportsTab.Export)">Export Data</button>
    </div>
}

@* The export panel is mounted on first visit and then kept (just hidden), so its
   filters and last result survive switching back and forth between tabs. *@
@if (_canExport && _exportMounted)
{
    <div id="reports-panel-export" role="tabpanel" aria-labelledby="reports-tab-export" hidden="@(_tab != ReportsTab.Export)">
        <ExportPanel />
    </div>
}

<div id="reports-panel-overview" role="@(_canExport ? "tabpanel" : null)" aria-labelledby="@(_canExport ? "reports-tab-overview" : null)" hidden="@(_tab != ReportsTab.Overview)">

@* ── Date Range ── *@
<div class="reports-toolbar">
    <div class="report-date-group">
        <label class="report-date-label" for="rpt-from">From</label>
        <input id="rpt-from" type="date" class="report-date-input" @bind="_fromDate" @bind:after="LoadAsync" />
    </div>
    <div class="report-date-group">
        <label class="report-date-label" for="rpt-to">To</label>
        <input id="rpt-to" type="date" class="report-date-input" @bind="_toDate" @bind:after="LoadAsync" />
    </div>
    <button class="btn btn-ghost" @onclick="ResetDatesAsync">
        <span>Reset</span>
    </button>
</div>

@if (_exportMessage is not null)
{
    <div class="success-banner" style="margin: 0 32px 20px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <span>@_exportMessage</span>
    </div>
}

@if (_loading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <p>Generating report…</p>
    </div>
}
else if (_data is not null)
{
    @* ── Summary Cards ── *@
    <div class="stats-grid" style="margin-bottom:20px;">
        <div class="stat-card">
            <div class="stat-icon stat-icon--purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.Summary.AttendanceRate%</span>
                <span class="stat-label">Attendance Rate</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--green">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.Summary.PresentCount</span>
                <span class="stat-label">Present (@_data.Summary.PresentPercent%)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--yellow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.Summary.LateCount</span>
                <span class="stat-label">Late (@_data.Summary.LatePercent%)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--red">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.Summary.AbsentCount</span>
                <span class="stat-label">Absent (@_data.Summary.AbsentPercent%)</span>
            </div>
        </div>
    </div>

    @* ── Attendance Rate Bar ── *@
    <div class="page-card" style="margin:0 32px 20px;">
        <div class="report-rate-row">
            <span class="report-rate-label">Overall Attendance</span>
            <span class="report-rate-value">@_data.Summary.AttendanceRate%</span>
        </div>
        <div class="report-rate-bar">
            <div class="report-rate-bar-track">
                <div class="report-rate-bar-fill" style="width: @_data.Summary.AttendanceRate%;"></div>
            </div>
            <div class="report-rate-legend">
                <span class="report-rate-legend-item"><span class="report-rate-dot report-rate-dot--green"></span> Present @_data.Summary.PresentPercent%</span>
                <span class="report-rate-legend-item"><span class="report-rate-dot report-rate-dot--yellow"></span> Late @_data.Summary.LatePercent%</span>
                <span class="report-rate-legend-item"><span class="report-rate-dot report-rate-dot--red"></span> Absent @_data.Summary.AbsentPercent%</span>
            </div>
        </div>
        <div class="report-records-count">
            Based on <strong>@_data.Summary.TotalRecords</strong> attendance records across <strong>@_data.Summary.TotalSessions</strong> sessions
        </div>
    </div>

    @* ── Section Breakdown ── *@
    <div class="page-card report-table-section">
        <h2 class="card-heading" style="margin-bottom:12px;">Attendance by Section</h2>
        <div class="table-scroll">
            <table class="students-table">
                <thead>
                    <tr>
                        <th>Section</th>
                        <th style="text-align:center;">Enrolled</th>
                        <th style="text-align:center;">Records</th>
                        <th style="text-align:center;">Present</th>
                        <th style="text-align:center;">Late</th>
                        <th style="text-align:center;">Absent</th>
                        <th style="text-align:center;">Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sec in _data.SectionReports)
                    {
                        <tr>
                            <td><span class="report-section-name">@sec.SectionName</span></td>
                            <td style="text-align:center;">@sec.EnrolledStudents</td>
                            <td style="text-align:center;color:var(--clr-text-secondary);">@sec.TotalRecords</td>
                            <td style="text-align:center;"><span class="att-badge att-badge--present">@sec.PresentCount</span></td>
                            <td style="text-align:center;"><span class="att-badge att-badge--late">@sec.LateCount</span></td>
                            <td style="text-align:center;"><span class="att-badge att-badge--absent">@sec.AbsentCount</span></td>
                            <td style="text-align:center;">
                                <span class="report-rate-indicator @(sec.AttendanceRate >= 90 ? "rate--good" : sec.AttendanceRate >= 75 ? "rate--ok" : "rate--bad")">
                                    @sec.AttendanceRate%
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Daily Trend ── *@
    <div class="page-card report-table-section">
        <h2 class="card-heading" style="margin-bottom:12px;">Daily Trend</h2>
        @if (_data.DailyTrend.Count == 0)
        {
            <p class="text-muted">No daily data available for the selected range.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="students-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th style="text-align:center;">Sessions</th>
                            <th style="text-align:center;">Present</th>
                            <th style="text-align:center;">Late</th>
                            <th style="text-align:center;">Absent</th>
                            <th style="text-align:center;">Present %</th>
                            <th>Trend</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in _data.DailyTrend)
                        {
                            <tr>
                                <td style="font-weight:600;color:var(--clr-text);">@day.Date.ToString("MMM dd, yyyy")</td>
                                <td style="text-align:center;">@day.Sessions</td>
                                <td style="text-align:center;"><span class="att-badge att-badge--present">@day.PresentCount</span></td>
                                <td style="text-align:center;"><span class="att-badge att-badge--late">@day.LateCount</span></td>
                                <td style="text-align:center;"><span class="att-badge att-badge--absent">@day.AbsentCount</span></td>
                                <td style="text-align:center;font-weight:600;">@day.PresentPercent%</td>
                                <td style="width:160px;">
                                    <div class="report-micro-bar">
                                        @{
                                            var total = day.TotalRecords > 0 ? day.TotalRecords : 1;
                                            var pct = (double)day.PresentCount / total * 100;
                                            var lct = (double)day.LateCount / total * 100;
                                            var act = (double)day.AbsentCount / total * 100;
                                        }
                                        <div class="report-micro-track">
                                            <div class="report-micro-fill report-micro-present" style="width:@(pct)%"></div>
                                            <div class="report-micro-fill report-micro-late" style="width:@(lct)%"></div>
                                            <div class="report-micro-fill report-micro-absent" style="width:@(act)%"></div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

</div>

@* ── Export preview modal ── *@
@if (_showPreview && _data is not null)
{
    <Modal Title="Preview — Attendance Report" ContentClass="export-preview-modal" OnClose="ClosePreview">
            <div class="modal-header">
                <h3>Preview — Attendance Report</h3>
                <button class="modal-close" @onclick="ClosePreview" title="Close">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body" style="padding: 12px 24px 0;">
                <p class="export-preview-note">
                    @_sectionRows.Count section@(_sectionRows.Count == 1 ? "" : "s") and @_dailyRows.Count day@(_dailyRows.Count == 1 ? "" : "s") of trend data — the Excel file has a sheet for each table below.
                </p>

                <h4 class="export-preview-subhead">Attendance by Section</h4>
                <div class="export-preview-table-wrap">
                    <table class="export-preview-table">
                        <thead>
                            <tr>
                                @foreach (var header in SectionHeaders)
                                {
                                    <th>@header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_sectionRows.Count == 0)
                            {
                                <tr><td colspan="@SectionHeaders.Length" style="text-align:center;color:var(--clr-text-secondary);">No section data.</td></tr>
                            }
                            @foreach (var row in _sectionRows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td>@cell</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h4 class="export-preview-subhead">Daily Trend</h4>
                <div class="export-preview-table-wrap">
                    <table class="export-preview-table">
                        <thead>
                            <tr>
                                @foreach (var header in DailyHeaders)
                                {
                                    <th>@header</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_dailyRows.Count == 0)
                            {
                                <tr><td colspan="@DailyHeaders.Length" style="text-align:center;color:var(--clr-text-secondary);">No daily data.</td></tr>
                            }
                            @foreach (var row in _dailyRows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td>@cell</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <ExportPasswordFields IdPrefix="report-export"
                                  @bind-Password="_password" @bind-Password:after="ClearPasswordError"
                                  @bind-Confirmation="_passwordConfirm" @bind-Confirmation:after="ClearPasswordError"
                                  Error="@_passwordError" Disabled="@_saving" />
            <div class="export-preview-footer">
                <button class="btn btn-ghost" @onclick="ClosePreview" disabled="@_saving">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmExportAsync" disabled="@(_saving || (_sectionRows.Count == 0 && _dailyRows.Count == 0))">
                    @if (_saving)
                    {
                        <span class="spinner-sm"></span>
                    }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    }
                    <span>Encrypt &amp; save Excel</span>
                </button>
            </div>
    </Modal>
}

@code {
    private ReportData? _data;
    private bool _loading = true;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    // Export preview state. Rows are built once when the preview opens and shared by
    // both the on-screen tables and the generated workbook, so the two can never drift apart.
    private static readonly string[] SectionHeaders = { "Section", "Enrolled", "Records", "Present", "Late", "Absent", "Rate" };
    private static readonly string[] DailyHeaders = { "Date", "Sessions", "Present", "Late", "Absent", "Present%" };
    private List<string[]> _sectionRows = new();
    private List<string[]> _dailyRows = new();
    private bool _showPreview;
    private bool _saving;
    private string? _exportMessage;

    // The workbook is encrypted with this password (AES-256); it is never stored.
    private string _password = string.Empty;
    private string _passwordConfirm = string.Empty;
    private string? _passwordError;

    private void ClearPasswordError() => _passwordError = null;

    private void ResetPassword()
    {
        _password = string.Empty;
        _passwordConfirm = string.Empty;
        _passwordError = null;
    }

    // Overview is open to everyone who can reach this page; the Export tab
    // (formerly /admin/export) is for super admins only.
    private enum ReportsTab { Overview, Export }
    private ReportsTab _tab = ReportsTab.Overview;
    private bool _canExport;
    private bool _exportMounted;

    // "/reports?tab=export" and the legacy "/admin/export" both open the Export tab.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        _canExport = session?.Role == UserRole.SUPERADMIN;
        ApplyRequestedTab();

        await LoadAsync();
    }

    // Runs again when the same page instance is navigated to with a different URL
    // (e.g. /reports -> /admin/export), so the requested tab is honoured.
    protected override void OnParametersSet() => ApplyRequestedTab();

    private void ApplyRequestedTab()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        var wantsExport = string.Equals(TabQuery, "export", StringComparison.OrdinalIgnoreCase)
                          || string.Equals(path, "admin/export", StringComparison.OrdinalIgnoreCase);

        SelectTab(wantsExport ? ReportsTab.Export : ReportsTab.Overview);
    }

    private void SelectTab(ReportsTab tab)
    {
        if (tab == ReportsTab.Export && !_canExport)
            tab = ReportsTab.Overview;

        _tab = tab;
        if (tab == ReportsTab.Export)
            _exportMounted = true;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            DateOnly? from = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : null;
            DateOnly? to = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value) : null;

            var result = await ReportService.GetReportAsync(from, to);

            // Set date inputs to the actual data range if empty
            if (!_fromDate.HasValue)
                _fromDate = result.MinDate.ToDateTime(TimeOnly.MinValue);
            if (!_toDate.HasValue)
                _toDate = result.MaxDate.ToDateTime(TimeOnly.MinValue);

            _data = result;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ResetDatesAsync()
    {
        _fromDate = null;
        _toDate = null;
        await LoadAsync();
    }

    private void OpenPreview()
    {
        if (_data is null) return;

        _sectionRows = _data.SectionReports
            .Select(sec => new[]
            {
                sec.SectionName,
                sec.EnrolledStudents.ToString(),
                sec.TotalRecords.ToString(),
                sec.PresentCount.ToString(),
                sec.LateCount.ToString(),
                sec.AbsentCount.ToString(),
                $"{sec.AttendanceRate}%"
            })
            .ToList();

        _dailyRows = _data.DailyTrend
            .Select(day => new[]
            {
                day.Date.ToString("yyyy-MM-dd"),
                day.Sessions.ToString(),
                day.PresentCount.ToString(),
                day.LateCount.ToString(),
                day.AbsentCount.ToString(),
                $"{day.PresentPercent}%"
            })
            .ToList();

        _exportMessage = null;
        ResetPassword();
        _showPreview = true;
    }

    private void ClosePreview()
    {
        if (_saving) return;
        _showPreview = false;
        ResetPassword();
    }

    private async Task ConfirmExportAsync()
    {
        if (_saving) return;

        _passwordError = ProtectedExport.Validate(_password, _passwordConfirm);
        if (_passwordError is not null) return;

        _saving = true;

        try
        {
            // One workbook, a sheet per table. Counts are stored as numbers; rates keep their "%".
            var workbook = new ExportFile($"attendance-report-{DateTime.Now:yyyyMMdd-HHmmss}.xlsx", XlsxWriter.Write(
            [
                new XlsxSheet("By Section", SectionHeaders, [.. _sectionRows], new HashSet<int> { 1, 2, 3, 4, 5 }),
                new XlsxSheet("Daily Trend", DailyHeaders, [.. _dailyRows], new HashSet<int> { 1, 2, 3, 4 })
            ]));

            var file = ProtectedExport.Protect(workbook, _password);
            var path = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.Desktop), file.FileName);
            await File.WriteAllBytesAsync(path, file.Content);

            _showPreview = false;
            ResetPassword();
            _exportMessage = $"Exported to {path}. {ProtectedExport.OpenHint}";
        }
        catch (Exception ex)
        {
            _passwordError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }
}
