@page "/teacher/dashboard"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject ITeacherService TeacherService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageHeader Title="Teacher Dashboard" Subtitle="@($"Welcome back, {_data?.Teacher.FullName ?? "Teacher"}")">
    <div class="header-actions">
        <span class="header-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    </div>
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading your dashboard...</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else if (_data is not null)
{
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon stat-icon--blue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.TotalClassesToday</span>
                <span class="stat-label">Classes Today</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon--purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.TotalStudents</span>
                <span class="stat-label">Total Students</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon--green">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.PresentToday</span>
                <span class="stat-label">Present Today</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon--yellow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.LateToday</span>
                <span class="stat-label">Late Today</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon--red">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.AbsentToday</span>
                <span class="stat-label">Absent Today</span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon--teal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_data.WeeklySchedule.Count</span>
                <span class="stat-label">Weekly Classes</span>
            </div>
        </div>
    </div>

    <div class="content-grid">
        <div class="page-card">
            <h2 class="card-heading">Today's Schedule</h2>
            <p class="text-muted" style="margin-bottom: 16px; margin-top: 4px;">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>

            @if (_data.TodaySchedule.Count == 0)
            {
                <div style="text-align:center;padding:32px 0;color:rgba(255,255,255,0.4);">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <p>No classes scheduled for today.</p>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var sched in _data.TodaySchedule)
                    {
                        var isOngoing = IsTimeSlotActive(sched.StartTime, sched.EndTime);
                        var statusColor = isOngoing ? "#3b82f6" : "#22c55e";
                        var statusLabel = isOngoing ? "Ongoing" : "Upcoming";
                        var statusBg = isOngoing ? "rgba(59,130,246,0.15)" : "rgba(34,197,94,0.15)";
                        var statusText = isOngoing ? "#60a5fa" : "#4ade80";

                        <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: rgba(255,255,255,0.03); border-radius: 8px; border-left: 3px solid @statusColor;">
                            <span style="font-size: 13px; color: rgba(255,255,255,0.5); min-width: 72px; font-weight: 500;">@sched.StartTime</span>
                            <div style="flex: 1;">
                                <div style="font-size: 14px; font-weight: 600; color: #fff;">@sched.Subject</div>
                                <div style="font-size: 12px; color: rgba(255,255,255,0.4);">@sched.Section @(!string.IsNullOrEmpty(sched.Room) ? $"\u00b7 {sched.Room}" : "")</div>
                            </div>
                            <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: @statusBg; color: @statusText; font-weight: 500; white-space: nowrap;">@statusLabel</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="page-card">
            <h2 class="card-heading">Quick Actions</h2>
            <p class="text-muted" style="margin-bottom: 16px; margin-top: 4px;">Common tasks for today</p>

            <div style="display: flex; flex-direction: column; gap: 12px;">
                <button class="action-btn action-btn--green" style="justify-content:flex-start;flex:none;" @onclick="NavigateToAttendance">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
                    Mark Attendance
                </button>

                <button class="action-btn action-btn--purple" style="justify-content:flex-start;flex:none;" @onclick="NavigateToSchedule">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    View My Schedule
                </button>

                <button class="action-btn" style="justify-content:flex-start;flex:none;" @onclick="NavigateToStudents">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    View My Students
                </button>

                <button class="action-btn action-btn--yellow" style="justify-content:flex-start;flex:none;" @onclick="NavigateToReports">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                    Generate Reports
                </button>
            </div>
        </div>
    </div>

    <div style="padding: 0 32px 32px;">
        <div class="page-card">
            <h2 class="card-heading" style="margin-bottom: 16px;">Weekly Schedule</h2>

            @if (_data.WeeklySchedule.Count == 0)
            {
                <p class="text-muted">No classes scheduled for this week.</p>
            }
            else
            {
                var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
                var grouped = _data.WeeklySchedule
                    .GroupBy(s => s.Day)
                    .ToDictionary(g => g.Key, g => g.ToList());

                <div class="cal-week">
                    @foreach (var day in days)
                    {
                        var dayScheds = grouped.GetValueOrDefault(day, []);
                        <div class="cal-day">
                            <div class="cal-day-header">@day.Substring(0, 3)</div>
                            <div class="cal-day-body">
                                @if (dayScheds.Count == 0)
                                {
                                    <div class="cal-empty">—</div>
                                }
                                else
                                {
                                    @foreach (var sched in dayScheds)
                                    {
                                        <div class="cal-card">
                                            <div class="cal-time">@sched.StartTime</div>
                                            <div class="cal-subject">@sched.Subject</div>
                                            <div class="cal-meta">@sched.Section @(!string.IsNullOrEmpty(sched.Room) ? $"\u00b7 {sched.Room}" : "")</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private TeacherDashboardData? _data;
    private bool _isLoading = true;
    private string? _error;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
            if (teacher is null)
            {
                _error = "Teacher profile not found for your account.";
                return;
            }

            _data = await TeacherService.GetTeacherDashboardAsync(teacher.Id, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static bool IsTimeSlotActive(string startTime, string endTime)
    {
        if (TimeOnly.TryParseExact(startTime, "h:mm tt", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start) &&
            TimeOnly.TryParseExact(endTime, "h:mm tt", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end))
        {
            var now = TimeOnly.FromDateTime(DateTime.Now);
            return now >= start && now <= end;
        }
        return false;
    }

    private void NavigateToAttendance()
    {
        Navigation.NavigateTo("/live-monitoring");
    }

    private void NavigateToSchedule()
    {
        Navigation.NavigateTo("/teacher/schedule");
    }

    private void NavigateToStudents()
    {
        Navigation.NavigateTo("/students");
    }

    private void NavigateToReports()
    {
        Navigation.NavigateTo("/reports");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
