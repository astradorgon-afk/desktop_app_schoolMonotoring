@page "/teacher/dashboard"
@layout DashboardLayout
@using AttendanceUI.Data.Entities
@using System.Globalization
@inject ITeacherService TeacherService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="dash-ambient dash-ambient--1"></div>
<div class="dash-ambient dash-ambient--2"></div>
<div class="dash-ambient dash-ambient--3"></div>

<div class="dash-banner">
    <div class="dash-banner-bg"></div>
    <div class="dash-banner-content">
        <div class="dash-banner-left">
            <div class="dash-banner-brand">
                <svg class="dash-banner-logo" viewBox="0 0 40 40" fill="none" aria-label="Teacher Dashboard Logo">
                    <defs>
                        <linearGradient id="logoGradT" x1="0" y1="0" x2="40" y2="40">
                            <stop stop-color="#6366f1"/>
                            <stop offset="1" stop-color="#8b5cf6"/>
                        </linearGradient>
                    </defs>
                    <path d="M20 1 L37 9 V23 C37 33 20 39 20 39 C20 39 3 33 3 23 V9 L20 1Z" fill="url(#logoGradT)" stroke="rgba(255,255,255,.2)" stroke-width=".8"/>
                    <path d="M11 17 L20 23 L29 17" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M11 23 L20 29 L29 23" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M14 26 L18 30 L27 20" stroke="#4ade80" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <div>
                    <h1 class="dash-banner-title">Teacher Dashboard</h1>
                    <p class="dash-banner-subtitle">Welcome back, @(_data?.Teacher.FullName ?? "Teacher")</p>
                </div>
            </div>
        </div>
        <div class="dash-banner-right">
            <div class="dash-banner-time">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <span>@DateTime.Now.ToString("hh:mm tt")</span>
            </div>
            <div class="dash-banner-row">
                <button class="dash-theme-toggle" @onclick="ToggleTheme" title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")">
                    @if (_isDark)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="loading-state">
        <span class="spinner"></span>
        <p>Loading your dashboard...</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else if (_data is not null)
{
    <div class="dash-metrics">
        <div class="dash-metric dash-metric--blue">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    <span class="dash-metric-abbr">CT</span>
                    CLASSES TODAY
                </div>
                <div class="dash-metric-value">@_data.TotalClassesToday</div>
                <div class="dash-metric-desc">@_data.TotalClassesToday class@(_data.TotalClassesToday != 1 ? "es" : "") scheduled today</div>
            </div>
        </div>
        <div class="dash-metric dash-metric--green">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    <span class="dash-metric-abbr">TS</span>
                    TOTAL STUDENTS
                </div>
                <div class="dash-metric-value">@_data.TotalStudents</div>
                <div class="dash-metric-desc">@_data.TotalStudents registered students</div>
            </div>
        </div>
        <div class="dash-metric dash-metric--purple">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    <span class="dash-metric-abbr">PR</span>
                    PRESENT TODAY
                </div>
                <div class="dash-metric-value">@_data.PresentToday</div>
                <div class="dash-metric-desc">@_data.PresentToday student@(_data.PresentToday != 1 ? "s" : "") present right now</div>
            </div>
        </div>
        <div class="dash-metric dash-metric--orange">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    <span class="dash-metric-abbr">AB</span>
                    ABSENT TODAY
                </div>
                <div class="dash-metric-value">@_data.AbsentToday</div>
                <div class="dash-metric-desc">@_data.AbsentToday student@(_data.AbsentToday != 1 ? "s" : "") absent today</div>
            </div>
        </div>
    </div>

    <div class="dash-workspace">
        <div class="dash-shortcuts-header" style="grid-column: 1 / 5; grid-row: 1;">
            <div>
                <h2 class="dash-section-title">Quick Shortcuts</h2>
                <p class="dash-section-subtitle">Access commonly used tools and sections.</p>
            </div>
            <span class="dash-module-count">8 Modules</span>
        </div>

        <button class="dash-tile dash-tile--green" style="grid-column: 1; grid-row: 2; animation-delay: 0.08s" @onclick='() => NavigateTo("/teacher/my-attendance")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">My Attendance</span>
                <span class="dash-tile-desc">Track your class attendance</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--purple" style="grid-column: 2; grid-row: 2; animation-delay: 0.11s" @onclick='() => NavigateTo("/teacher/schedule")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">View Schedule</span>
                <span class="dash-tile-desc">My weekly class schedule</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--blue" style="grid-column: 3; grid-row: 2; animation-delay: 0.14s" @onclick='() => NavigateTo("/students")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">My Students</span>
                <span class="dash-tile-desc">Browse learner profiles</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--orange" style="grid-column: 4; grid-row: 2; animation-delay: 0.17s" @onclick='() => NavigateTo("/reports")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Reports</span>
                <span class="dash-tile-desc">Attendance audit logs</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--indigo" style="grid-column: 1; grid-row: 3; animation-delay: 0.20s" @onclick='() => NavigateTo("/teacher/handled-sections")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Handled Sections</span>
                <span class="dash-tile-desc">View assigned sections</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--cyan" style="grid-column: 2; grid-row: 3; animation-delay: 0.23s" @onclick='() => NavigateTo("/teacher/start-session")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Start Session</span>
                <span class="dash-tile-desc">Begin attendance session</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--amber" style="grid-column: 3; grid-row: 3; animation-delay: 0.26s" @onclick='() => NavigateTo("/leave-requests")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="14" y1="15" x2="10" y2="19"/><line x1="10" y1="15" x2="14" y2="19"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Leave Request</span>
                <span class="dash-tile-desc">File a time-off request</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <button class="dash-tile dash-tile--dark" style="grid-column: 4; grid-row: 3; animation-delay: 0.29s" @onclick='() => NavigateTo("/teacher/profile")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">My Profile</span>
                <span class="dash-tile-desc">Manage account settings</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <div class="dash-settings" style="grid-column: 5; grid-row: 2 / 4;">
            <button class="dash-setting-card dash-setting-card--clickable" @onclick='() => NavigateTo("/teacher/schedule")'>
                <div class="dash-setting-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="dash-setting-card-body">
                    <div class="dash-setting-card-label">Today's Schedule</div>
                    <div class="dash-setting-card-value">@_data.TodaySchedule.Count class@(_data.TodaySchedule.Count != 1 ? "es" : "")</div>
                </div>
            </button>
            <button class="dash-setting-card dash-setting-card--clickable" @onclick='() => NavigateTo("/teacher/profile")'>
                <div class="dash-setting-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </div>
                <div class="dash-setting-card-body">
                    <div class="dash-setting-card-label">My Profile</div>
                    <div class="dash-setting-card-value">Open</div>
                </div>
            </button>
            <button class="dash-setting-card dash-setting-card--danger dash-setting-card--clickable" @onclick="NavigateToLogout">
                <div class="dash-setting-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <div class="dash-setting-card-body">
                    <div class="dash-setting-card-label">Exit Dashboard</div>
                </div>
            </button>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding: 0 32px 32px;">
        <div class="page-card">
            <h2 class="card-heading">Today's Schedule</h2>
            <p class="text-muted" style="margin-bottom: 16px; margin-top: 4px;">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>

            @if (_data.TodaySchedule.Count == 0)
            {
                <div style="text-align:center;padding:32px 0;color:var(--clr-text-muted);">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;opacity:0.4;">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <p>No classes scheduled for today.</p>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    @foreach (var sched in _data.TodaySchedule)
                    {
                        var isOngoing = IsTimeSlotActive(sched.StartTime, sched.EndTime);
                        var statusColor = isOngoing ? "var(--clr-accent-light)" : "var(--clr-success)";
                        var statusLabel = isOngoing ? "Ongoing" : "Upcoming";
                        var statusBg = isOngoing ? "rgba(99,102,241,0.15)" : "rgba(34,197,94,0.15)";
                        var statusText = isOngoing ? "var(--clr-accent-light)" : "var(--clr-success)";

                        <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: var(--clr-surface-alt); border-radius: 8px; border-left: 3px solid @statusColor;">
                            <span style="font-size: 13px; color: var(--clr-text-muted); min-width: 72px; font-weight: 500;">@sched.StartTime</span>
                            <div style="flex: 1;">
                                <div style="font-size: 14px; font-weight: 600; color: var(--clr-text);">@sched.Subject</div>
                                <div style="font-size: 12px; color: var(--clr-text-muted);">@sched.Section @(!string.IsNullOrEmpty(sched.Room) ? $"\u00b7 {sched.Room}" : "")</div>
                            </div>
                            <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: @statusBg; color: @statusText; font-weight: 500; white-space: nowrap;">@statusLabel</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="page-card">
            <h2 class="card-heading">Weekly Overview</h2>
            <p class="text-muted" style="margin-bottom: 16px; margin-top: 4px;">@_data.WeeklySchedule.Count class@(_data.WeeklySchedule.Count != 1 ? "es" : "") this week</p>

            @if (_data.WeeklySchedule.Count == 0)
            {
                <p class="text-muted">No classes scheduled for this week.</p>
            }
            else
            {
                var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
                var grouped = _data.WeeklySchedule
                    .GroupBy(s => s.Day)
                    .ToDictionary(g => g.Key, g => g.ToList());

                <div class="cal-week">
                    @foreach (var day in days)
                    {
                        var dayScheds = grouped.GetValueOrDefault(day, []);
                        <div class="cal-day">
                            <div class="cal-day-header">@day.Substring(0, 3)</div>
                            <div class="cal-day-body">
                                @if (dayScheds.Count == 0)
                                {
                                    <div class="cal-empty">—</div>
                                }
                                else
                                {
                                    @foreach (var sched in dayScheds)
                                    {
                                        <div class="cal-card">
                                            <div class="cal-time">@sched.StartTime</div>
                                            <div class="cal-subject">@sched.Subject</div>
                                            <div class="cal-meta">@sched.Section @(!string.IsNullOrEmpty(sched.Room) ? $"\u00b7 {sched.Room}" : "")</div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private TeacherDashboardData? _data;
    private bool _isLoading = true;
    private bool _isDark;
    private string? _error;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
        try
        {
            var theme = await JS.InvokeAsync<string>("window.__theme.get");
            _isDark = theme == "dark";
        }
        catch { }
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
            if (teacher is null)
            {
                _error = "Teacher profile not found for your account.";
                return;
            }

            _data = await TeacherService.GetTeacherDashboardAsync(teacher.Id, _cts.Token);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load dashboard: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleTheme()
    {
        var result = await JS.InvokeAsync<string>("window.__theme.toggle");
        _isDark = result == "dark";
    }

    private static bool IsTimeSlotActive(string startTime, string endTime)
    {
        if (TimeOnly.TryParseExact(startTime, "h:mm tt", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start) &&
            TimeOnly.TryParseExact(endTime, "h:mm tt", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end))
        {
            var now = TimeOnly.FromDateTime(DateTime.Now);
            return now >= start && now <= end;
        }
        return false;
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private void NavigateToLogout()
    {
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
