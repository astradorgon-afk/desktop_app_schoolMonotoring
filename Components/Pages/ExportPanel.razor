    private RenderFragment Choice(ExportDataset ds, string idp, string key, string label, string allText,
        IEnumerable<(string Value, string Text)> items, Func<DatasetFilter, string> get, Action<DatasetFilter, string> set,
        bool disabled, string? hint = null)
    {
        var id = $"{idp}-{ds}-{key}";
        var current = get(_filters[ds]);
        return @<div class="export-card-filter">
            <label class="export-card-filter-label" for="@id">@label</label>
            <select id="@id" class="filter-select export-card-filter-select @(current.Length > 0 ? "export-filter--set" : "")"
                    value="@current" disabled="@disabled"
                    @onchange="e => FilterChangedAsync(ds, () => set(_filters[ds], e.Value?.ToString() ?? string.Empty))">
                <option value="">@allText</option>
                @foreach (var item in items)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
            @if (hint is not null)
            {
                <span class="export-card-filter-hint">@hint</span>
            }
        </div>;
    }

    private RenderFragment Search(ExportDataset ds, string idp, string placeholder, bool disabled)
    {
        var id = $"{idp}-{ds}-search";
        var current = _filters[ds].Search;
        return @<div class="export-card-filter">
            <label class="export-card-filter-label" for="@id">Search</label>
            <input id="@id" type="search" class="filter-select export-card-filter-select export-filter-search @(current.Trim().Length > 0 ? "export-filter--set" : "")"
                   placeholder="@placeholder" value="@current" disabled="@disabled" autocomplete="off"
                   @oninput="e => SearchChangedAsync(ds, e.Value?.ToString() ?? string.Empty)" />
        </div>;
    }

    private RenderFragment DateRange(string idp, bool disabled) =>
        @<div class="export-range">
            <input type="date" class="filter-select export-range-input" aria-label="From date" disabled="@disabled"
                   @bind="_from" @bind:after="DateRangeChangedAsync" id="@($"{idp}-from")" />
            <span class="export-range-sep">to</span>
            <input type="date" class="filter-select export-range-input" aria-label="To date" disabled="@disabled"
                   @bind="_to" @bind:after="DateRangeChangedAsync" id="@($"{idp}-to")" />
            <div class="export-segmented">
                <button type="button" class="tab-btn" @onclick="SetRangeThisMonth" disabled="@disabled">This month</button>
                <button type="button" class="tab-btn" @onclick="SetRangeLast30Days" disabled="@disabled">Last 30 days</button>
                <button type="button" class="tab-btn" @onclick="ClearRange" disabled="@(disabled || (_from is null && _to is null))">All dates</button>
            </div>
        </div>;
