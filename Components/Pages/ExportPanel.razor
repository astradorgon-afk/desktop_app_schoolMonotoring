    private RenderFragment Choice(ExportDataset ds, string key, string label, string allText,
        IEnumerable<(string Value, string Text)> items, Func<DatasetFilter, string> get, Action<DatasetFilter, string> set,
        bool disabled = false, string? hint = null)
    {
        var id = $"export-{ds}-{key}";
        var current = get(_filters[ds]);
        return @<div class="export-card-filter">
            <label class="export-card-filter-label" for="@id">@label</label>
            <select id="@id" class="filter-select export-card-filter-select @(current.Length > 0 ? "export-filter--set" : "")"
                    value="@current" disabled="@disabled"
                    @onchange="e => FilterChangedAsync(ds, () => set(_filters[ds], e.Value?.ToString() ?? string.Empty))">
                <option value="">@allText</option>
                @foreach (var item in items)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
            @if (hint is not null)
            {
                <span class="export-card-filter-hint">@hint</span>
            }
        </div>;
    }

    private RenderFragment Search(ExportDataset ds, string placeholder)
    {
        var id = $"export-{ds}-search";
        var current = _filters[ds].Search;
        return @<div class="export-card-filter export-card-filter--search">
            <label class="export-card-filter-label" for="@id">Search</label>
            <input id="@id" type="search" class="filter-select export-card-filter-select export-filter-search @(current.Trim().Length > 0 ? "export-filter--set" : "")"
                   placeholder="@placeholder" value="@current" autocomplete="off"
                   @oninput="e => SearchChangedAsync(ds, e.Value?.ToString() ?? string.Empty)" />
        </div>;
    }

