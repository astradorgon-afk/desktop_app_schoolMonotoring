@* Export tab of the Reports page (formerly the standalone /admin/export page). *@
@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@using AttendanceUI.Services
@inject IExportService ExportService
@inject ISf2ReportService Sf2Service
@inject IAuthService AuthService
@inject IAuditService AuditService

@if (!_authorized)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>You do not have permission to export records.</span>
    </div>
}
else
{
    <div class="export-page">
        <p class="export-intro">
            Choose a record set to export, and narrow it down with the filters on its card or in the preview.
            Files are saved to your <strong>Desktop</strong> as password-protected Excel workbooks (.xlsx) with
            formatted, filterable columns; Excel asks for the password when one is opened.
        </p>

        <div class="export-toolbar">
            <div class="export-toolbar-group">
                <span class="export-card-filter-label">Attendance dates</span>
                @DateRange("page", _busy)
                @if (RangeInvalid)
                {
                    <span class="export-card-filter-hint export-card-filter-hint--error">The start date is after the end date.</span>
                }
                else
                {
                    <span class="export-card-filter-hint">Applies to Teacher Sessions, Student Attendance, Attendance Summary and Export All.</span>
                }
            </div>
        </div>

        @if (_message is not null)
        {
            <div class="success-banner" style="margin: 0 0 20px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>@_message</span>
                @if (_savedPaths.Count > 0)
                {
                    <div class="export-banner-actions">
                        @if (_savedPaths.Count == 1)
                        {
                            <button type="button" class="export-banner-btn" @onclick="OpenSavedFileAsync">Open</button>
                        }
                        @if (OperatingSystem.IsWindows())
                        {
                            <button type="button" class="export-banner-btn" @onclick="ShowSavedInFolder">Show in folder</button>
                        }
                    </div>
                }
            </div>
        }
        @if (_error is not null)
        {
            <div class="error-banner" style="margin: 0 0 20px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span>@_error</span>
            </div>
        }

        <div class="export-grid">
            @foreach (var card in Cards)
            {
                <div class="export-card">
                    <div class="export-card-icon export-card-icon--@card.Color">
                        @card.Icon
                    </div>
                    <div class="export-card-body">
                        <h3 class="export-card-title">@card.Title</h3>
                        <p class="export-card-desc">@card.Description</p>
                        @Filters(card.Dataset, "card", _busy)
                    </div>
                    <button class="btn btn-primary export-card-btn" @onclick="() => OpenPreviewAsync(card.Dataset)"
                            disabled="@(_busy || (IsDated(card.Dataset) && RangeInvalid))">
                        @if (_busyDataset == card.Dataset) { <span class="spinner-sm"></span> }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                        }
                        <span>Preview &amp; Export</span>
                    </button>
                </div>
            }

            @* SF2 monthly report *@
            <div class="export-card">
                <div class="export-card-icon export-card-icon--purple">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="export-card-body">
                    <h3 class="export-card-title">SF2 Monthly Attendance</h3>
                    <p class="export-card-desc">DepEd School Form 2 layout for one section and month: learners by sex, a column per class day, and absent/tardy totals.</p>

                    <div class="export-card-filter">
                        <label class="export-card-filter-label" for="sf2-section">Section</label>
                        <select id="sf2-section" class="filter-select export-card-filter-select" @bind="_sf2SectionId" disabled="@_busy">
                            <option value="0">Choose a section…</option>
                            @foreach (var s in _sectionOptions)
                            {
                                <option value="@s.Id">@SectionLabel(s)</option>
                            }
                        </select>
                    </div>
                    <div class="export-card-filter">
                        <label class="export-card-filter-label" for="sf2-month">Month</label>
                        <input id="sf2-month" type="month" class="filter-select export-card-filter-select" @bind="_sf2Month" @bind:format="yyyy-MM" disabled="@_busy" />
                    </div>
                </div>
                <button class="btn btn-primary export-card-btn" @onclick="OpenSf2Prompt" disabled="@(_busy || _sf2SectionId == 0)">
                    @if (_sf2Busy) { <span class="spinner-sm"></span> }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    }
                    <span>Export SF2</span>
                </button>
            </div>

            @* All *@
            <div class="export-card export-card--all">
                <div class="export-card-icon export-card-icon--purple">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" opacity="0"/><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
                </div>
                <div class="export-card-body">
                    <h3 class="export-card-title">Export All</h3>
                    <p class="export-card-desc">Every dataset (students, teachers, sections, teacher sessions, student attendance and the attendance summary) at once, in one Excel workbook with a sheet each. Each dataset uses its own card's filters, which you can review and change on its tab in the preview.</p>
                    @if (TotalActiveFilters > 0)
                    {
                        <span class="export-card-filter-hint">@TotalActiveFilters filter@(TotalActiveFilters == 1 ? "" : "s") set on the cards above will apply.</span>
                    }
                </div>
                <button class="btn btn-primary export-card-btn" @onclick="OpenPreviewAllAsync" disabled="@(_busy || RangeInvalid)">
                    @if (_busyAll) { <span class="spinner-sm"></span> }
                    else
                    {
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    }
                    <span>Preview &amp; Export All</span>
                </button>
            </div>
        </div>
    </div>

    @* ── Preview modal (one dataset, or every dataset behind tabs) ── *@
    @if (_previews.Count > 0)
    {
        var active = _previews[Math.Clamp(_previewTab, 0, _previews.Count - 1)];
        var totalRows = _previews.Sum(p => p.TotalRows);
        var refreshing = _refreshing.Count > 0;
        var activeRefreshing = _refreshing.Contains(active.Dataset);
        var activeFilters = ActiveFilterCount(active.Dataset);

        <Modal Title="@(_previewIsAll ? "Preview — Export All" : $"Preview — {active.Title}")" ContentClass="export-preview-modal" OnClose="ClosePreview">
                <div class="modal-header">
                    <h3>@(_previewIsAll ? "Preview — Export All" : $"Preview — {active.Title}")</h3>
                    <button class="modal-close" @onclick="ClosePreview" title="Close">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>

                @if (_previews.Count > 1)
                {
                    <div class="export-preview-tabs">
                        @for (var i = 0; i < _previews.Count; i++)
                        {
                            var idx = i;
                            var p = _previews[i];
                            var tabFilters = ActiveFilterCount(p.Dataset);
                            <button type="button"
                                    class="export-preview-tab @(idx == _previewTab ? "export-preview-tab--active" : "")"
                                    @onclick="() => _previewTab = idx"
                                    title="@(tabFilters > 0 ? $"{tabFilters} filter{(tabFilters == 1 ? "" : "s")} applied" : null)">
                                <span>@p.Title.Split(" — ")[0]</span>
                                @if (tabFilters > 0)
                                {
                                    <span class="export-preview-tab-dot" aria-label="filtered"></span>
                                }
                                <span class="export-preview-tab-count">@p.TotalRows</span>
                            </button>
                        }
                    </div>
                }

                @* Filters for the dataset on screen; any change re-runs the preview. *@
                <div class="export-preview-filters">
                    <div class="export-preview-filters-head">
                        <span class="export-preview-filters-title">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                            Filters@(_previewIsAll ? $" — {active.Title.Split(" — ")[0]}" : "")
                        </span>
                        @if (activeRefreshing)
                        {
                            <span class="export-preview-updating"><span class="spinner-sm"></span> Updating…</span>
                        }
                        <button type="button" class="btn btn-ghost btn-sm export-preview-clear"
                                @onclick="() => ClearFiltersAsync(active.Dataset)" disabled="@(_saving || activeFilters == 0)">
                            Clear filters@(activeFilters > 0 ? $" ({activeFilters})" : "")
                        </button>
                    </div>
                    <div class="export-preview-filters-row">
                        @if (IsDated(active.Dataset))
                        {
                            <div class="export-card-filter export-card-filter--range">
                                <span class="export-card-filter-label">Attendance dates</span>
                                @DateRange("modal", _saving)
                            </div>
                        }
                        @Filters(active.Dataset, "modal", _saving)
                    </div>
                    @if (IsDated(active.Dataset) && RangeInvalid)
                    {
                        <span class="export-card-filter-hint export-card-filter-hint--error">The start date is after the end date.</span>
                    }
                    else if (_previewError is not null)
                    {
                        <span class="export-card-filter-hint export-card-filter-hint--error">@_previewError</span>
                    }
                </div>

                <div class="modal-body @(activeRefreshing ? "export-preview-body--stale" : "")" style="padding: 12px 24px 0;">
                    <p class="export-preview-note">
                        @if (active.TotalRows == 0)
                        {
                            <text>No records match these filters.</text>
                        }
                        else if (active.TotalRows > active.Rows.Count)
                        {
                            <text>Showing the first @active.Rows.Count of @active.TotalRows rows — the exported file will include all @active.TotalRows.</text>
                        }
                        else
                        {
                            <text>@active.TotalRows row@(active.TotalRows == 1 ? "" : "s").</text>
                        }
                    </p>
                    <div class="export-preview-table-wrap">
                        <table class="export-preview-table">
                            <thead>
                                <tr>
                                    @foreach (var header in active.Headers)
                                    {
                                        <th>@header</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in active.Rows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td>@cell</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <ExportPasswordFields IdPrefix="export-preview"
                                      @bind-Password="_password" @bind-Password:after="ClearPasswordError"
                                      @bind-Confirmation="_passwordConfirm" @bind-Confirmation:after="ClearPasswordError"
                                      Error="@_passwordError" Disabled="@_saving" />
                <div class="export-preview-footer">
                    <button class="btn btn-ghost" @onclick="ClosePreview" disabled="@_saving">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmExportAsync"
                            disabled="@(_saving || refreshing || totalRows == 0 || (_previews.Any(p => IsDated(p.Dataset)) && RangeInvalid))">
                        @if (_saving)
                        {
                            <span class="spinner-sm"></span>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        }
                        <span>@DownloadLabel</span>
                    </button>
                </div>
        </Modal>
    }

    @* ── SF2 password prompt (SF2 has no preview modal) ── *@
    @if (_sf2Prompt)
    {
        <Modal Title="Export SF2" ContentStyle="max-width:520px;" OnClose="CloseSf2Prompt">
            <div class="modal-header">
                <h3>Export SF2</h3>
                <button class="modal-close" @onclick="CloseSf2Prompt" title="Close" disabled="@_sf2Busy">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <ExportPasswordFields IdPrefix="export-sf2"
                                  @bind-Password="_password" @bind-Password:after="ClearPasswordError"
                                  @bind-Confirmation="_passwordConfirm" @bind-Confirmation:after="ClearPasswordError"
                                  Error="@_passwordError" Disabled="@_sf2Busy" />
            <div class="export-preview-footer">
                <button class="btn btn-ghost" @onclick="CloseSf2Prompt" disabled="@_sf2Busy">Cancel</button>
                <button class="btn btn-primary" @onclick="ExportSf2Async" disabled="@_sf2Busy">
                    @if (_sf2Busy) { <span class="spinner-sm"></span> }
                    <span>Encrypt &amp; save</span>
                </button>
            </div>
        </Modal>
    }
}

@code {
    private bool _authorized = true;
    private UserSession? _session;
    private bool _busy;
    private bool _busyAll;
    private ExportDataset? _busyDataset;
    private string? _message;
    private string? _error;

    // Where the last export was written, for the "Open" / "Show in folder" actions.
    private List<string> _savedPaths = [];

    // The session-date range applied to every attendance dataset (null ends are unbounded).
    // Exports are always Excel: a CSV file cannot carry a password.
    private const ExportFormat Format = ExportFormat.Excel;
    private DateOnly? _from;
    private DateOnly? _to;

    private bool RangeInvalid => _from is { } from && _to is { } to && from > to;

    // ── Filters ──

    /// <summary>
    /// One dataset's filter choices. Every value is the raw option value, "" meaning "all",
    /// so a card and the preview modal can render and edit the same state.
    /// </summary>
    private sealed class DatasetFilter
    {
        public string GradeLevelId { get; set; } = "";
        public string SectionId { get; set; } = "";
        public string SchoolYearId { get; set; } = "";
        public string Archived { get; set; } = "";
        public string TeacherId { get; set; } = "";
        public string StudentId { get; set; } = "";
        public string Sex { get; set; } = "";
        public string RecordStatus { get; set; } = "";
        public string EmploymentStatus { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Status { get; set; } = "";
        public string RateBelow { get; set; } = "";
        public string Search { get; set; } = "";

        public IEnumerable<string> Values =>
        [
            GradeLevelId, SectionId, SchoolYearId, Archived, TeacherId, StudentId, Sex, RecordStatus,
            EmploymentStatus, Subject, Status, RateBelow, Search.Trim()
        ];
    }

    private readonly Dictionary<ExportDataset, DatasetFilter> _filters =
        Enum.GetValues<ExportDataset>().ToDictionary(d => d, _ => new DatasetFilter());

    private ExportFilterChoices _choices = ExportFilterChoices.Empty;
    private List<TeacherOption> _teacherOptions = [];
    private List<SectionOption> _sectionOptions = [];
    // Students for the Student Attendance filter, narrowed by that card's section.
    private List<StudentOption> _studentOptions = [];
    private bool _loadingStudents;

    private static bool IsDated(ExportDataset dataset) =>
        dataset is ExportDataset.TeacherSessions or ExportDataset.StudentAttendance or ExportDataset.AttendanceSummary;

    private int ActiveFilterCount(ExportDataset dataset) =>
        _filters[dataset].Values.Count(v => v.Length > 0);

    private int TotalActiveFilters => _filters.Values.Sum(f => f.Values.Count(v => v.Length > 0));

    private static long? Id(string value) => long.TryParse(value, out var id) && id != 0 ? id : null;
    private static string? Text(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>The service options for a dataset: its own filters plus the page date range.</summary>
    private ExportOptions OptionsFor(ExportDataset dataset)
    {
        var f = _filters[dataset];
        var dated = IsDated(dataset);

        return new ExportOptions(
            TeacherId: Id(f.TeacherId),
            SectionId: Id(f.SectionId),
            StudentId: Id(f.StudentId),
            From: dated ? _from : null,
            To: dated ? _to : null,
            Status: Text(f.Status))
        {
            GradeLevelId = Id(f.GradeLevelId),
            SchoolYearId = Id(f.SchoolYearId),
            Archived = f.Archived switch { "archived" => true, "active" => false, _ => null },
            Sex = Text(f.Sex),
            RecordStatus = Text(f.RecordStatus),
            EmploymentStatus = Text(f.EmploymentStatus),
            Subject = Text(f.Subject),
            Search = Text(f.Search),
            RateBelow = double.TryParse(f.RateBelow, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var rate) ? rate : null
        };
    }

    private Dictionary<ExportDataset, ExportOptions> AllOptions() =>
        ExportService.AllDatasets.ToDictionary(d => d, OptionsFor);

    // ── Preview modal state ──

    // One entry for a single dataset, or every dataset for "Export All" (shown as tabs).
    private List<ExportPreview> _previews = [];
    private int _previewTab;
    private bool _previewIsAll;
    private bool _saving;
    private string? _previewError;

    // Datasets whose preview is being rebuilt after a filter change, and a counter per
    // dataset so a slow, outdated rebuild never overwrites a newer one.
    private readonly HashSet<ExportDataset> _refreshing = [];
    private readonly Dictionary<ExportDataset, int> _refreshVersion = [];

    // Every export is saved as an AES-256 ZIP protected by this password. It is asked for
    // each time and cleared once the export is done or cancelled; it is never stored.
    private string _password = string.Empty;
    private string _passwordConfirm = string.Empty;
    private string? _passwordError;

    private void ClearPasswordError() => _passwordError = null;

    private void ResetPassword()
    {
        _password = string.Empty;
        _passwordConfirm = string.Empty;
        _passwordError = null;
    }

    // Checks the password before anything is generated; false leaves the dialog open with the reason shown.
    private bool PasswordAccepted()
    {
        _passwordError = ProtectedExport.Validate(_password, _passwordConfirm);
        return _passwordError is null;
    }

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        _authorized = session is not null && session.Role == UserRole.SUPERADMIN;
        _session = session;

        if (!_authorized) return;

        try
        {
            _choices = await ExportService.GetFilterChoicesAsync();
            _teacherOptions = [.. await ExportService.GetTeacherOptionsAsync()];
            _sectionOptions = [.. await ExportService.GetSectionOptionsAsync()];
            _studentOptions = [.. await ExportService.GetStudentOptionsAsync()];
        }
        catch (Exception ex)
        {
            _error = $"Could not load the export filters: {ex.Message}";
        }
    }

    private string DownloadLabel => _previewIsAll
        ? $"Encrypt & save workbook ({_previews.Count} sheets)"
        : "Encrypt & save Excel";

    // ── Date range ──

    private async Task SetRangeAsync(DateOnly? from, DateOnly? to)
    {
        _from = from;
        _to = to;
        await DateRangeChangedAsync();
    }

    private Task SetRangeThisMonth()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return SetRangeAsync(new DateOnly(today.Year, today.Month, 1), today);
    }

    private Task SetRangeLast30Days()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return SetRangeAsync(today.AddDays(-29), today);
    }

    private Task ClearRange() => SetRangeAsync(null, null);

    // The range is shared, so every dated dataset in the open preview is rebuilt.
    private async Task DateRangeChangedAsync()
    {
        if (RangeInvalid) return;
        await Task.WhenAll(_previews.Where(p => IsDated(p.Dataset)).Select(p => RefreshPreviewAsync(p.Dataset)).ToList());
    }

    // ── Filter changes ──

    private async Task FilterChangedAsync(ExportDataset dataset, Action change)
    {
        var f = _filters[dataset];
        var sectionBefore = f.SectionId;
        change();

        // The Student Attendance student list follows its section, and a student from another
        // section would make the export empty.
        if (dataset == ExportDataset.StudentAttendance && f.SectionId != sectionBefore)
        {
            f.StudentId = "";
            await LoadStudentOptionsAsync(Id(f.SectionId));
        }

        await RefreshPreviewAsync(dataset);
    }

    // Typing in a search box waits for a pause before rebuilding the preview.
    private async Task SearchChangedAsync(ExportDataset dataset, string value)
    {
        _filters[dataset].Search = value;
        if (!_previews.Any(p => p.Dataset == dataset)) return;

        var version = NextVersion(dataset);
        await Task.Delay(350);
        if (_refreshVersion[dataset] == version)
            await RefreshPreviewAsync(dataset);
    }

    private async Task ClearFiltersAsync(ExportDataset dataset)
    {
        _filters[dataset] = new DatasetFilter();
        if (dataset == ExportDataset.StudentAttendance)
            await LoadStudentOptionsAsync(null);
        await RefreshPreviewAsync(dataset);
    }

    private async Task LoadStudentOptionsAsync(long? sectionId)
    {
        _loadingStudents = true;
        try
        {
            _studentOptions = [.. await ExportService.GetStudentOptionsAsync(sectionId)];
        }
        catch (Exception ex)
        {
            _error = $"Could not load the student list: {ex.Message}";
            _studentOptions = [];
        }
        finally
        {
            _loadingStudents = false;
        }
    }

    private int NextVersion(ExportDataset dataset)
    {
        var version = _refreshVersion.GetValueOrDefault(dataset) + 1;
        _refreshVersion[dataset] = version;
        return version;
    }

    /// <summary>Rebuilds a dataset's preview from its current filters, if it is in the open modal.</summary>
    private async Task RefreshPreviewAsync(ExportDataset dataset)
    {
        if (!_previews.Any(p => p.Dataset == dataset)) return;
        if (IsDated(dataset) && RangeInvalid) return;

        var version = NextVersion(dataset);
        _refreshing.Add(dataset);
        _previewError = null;
        StateHasChanged();

        try
        {
            var preview = await ExportService.PreviewAsync(dataset, OptionsFor(dataset));
            if (_refreshVersion[dataset] != version) return;

            var index = _previews.FindIndex(p => p.Dataset == dataset);
            if (index >= 0)
                _previews[index] = preview;
        }
        catch (Exception ex)
        {
            if (_refreshVersion[dataset] == version)
                _previewError = $"Could not update the preview: {ex.Message}";
        }
        finally
        {
            if (_refreshVersion[dataset] == version)
                _refreshing.Remove(dataset);
        }
    }

    // ── Opening, closing and saving the preview ──

    private async Task OpenPreviewAsync(ExportDataset dataset)
    {
        if (_busy) return;
        if (IsDated(dataset) && RangeInvalid) return;

        _busy = true;
        _busyDataset = dataset;
        _message = null;
        _error = null;
        _previewError = null;
        _savedPaths = [];

        try
        {
            _previews = [await ExportService.PreviewAsync(dataset, OptionsFor(dataset))];
            _previewTab = 0;
            _previewIsAll = false;
        }
        catch (Exception ex)
        {
            _error = $"Preview failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyDataset = null;
        }
    }

    private async Task OpenPreviewAllAsync()
    {
        if (_busy || RangeInvalid) return;

        _busy = true;
        _busyAll = true;
        _message = null;
        _error = null;
        _previewError = null;
        _savedPaths = [];

        try
        {
            _previews = [.. await ExportService.PreviewAllAsync(AllOptions())];
            _previewTab = 0;
            _previewIsAll = true;
        }
        catch (Exception ex)
        {
            _error = $"Preview failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _busyAll = false;
        }
    }

    private void ClosePreview()
    {
        if (_saving) return;
        _previews = [];
        _previewTab = 0;
        _previewIsAll = false;
        _previewError = null;
        _refreshing.Clear();
        ResetPassword();
    }

    private async Task ConfirmExportAsync()
    {
        if (_saving || _previews.Count == 0 || _refreshing.Count > 0) return;
        if (!PasswordAccepted()) return;

        _saving = true;
        _error = null;

        try
        {
            var totalRows = _previews.Sum(p => p.TotalRows);

            // The file is built from the same filters the preview was last built from.
            if (_previewIsAll)
            {
                // One workbook with a sheet per dataset.
                var files = await ExportService.ExportAllAsync(AllOptions(), format: Format);
                var workbook = ProtectedExport.Protect(files.Single(), _password);
                var path = await SaveToDesktopAsync(workbook);

                _savedPaths = [path];
                _message = $"Exported {_previews.Count} sheets to {path}. {ProtectedExport.OpenHint}";

                await AuditExportAsync(
                    $"Exported all datasets ({totalRows} rows) as a password-protected workbook ({workbook.FileName}): " +
                    string.Join("; ", _previews.Select(p => $"{p.Title} ({p.TotalRows})")) + ".");
            }
            else
            {
                var preview = _previews[0];
                var file = await ExportService.ExportAsync(preview.Dataset, OptionsFor(preview.Dataset), format: Format);
                var workbook = ProtectedExport.Protect(file, _password);
                var path = await SaveToDesktopAsync(workbook);
                _savedPaths = [path];
                _message = $"Exported to {path}. {ProtectedExport.OpenHint}";

                await AuditExportAsync($"Exported {preview.Title} ({totalRows} rows) as a password-protected workbook: {workbook.FileName}.");
            }

            _previews = [];
            _previewTab = 0;
            _previewIsAll = false;
            ResetPassword();
        }
        catch (Exception ex)
        {
            _error = $"Export failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── SF2 ──

    private long _sf2SectionId;
    private DateTime _sf2Month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private bool _sf2Busy;
    private bool _sf2Prompt;

    private void OpenSf2Prompt()
    {
        if (_sf2SectionId == 0 || _busy) return;
        ResetPassword();
        _sf2Prompt = true;
    }

    private void CloseSf2Prompt()
    {
        if (_sf2Busy) return;
        _sf2Prompt = false;
        ResetPassword();
    }

    private async Task ExportSf2Async()
    {
        if (_sf2SectionId == 0 || _busy) return;
        if (!PasswordAccepted()) return;

        _busy = _sf2Busy = true;
        _error = null;
        _message = null;
        _savedPaths = [];
        try
        {
            var file = await Sf2Service.BuildAsync(_sf2SectionId, _sf2Month.Year, _sf2Month.Month);
            var workbook = ProtectedExport.Protect(file, _password);
            var path = await SaveToDesktopAsync(workbook);
            _savedPaths = [path];
            _message = $"Exported to {path}. {ProtectedExport.OpenHint}";

            await AuditExportAsync($"Exported SF2 for {_sf2Month:MMMM yyyy} as a password-protected workbook: {workbook.FileName}.");
        }
        catch (Exception ex)
        {
            _error = $"SF2 export failed: {ex.Message}";
        }
        finally
        {
            // Close the prompt either way so the result (or error) on the page is visible.
            _busy = _sf2Busy = false;
            _sf2Prompt = false;
            ResetPassword();
        }
    }

    // Exports carry students' personal data, so each one is recorded in the audit log.
    // A failed audit write must not report a finished export as failed.
    private async Task AuditExportAsync(string summary)
    {
        if (_session is null) return;

        try
        {
            await AuditService.LogAsync(_session.UserId, _session.DisplayName, _session.Role.ToString(),
                "DataExport", "Export", null, summary);
        }
        catch
        {
        }
    }

    private async Task OpenSavedFileAsync()
    {
        if (_savedPaths.Count != 1) return;

        var path = _savedPaths[0];
        try
        {
            await Launcher.Default.OpenAsync(new OpenFileRequest(Path.GetFileName(path), new ReadOnlyFile(path)));
        }
        catch (Exception ex)
        {
            _error = $"Could not open the file: {ex.Message}";
        }
    }

    private void ShowSavedInFolder()
    {
        if (_savedPaths.Count == 0 || !OperatingSystem.IsWindows()) return;

        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", $"/select,\"{_savedPaths[0]}\"")
            {
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            _error = $"Could not open the folder: {ex.Message}";
        }
    }

    private static async Task<string> SaveToDesktopAsync(ExportFile file)
    {
        var folder = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
        var path = Path.Combine(folder, file.FileName);
        await File.WriteAllBytesAsync(path, file.Content);
        return path;
    }

