@* Export tab of the Reports page (formerly the standalone /admin/export page).
   One workspace: pick a record set on the left, narrow it with the filters on the right while
   the preview underneath updates, then export. The password is asked for in a short last step. *@
@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@using AttendanceUI.Services
@implements IDisposable
@inject IExportService ExportService
@inject ISf2ReportService Sf2Service
@inject IAuthService AuthService
@inject IAuditService AuditService

@if (!_authorized)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>You do not have permission to export records.</span>
    </div>
}
else
{
    <div class="export-page">
        @if (_savedPath is not null)
        {
            <div class="success-banner export-result" role="status">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span class="export-result-text" title="@_savedPath">
                    Saved <strong>@Path.GetFileName(_savedPath)</strong> to your Desktop. @ProtectedExport.OpenHint
                </span>
                <div class="export-banner-actions">
                    <button type="button" class="export-banner-btn" @onclick="OpenSavedFileAsync">Open</button>
                    @if (OperatingSystem.IsWindows())
                    {
                        <button type="button" class="export-banner-btn" @onclick="ShowSavedInFolder">Show in folder</button>
                    }
                    <button type="button" class="export-banner-close" @onclick="() => _savedPath = null" title="Dismiss" aria-label="Dismiss">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>
        }
        @if (_error is not null)
        {
            <div class="error-banner export-result" role="alert">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span class="export-result-text">@_error</span>
                <div class="export-banner-actions">
                    <button type="button" class="export-banner-close" @onclick="() => _error = null" title="Dismiss" aria-label="Dismiss">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </button>
                </div>
            </div>
        }

        <div class="export-layout">
            @* ── What to export ── *@
            <nav class="export-nav" aria-label="What to export">
                <span class="export-nav-label">Record sets</span>
                @foreach (var card in Cards)
                {
                    var ds = card.Dataset;
                    var selected = _pane == Pane.Dataset && _dataset == ds;
                    var count = FilterCount(ds);
                    <button type="button" class="export-nav-item @(selected ? "export-nav-item--active" : "")"
                            aria-current="@(selected ? "true" : null)" @onclick="() => SelectDatasetAsync(ds)">
                        <span class="export-card-icon export-card-icon--sm export-card-icon--@card.Color">@card.Icon</span>
                        <span class="export-nav-text">
                            <span class="export-nav-title">@card.Title</span>
                            <span class="export-nav-meta">@NavMeta(ds)</span>
                        </span>
                        @if (count > 0)
                        {
                            <span class="export-nav-badge" title="@FilterCountText(count) applied">
                                @FunnelIcon(11)
                                @count
                            </span>
                        }
                    </button>
                }

                <span class="export-nav-label export-nav-label--gap">Special exports</span>
                <button type="button" class="export-nav-item @(_pane == Pane.Sf2 ? "export-nav-item--active" : "")"
                        aria-current="@(_pane == Pane.Sf2 ? "true" : null)" @onclick="SelectSf2">
                    <span class="export-card-icon export-card-icon--sm export-card-icon--purple">@CalendarIcon</span>
                    <span class="export-nav-text">
                        <span class="export-nav-title">SF2 Monthly Attendance</span>
                        <span class="export-nav-meta">DepEd form, one section and month</span>
                    </span>
                </button>
                <button type="button" class="export-nav-item @(_pane == Pane.All ? "export-nav-item--active" : "")"
                        aria-current="@(_pane == Pane.All ? "true" : null)" @onclick="SelectAllAsync">
                    <span class="export-card-icon export-card-icon--sm export-card-icon--purple">@WorkbookIcon</span>
                    <span class="export-nav-text">
                        <span class="export-nav-title">Everything</span>
                        <span class="export-nav-meta">One workbook, @Cards.Length sheets</span>
                    </span>
                </button>
            </nav>

            @* ── The selected export ── *@
            <section class="export-work" aria-live="polite">
                @if (_pane == Pane.Dataset)
                {
                    var card = Cards.First(c => c.Dataset == _dataset);
                    var preview = _previewCache.GetValueOrDefault(_dataset);
                    var refreshing = _refreshing.Contains(_dataset);
                    var filterCount = FilterCount(_dataset);
                    var dated = IsDated(_dataset);
                    var previewError = _previewErrors.GetValueOrDefault(_dataset);

                    <header class="export-work-head">
                        <span class="export-card-icon export-card-icon--@card.Color">@card.Icon</span>
                        <div class="export-work-heading">
                            <h3 class="export-work-title">@card.Title</h3>
                            <p class="export-work-desc">@card.Description</p>
                        </div>
                        <button type="button" class="btn btn-primary export-work-action" @onclick="OpenPromptAsync"
                                disabled="@(preview is null || preview.TotalRows == 0 || (dated && RangeInvalid))">
                            @DownloadIcon
                            <span>@(preview is { TotalRows: > 0 } ? $"Export {RowsText(preview.TotalRows)}" : "Export")</span>
                        </button>
                    </header>

                    <div class="export-work-filters @(_filtersOpen ? "" : "export-work-filters--collapsed")">
                        <div class="export-work-filters-head">
                            <button type="button" class="export-work-filters-title export-work-filters-toggle"
                                    aria-expanded="@(_filtersOpen ? "true" : "false")" aria-controls="export-filter-fields"
                                    title="@(_filtersOpen ? "Hide the filters" : "Show the filters")"
                                    @onclick="() => _filtersOpen = !_filtersOpen">
                                <svg class="export-work-filters-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                                @FunnelIcon(14)
                                Filters
                            </button>
                            <span class="export-work-filters-note">
                                @(filterCount == 0 ? "None set, so every record is included." : $"{FilterCountText(filterCount)} applied.")
                            </span>
                            <button type="button" class="btn btn-ghost export-work-clear"
                                    @onclick="() => ClearFiltersAsync(_dataset)" disabled="@(filterCount == 0)">
                                Clear filters
                            </button>
                        </div>
                        <div class="export-preview-filters-row" id="export-filter-fields" hidden="@(!_filtersOpen)">
                            @if (dated)
                            {
                                <div class="export-card-filter export-card-filter--range">
                                    <span class="export-card-filter-label">Attendance dates</span>
                                    @DateRange()
                                    @if (RangeInvalid)
                                    {
                                        <span class="export-card-filter-hint export-card-filter-hint--error" role="alert">The start date is after the end date.</span>
                                    }
                                    else
                                    {
                                        <span class="export-card-filter-hint">Shared by Teacher Sessions, Student Attendance and Attendance Summary.</span>
                                    }
                                </div>
                            }
                            @Filters(_dataset)
                        </div>
                    </div>

                    <div class="export-work-body">
                        @if (preview is null)
                        {
                            @if (previewError is not null)
                            {
                                <div class="export-empty">
                                    <p class="export-empty-title">The preview could not be loaded</p>
                                    <p class="export-empty-text">@previewError</p>
                                    <button type="button" class="btn btn-ghost" @onclick="() => RefreshPreviewAsync(_dataset)">Try again</button>
                                </div>
                            }
                            else
                            {
                                <div class="export-empty">
                                    <span class="spinner-sm"></span>
                                    <p class="export-empty-text">Loading the preview…</p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="export-work-preview-head">
                                <p class="export-preview-note">
                                    @if (previewError is not null)
                                    {
                                        <span class="export-card-filter-hint--error">@previewError</span>
                                    }
                                    else if (preview.TotalRows == 0)
                                    {
                                        <text>Preview</text>
                                    }
                                    else if (preview.TotalRows > preview.Rows.Count)
                                    {
                                        <text>Preview of the first @preview.Rows.Count rows. The file will have all <strong>@preview.TotalRows.ToString("N0")</strong>, in @preview.Headers.Count columns.</text>
                                    }
                                    else
                                    {
                                        <text>Preview of all <strong>@RowsText(preview.TotalRows)</strong>, in @preview.Headers.Count columns.</text>
                                    }
                                </p>
                                @if (refreshing)
                                {
                                    <span class="export-preview-updating"><span class="spinner-sm"></span> Updating…</span>
                                }
                                else
                                {
                                    <button type="button" class="export-work-refresh" @onclick="() => RefreshPreviewAsync(_dataset)" title="Reload from the database">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                                        Refresh
                                    </button>
                                }
                            </div>

                            @if (preview.TotalRows == 0)
                            {
                                <div class="export-empty @(refreshing ? "export-preview-body--stale" : "")">
                                    <p class="export-empty-title">No records match</p>
                                    <p class="export-empty-text">
                                        @(filterCount > 0 ? "Nothing fits the current filters, so there is nothing to export." : "This record set has no data yet.")
                                    </p>
                                    @if (filterCount > 0)
                                    {
                                        <button type="button" class="btn btn-ghost" @onclick="() => ClearFiltersAsync(_dataset)">Clear filters</button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="@(refreshing ? "export-preview-body--stale" : "")">
                                    <div class="export-preview-table-wrap export-work-table">
                                        <table class="export-preview-table">
                                            <thead>
                                                <tr>
                                                    @foreach (var header in preview.Headers)
                                                    {
                                                        <th>@header</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in preview.Rows)
                                                {
                                                    <tr>
                                                        @foreach (var cell in row)
                                                        {
                                                            <td>@cell</td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
                else if (_pane == Pane.Sf2)
                {
                    <header class="export-work-head">
                        <span class="export-card-icon export-card-icon--purple">@CalendarIcon</span>
                        <div class="export-work-heading">
                            <h3 class="export-work-title">SF2 Monthly Attendance</h3>
                            <p class="export-work-desc">DepEd School Form 2 layout for one section and month: learners by sex, a column per class day, and absent/tardy totals.</p>
                        </div>
                        <button type="button" class="btn btn-primary export-work-action" @onclick="OpenPromptAsync" disabled="@(_sf2SectionId == 0)">
                            @DownloadIcon
                            <span>Export SF2</span>
                        </button>
                    </header>

                    <div class="export-work-body">
                        <div class="export-sf2-fields">
                            <div class="export-card-filter">
                                <label class="export-card-filter-label" for="sf2-section">Section</label>
                                <select id="sf2-section" class="filter-select export-card-filter-select @(_sf2SectionId != 0 ? "export-filter--set" : "")" @bind="_sf2SectionId">
                                    <option value="0">Choose a section…</option>
                                    @foreach (var s in _sectionOptions)
                                    {
                                        <option value="@s.Id">@SectionLabel(s)</option>
                                    }
                                </select>
                            </div>
                            <div class="export-card-filter">
                                <label class="export-card-filter-label" for="sf2-month">Month</label>
                                <input id="sf2-month" type="month" class="filter-select export-card-filter-select" @bind="_sf2Month" @bind:format="yyyy-MM" />
                            </div>
                        </div>
                        <p class="export-preview-note export-sf2-note">
                            @if (_sf2SectionId == 0)
                            {
                                <text>Choose a section to enable the export.</text>
                            }
                            else
                            {
                                <text>Ready: <strong>@Sf2SectionName</strong>, @_sf2Month.ToString("MMMM yyyy"). This form is built straight into the file, so it has no preview.</text>
                            }
                        </p>
                    </div>
                }
                else
                {
                    var loaded = AllPreviews;
                    var allLoaded = loaded.Count == Cards.Length;
                    var totalRows = loaded.Sum(p => p.TotalRows);

                    <header class="export-work-head">
                        <span class="export-card-icon export-card-icon--purple">@WorkbookIcon</span>
                        <div class="export-work-heading">
                            <h3 class="export-work-title">Everything</h3>
                            <p class="export-work-desc">One Excel workbook with a sheet for each record set. Every sheet uses the filters set on its own record set.</p>
                        </div>
                        <button type="button" class="btn btn-primary export-work-action" @onclick="OpenPromptAsync"
                                disabled="@(!allLoaded || totalRows == 0 || RangeInvalid)">
                            @DownloadIcon
                            <span>@(allLoaded && totalRows > 0 ? $"Export {Cards.Length} sheets" : "Export")</span>
                        </button>
                    </header>

                    <div class="export-work-filters">
                        <div class="export-preview-filters-row">
                            <div class="export-card-filter export-card-filter--range">
                                <span class="export-card-filter-label">Attendance dates</span>
                                @DateRange()
                                @if (RangeInvalid)
                                {
                                    <span class="export-card-filter-hint export-card-filter-hint--error" role="alert">The start date is after the end date.</span>
                                }
                                else
                                {
                                    <span class="export-card-filter-hint">Applies to the Teacher Sessions, Student Attendance and Attendance Summary sheets.</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="export-work-body">
                        <div class="export-work-preview-head">
                            <p class="export-preview-note">
                                @if (allLoaded)
                                {
                                    <text><strong>@RowsText(totalRows)</strong> across @Cards.Length sheets.</text>
                                }
                                else
                                {
                                    <text>Counting rows…</text>
                                }
                            </p>
                            @if (_refreshing.Count > 0)
                            {
                                <span class="export-preview-updating"><span class="spinner-sm"></span> Updating…</span>
                            }
                        </div>
                        <ul class="export-sheets">
                            @foreach (var card in Cards)
                            {
                                var ds = card.Dataset;
                                var p = _previewCache.GetValueOrDefault(ds);
                                var count = FilterCount(ds);
                                <li class="export-sheet">
                                    <span class="export-card-icon export-card-icon--sm export-card-icon--@card.Color">@card.Icon</span>
                                    <span class="export-sheet-name">@card.Title</span>
                                    <span class="export-sheet-filters">
                                        @if (count > 0)
                                        {
                                            <span class="export-nav-badge">@FunnelIcon(11) @FilterCountText(count)</span>
                                        }
                                        else
                                        {
                                            <text>All records</text>
                                        }
                                    </span>
                                    <span class="export-sheet-rows">
                                        @if (p is not null)
                                        {
                                            @RowsText(p.TotalRows)
                                        }
                                        else if (_previewErrors.ContainsKey(ds))
                                        {
                                            <span class="export-card-filter-hint--error">Couldn't load</span>
                                        }
                                        else
                                        {
                                            <span class="spinner-sm"></span>
                                        }
                                    </span>
                                    <button type="button" class="btn btn-ghost export-sheet-edit" @onclick="() => SelectDatasetAsync(ds)">
                                        View &amp; filter
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </section>
        </div>
    </div>

    @* ── Last step: what will be saved, and the password that protects it ── *@
    @if (_prompt)
    {
        <Modal Title="@PromptTitle" ContentClass="export-prompt-modal" OnClose="ClosePrompt">
            <div class="modal-header">
                <h3>@PromptTitle</h3>
                <button class="modal-close" @onclick="ClosePrompt" title="Close" disabled="@_saving">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <dl class="export-prompt-summary">
                @foreach (var (label, value) in PromptSummary())
                {
                    <div class="export-prompt-summary-row">
                        <dt>@label</dt>
                        <dd>@value</dd>
                    </div>
                }
                <div class="export-prompt-summary-row">
                    <dt>Saved to</dt>
                    <dd>Your Desktop, as an encrypted Excel workbook (.xlsx)</dd>
                </div>
            </dl>

            <ExportPasswordFields IdPrefix="export-prompt"
                                  @bind-Password="_password" @bind-Password:after="ClearPasswordError"
                                  @bind-Confirmation="_passwordConfirm" @bind-Confirmation:after="ClearPasswordError"
                                  Error="@_passwordError" Disabled="@_saving" OnSubmit="ConfirmExportAsync" />
            <div class="export-preview-footer">
                <button class="btn btn-ghost" @onclick="ClosePrompt" disabled="@_saving">Cancel</button>
                <button class="btn btn-primary" @onclick="ConfirmExportAsync" disabled="@(_saving || PromptRefreshing)">
                    @if (_saving || PromptRefreshing)
                    {
                        <span class="spinner-sm"></span>
                    }
                    else
                    {
                        @DownloadIcon
                    }
                    <span>@(_saving ? "Saving…" : "Encrypt & save")</span>
                </button>
            </div>
        </Modal>
    }
}

@code {
    private bool _authorized = true;
    private bool _disposed;
    private UserSession? _session;
    private string? _error;

    // Where the last export was written, for the "Open" / "Show in folder" actions.
    private string? _savedPath;

    // What the right-hand side is showing: one record set, the SF2 form, or the all-in-one workbook.
    private enum Pane { Dataset, Sf2, All }
    private Pane _pane = Pane.Dataset;
    private ExportDataset _dataset = ExportDataset.Students;

    // The session-date range applied to every attendance dataset (null ends are unbounded).
    // Exports are always Excel: a CSV file cannot carry a password.
    private const ExportFormat Format = ExportFormat.Excel;
    private DateOnly? _from;
    private DateOnly? _to;

    // Whether the filter fields are showing; collapsing them gives the preview the room.
    // Kept while switching record sets. The "n filters applied" note stays visible either way.
    private bool _filtersOpen = true;

    private bool RangeInvalid => _from is { } from && _to is { } to && from > to;
    private bool RangeSet => _from is not null || _to is not null;

    // ── Filters ──

    /// <summary>
    /// One dataset's filter choices. Every value is the raw option value, "" meaning "all".
    /// </summary>
    private sealed class DatasetFilter
    {
        public string GradeLevelId { get; set; } = "";
        public string SectionId { get; set; } = "";
        public string SchoolYearId { get; set; } = "";
        public string Archived { get; set; } = "";
        public string TeacherId { get; set; } = "";
        public string StudentId { get; set; } = "";
        public string Sex { get; set; } = "";
        public string RecordStatus { get; set; } = "";
        public string EmploymentStatus { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Status { get; set; } = "";
        public string RateBelow { get; set; } = "";
        public string Search { get; set; } = "";

        public IEnumerable<string> Values =>
        [
            GradeLevelId, SectionId, SchoolYearId, Archived, TeacherId, StudentId, Sex, RecordStatus,
            EmploymentStatus, Subject, Status, RateBelow, Search.Trim()
        ];
    }

    private readonly Dictionary<ExportDataset, DatasetFilter> _filters =
        Enum.GetValues<ExportDataset>().ToDictionary(d => d, _ => new DatasetFilter());

    private ExportFilterChoices _choices = ExportFilterChoices.Empty;
    private List<TeacherOption> _teacherOptions = [];
    private List<SectionOption> _sectionOptions = [];
    // Students for the Student Attendance filter, narrowed by that dataset's section.
    private List<StudentOption> _studentOptions = [];
    private bool _loadingStudents;

    private static bool IsDated(ExportDataset dataset) =>
        dataset is ExportDataset.TeacherSessions or ExportDataset.StudentAttendance or ExportDataset.AttendanceSummary;

    /// <summary>Everything narrowing a dataset: its own filters, plus the shared date range where it applies.</summary>
    private int FilterCount(ExportDataset dataset) =>
        _filters[dataset].Values.Count(v => v.Length > 0) + (IsDated(dataset) && RangeSet ? 1 : 0);

    private static string FilterCountText(int count) => count == 1 ? "1 filter" : $"{count} filters";
    private static string RowsText(int rows) => rows == 1 ? "1 row" : $"{rows:N0} rows";

    private static long? Id(string value) => long.TryParse(value, out var id) && id != 0 ? id : null;
    private static string? Text(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    /// <summary>The service options for a dataset: its own filters plus the shared date range.</summary>
    private ExportOptions OptionsFor(ExportDataset dataset)
    {
        var f = _filters[dataset];
        var dated = IsDated(dataset);

        return new ExportOptions(
            TeacherId: Id(f.TeacherId),
            SectionId: Id(f.SectionId),
            StudentId: Id(f.StudentId),
            From: dated ? _from : null,
            To: dated ? _to : null,
            Status: Text(f.Status))
        {
            GradeLevelId = Id(f.GradeLevelId),
            SchoolYearId = Id(f.SchoolYearId),
            Archived = f.Archived switch { "archived" => true, "active" => false, _ => null },
            Sex = Text(f.Sex),
            RecordStatus = Text(f.RecordStatus),
            EmploymentStatus = Text(f.EmploymentStatus),
            Subject = Text(f.Subject),
            Search = Text(f.Search),
            RateBelow = double.TryParse(f.RateBelow, System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out var rate) ? rate : null
        };
    }

    private Dictionary<ExportDataset, ExportOptions> AllOptions() =>
        ExportService.AllDatasets.ToDictionary(d => d, OptionsFor);

    // ── Previews ──

    // The latest preview of each dataset under its current filters. It feeds the row counts in
    // the list, the table on the right and the export summary; the file itself is always
    // generated from the database again.
    private readonly Dictionary<ExportDataset, ExportPreview> _previewCache = [];
    private readonly Dictionary<ExportDataset, string> _previewErrors = [];

    // Datasets whose preview is being rebuilt, and a counter per dataset so a slow, outdated
    // rebuild never overwrites a newer one.
    private readonly HashSet<ExportDataset> _refreshing = [];
    private readonly Dictionary<ExportDataset, int> _refreshVersion = [];

    /// <summary>The loaded previews, in the order the workbook lists its sheets.</summary>
    private List<ExportPreview> AllPreviews =>
        [.. ExportService.AllDatasets.Where(_previewCache.ContainsKey).Select(d => _previewCache[d])];

    private string NavMeta(ExportDataset dataset) =>
        _previewCache.TryGetValue(dataset, out var preview) ? RowsText(preview.TotalRows)
        : _previewErrors.ContainsKey(dataset) ? "Couldn't load"
        : "Loading…";

    // ── Password step ──

    // Every export is encrypted with this password. It is asked for each time and cleared once
    // the export is done or cancelled; it is never stored.
    private bool _prompt;
    private bool _saving;
    private string _password = string.Empty;
    private string _passwordConfirm = string.Empty;
    private string? _passwordError;

    private void ClearPasswordError() => _passwordError = null;

    private void ResetPassword()
    {
        _password = string.Empty;
        _passwordConfirm = string.Empty;
        _passwordError = null;
    }

    // Checks the password before anything is generated; false leaves the dialog open with the reason shown.
    private bool PasswordAccepted()
    {
        _passwordError = ProtectedExport.Validate(_password, _passwordConfirm);
        return _passwordError is null;
    }

    private string PromptTitle => _pane switch
    {
        Pane.Sf2 => "Export SF2",
        Pane.All => "Export everything",
        _ => $"Export {Cards.First(c => c.Dataset == _dataset).Title}"
    };

    // The counts in the summary are re-read when the dialog opens; saving waits for them.
    private bool PromptRefreshing => _pane switch
    {
        Pane.Dataset => _refreshing.Contains(_dataset),
        Pane.All => _refreshing.Count > 0,
        _ => false
    };

    private string RangeText => (_from, _to) switch
    {
        (null, null) => "All dates",
        ({ } from, null) => $"From {from:MMM d, yyyy}",
        (null, { } to) => $"Up to {to:MMM d, yyyy}",
        ({ } from, { } to) => $"{from:MMM d, yyyy} to {to:MMM d, yyyy}"
    };

    private string Sf2SectionName =>
        _sectionOptions.FirstOrDefault(s => s.Id == _sf2SectionId) is { } section ? SectionLabel(section) : "";

    private IEnumerable<(string Label, string Value)> PromptSummary()
    {
        switch (_pane)
        {
            case Pane.Sf2:
                yield return ("Section", Sf2SectionName);
                yield return ("Month", _sf2Month.ToString("MMMM yyyy"));
                break;

            case Pane.All:
                var all = AllPreviews;
                var filtered = Cards.Count(c => _filters[c.Dataset].Values.Any(v => v.Length > 0));
                yield return ("Contents", $"{all.Count} sheets, {RowsText(all.Sum(p => p.TotalRows))}");
                yield return ("Filters", filtered == 0 ? "None" : $"Set on {filtered} of {Cards.Length} sheets");
                yield return ("Attendance dates", RangeText);
                break;

            default:
                var own = _filters[_dataset].Values.Count(v => v.Length > 0);
                yield return ("Contents", _previewCache.TryGetValue(_dataset, out var preview) ? RowsText(preview.TotalRows) : "…");
                yield return ("Filters", own == 0 ? "None" : $"{FilterCountText(own)} applied");
                if (IsDated(_dataset))
                    yield return ("Attendance dates", RangeText);
                break;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        _authorized = session is not null && session.Role == UserRole.SUPERADMIN;
        _session = session;

        if (!_authorized) return;

        try
        {
            _choices = await ExportService.GetFilterChoicesAsync();
            _teacherOptions = [.. await ExportService.GetTeacherOptionsAsync()];
            _sectionOptions = [.. await ExportService.GetSectionOptionsAsync()];
            _studentOptions = [.. await ExportService.GetStudentOptionsAsync()];
        }
        catch (Exception ex)
        {
            _error = $"Could not load the export filters: {ex.Message}";
        }

        // Not awaited: the page shows at once and the row counts fill in as each set is read.
        _ = RefreshAllAsync();
    }

    public void Dispose() => _disposed = true;

    // ── Choosing what to export ──

    private async Task SelectDatasetAsync(ExportDataset dataset)
    {
        _pane = Pane.Dataset;
        _dataset = dataset;

        // Normally loaded already; this covers a set whose first load failed or has not finished.
        if (!_previewCache.ContainsKey(dataset) && !_refreshing.Contains(dataset))
            await RefreshPreviewAsync(dataset);
    }

    private void SelectSf2() => _pane = Pane.Sf2;

    private async Task SelectAllAsync()
    {
        _pane = Pane.All;

        foreach (var dataset in ExportService.AllDatasets)
        {
            if (!_previewCache.ContainsKey(dataset) && !_refreshing.Contains(dataset))
                await RefreshPreviewAsync(dataset);
        }
    }

    // ── Date range ──

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private bool IsThisMonth => _from == new DateOnly(Today.Year, Today.Month, 1) && _to == Today;
    private bool IsLast30Days => _from == Today.AddDays(-29) && _to == Today;

    private async Task SetRangeAsync(DateOnly? from, DateOnly? to)
    {
        _from = from;
        _to = to;
        await DateRangeChangedAsync();
    }

    private Task SetRangeThisMonth() => SetRangeAsync(new DateOnly(Today.Year, Today.Month, 1), Today);

    private Task SetRangeLast30Days() => SetRangeAsync(Today.AddDays(-29), Today);

    private Task ClearRange() => SetRangeAsync(null, null);

    // The range is shared, so every dated dataset is rebuilt.
    private async Task DateRangeChangedAsync()
    {
        if (RangeInvalid) return;
        await Task.WhenAll(ExportService.AllDatasets.Where(IsDated).Select(RefreshPreviewAsync).ToList());
    }

    // ── Filter changes ──

    private async Task FilterChangedAsync(ExportDataset dataset, Action change)
    {
        var f = _filters[dataset];
        var sectionBefore = f.SectionId;
        change();

        // The Student Attendance student list follows its section, and a student from another
        // section would make the export empty.
        if (dataset == ExportDataset.StudentAttendance && f.SectionId != sectionBefore)
        {
            f.StudentId = "";
            await LoadStudentOptionsAsync(Id(f.SectionId));
        }

        await RefreshPreviewAsync(dataset);
    }

    // Typing in a search box waits for a pause before rebuilding the preview.
    private async Task SearchChangedAsync(ExportDataset dataset, string value)
    {
        _filters[dataset].Search = value;

        var version = NextVersion(dataset);
        await Task.Delay(350);
        if (_refreshVersion[dataset] == version)
            await RefreshPreviewAsync(dataset);
    }

    /// <summary>Back to every record: the dataset's own filters and, where it applies, the shared date range.</summary>
    private async Task ClearFiltersAsync(ExportDataset dataset)
    {
        _filters[dataset] = new DatasetFilter();
        if (dataset == ExportDataset.StudentAttendance)
            await LoadStudentOptionsAsync(null);

        if (IsDated(dataset) && RangeSet)
            await ClearRange();
        else
            await RefreshPreviewAsync(dataset);
    }

    private async Task LoadStudentOptionsAsync(long? sectionId)
    {
        _loadingStudents = true;
        try
        {
            _studentOptions = [.. await ExportService.GetStudentOptionsAsync(sectionId)];
        }
        catch (Exception ex)
        {
            _error = $"Could not load the student list: {ex.Message}";
            _studentOptions = [];
        }
        finally
        {
            _loadingStudents = false;
        }
    }

    private int NextVersion(ExportDataset dataset)
    {
        var version = _refreshVersion.GetValueOrDefault(dataset) + 1;
        _refreshVersion[dataset] = version;
        return version;
    }

    /// <summary>Rebuilds a dataset's preview from its current filters.</summary>
    private async Task RefreshPreviewAsync(ExportDataset dataset)
    {
        if (IsDated(dataset) && RangeInvalid) return;

        var version = NextVersion(dataset);
        _refreshing.Add(dataset);
        _previewErrors.Remove(dataset);
        StateHasChanged();

        try
        {
            var preview = await ExportService.PreviewAsync(dataset, OptionsFor(dataset));
            if (_refreshVersion[dataset] == version)
                _previewCache[dataset] = preview;
        }
        catch (Exception ex)
        {
            if (_refreshVersion[dataset] == version)
                _previewErrors[dataset] = $"Could not update the preview: {ex.Message}";
        }
        finally
        {
            if (_refreshVersion[dataset] == version)
                _refreshing.Remove(dataset);

            // Also reached from the unawaited first load, which nothing else re-renders.
            if (!_disposed)
                StateHasChanged();
        }
    }

    // One at a time, so a first visit does not open a database connection per dataset.
    private async Task RefreshAllAsync()
    {
        foreach (var dataset in ExportService.AllDatasets)
            await RefreshPreviewAsync(dataset);
    }

    // ── Saving ──

    private async Task OpenPromptAsync()
    {
        if (_prompt) return;

        ResetPassword();
        _error = null;
        _prompt = true;

        // Re-read what is about to be exported while the password is typed, so the summary
        // and the audit entry carry current counts.
        if (_pane == Pane.Dataset)
            await RefreshPreviewAsync(_dataset);
        else if (_pane == Pane.All)
            await RefreshAllAsync();
    }

    private void ClosePrompt()
    {
        if (_saving) return;
        _prompt = false;
        ResetPassword();
    }

    private async Task ConfirmExportAsync()
    {
        if (_saving || !_prompt || PromptRefreshing) return;
        if (!PasswordAccepted()) return;

        _saving = true;

        try
        {
            ExportFile file;
            Func<string, string> audit;

            // The file is built from the same filters the preview was last built from.
            switch (_pane)
            {
                case Pane.Sf2:
                    if (_sf2SectionId == 0) return;
                    file = await Sf2Service.BuildAsync(_sf2SectionId, _sf2Month.Year, _sf2Month.Month);
                    audit = name => $"Exported SF2 for {_sf2Month:MMMM yyyy} as a password-protected workbook: {name}.";
                    break;

                case Pane.All:
                    // One workbook with a sheet per dataset.
                    var previews = AllPreviews;
                    file = (await ExportService.ExportAllAsync(AllOptions(), format: Format)).Single();
                    audit = name =>
                        $"Exported all datasets ({previews.Sum(p => p.TotalRows)} rows) as a password-protected workbook ({name}): " +
                        string.Join("; ", previews.Select(p => $"{p.Title} ({p.TotalRows})")) + ".";
                    break;

                default:
                    var preview = _previewCache[_dataset];
                    file = await ExportService.ExportAsync(_dataset, OptionsFor(_dataset), format: Format);
                    audit = name => $"Exported {preview.Title} ({preview.TotalRows} rows) as a password-protected workbook: {name}.";
                    break;
            }

            var workbook = ProtectedExport.Protect(file, _password);
            _savedPath = await SaveToDesktopAsync(workbook);
            await AuditExportAsync(audit(workbook.FileName));

            _prompt = false;
            ResetPassword();
        }
        catch (Exception ex)
        {
            // Shown in the dialog, which stays open so the export can be retried.
            _passwordError = $"Export failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    // ── SF2 ──

    private long _sf2SectionId;
    private DateTime _sf2Month = new(DateTime.Today.Year, DateTime.Today.Month, 1);

    // Exports carry students' personal data, so each one is recorded in the audit log.
    // A failed audit write must not report a finished export as failed.
    private async Task AuditExportAsync(string summary)
    {
        if (_session is null) return;

        try
        {
            await AuditService.LogAsync(_session.UserId, _session.DisplayName, _session.Role.ToString(),
                "DataExport", "Export", null, summary);
        }
        catch
        {
        }
    }

    private async Task OpenSavedFileAsync()
    {
        if (_savedPath is not { } path) return;

        try
        {
            await Launcher.Default.OpenAsync(new OpenFileRequest(Path.GetFileName(path), new ReadOnlyFile(path)));
        }
        catch (Exception ex)
        {
            _error = $"Could not open the file: {ex.Message}";
        }
    }

    private void ShowSavedInFolder()
    {
        if (_savedPath is not { } path || !OperatingSystem.IsWindows()) return;

        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("explorer.exe", $"/select,\"{path}\"")
            {
                UseShellExecute = true
            });
        }
        catch (Exception ex)
        {
            _error = $"Could not open the folder: {ex.Message}";
        }
    }

    private static async Task<string> SaveToDesktopAsync(ExportFile file)
    {
        var folder = Environment.GetFolderPath(Environment.SpecialFolder.Desktop);
        var path = Path.Combine(folder, file.FileName);
        await File.WriteAllBytesAsync(path, file.Content);
        return path;
    }

