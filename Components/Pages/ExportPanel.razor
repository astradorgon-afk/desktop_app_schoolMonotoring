    private static string SectionLabel(SectionOption s) =>
        string.IsNullOrWhiteSpace(s.GradeLevel) ? s.Name : $"{s.GradeLevel} — {s.Name}";

    /// <summary>"FULL_TIME" → "Full Time", for stored codes shown in a dropdown.</summary>
    private static string Pretty(string value) =>
        System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(value.Trim().ToLowerInvariant().Replace('_', ' '));

    private static readonly (string Value, string Text)[] AttendanceStatuses =
        [("PRESENT", "Present only"), ("LATE", "Late only"), ("ABSENT", "Absent only"), ("EXCUSED", "Excused only")];

    private static readonly (string Value, string Text)[] ArchivedChoices =
        [("active", "Active only"), ("archived", "Archived only")];

    private static readonly (string Value, string Text)[] RateChoices =
        [("75", "Below 75%"), ("80", "Below 80%"), ("90", "Below 90%")];

    private IEnumerable<(string, string)> GradeItems => _choices.GradeLevels.Select(g => (g.Id.ToString(), g.Name));
    private IEnumerable<(string, string)> SectionItems => _sectionOptions.Select(s => (s.Id.ToString(), SectionLabel(s)));
    private IEnumerable<(string, string)> YearItems => _choices.SchoolYears.Select(y => (y.Id.ToString(), y.Name));
    private IEnumerable<(string, string)> SubjectItems => _choices.Subjects.Select(s => (s, s));
    private IEnumerable<(string, string)> TeacherItems => _teacherOptions.Select(t =>
        (t.Id.ToString(), string.IsNullOrWhiteSpace(t.EmployeeNo) ? t.Name : $"{t.Name} · {t.EmployeeNo}"));
    private IEnumerable<(string, string)> StudentItems => _studentOptions.Select(s =>
        (s.Id.ToString(), string.IsNullOrWhiteSpace(s.Lrn) ? s.Name : $"{s.Name} · {s.Lrn}"));
    private static IEnumerable<(string, string)> PrettyItems(IEnumerable<string> values) => values.Select(v => (v, Pretty(v)));

    /// <summary>The filters for one dataset. Rendered on its card and in the preview modal; both edit the same state.</summary>
    private RenderFragment Filters(ExportDataset ds, string idp, bool disabled) => ds switch
    {
        ExportDataset.Students =>
            @<div class="export-filters">
                @Choice(ds, idp, "grade", "Grade level", "All grade levels", GradeItems, f => f.GradeLevelId, (f, v) => f.GradeLevelId = v, disabled)
                @Choice(ds, idp, "section", "Section", "All sections", SectionItems, f => f.SectionId, (f, v) => f.SectionId = v, disabled)
                @Choice(ds, idp, "sex", "Sex", "Any", PrettyItems(_choices.Sexes), f => f.Sex, (f, v) => f.Sex = v, disabled)
                @Choice(ds, idp, "status", "Status", "All statuses", PrettyItems(_choices.StudentStatuses), f => f.RecordStatus, (f, v) => f.RecordStatus = v, disabled)
                @Search(ds, idp, "Name, LRN or student no.", disabled)
            </div>,
        ExportDataset.Teachers =>
            @<div class="export-filters">
                @Choice(ds, idp, "status", "Status", "All statuses", PrettyItems(_choices.TeacherStatuses), f => f.RecordStatus, (f, v) => f.RecordStatus = v, disabled)
                @Choice(ds, idp, "employment", "Employment", "All types", PrettyItems(_choices.EmploymentStatuses), f => f.EmploymentStatus, (f, v) => f.EmploymentStatus = v, disabled)
                @Search(ds, idp, "Name, employee no. or e-mail", disabled)
            </div>,
        ExportDataset.Sections =>
            @<div class="export-filters">
                @Choice(ds, idp, "grade", "Grade level", "All grade levels", GradeItems, f => f.GradeLevelId, (f, v) => f.GradeLevelId = v, disabled)
                @Choice(ds, idp, "year", "School year", "All school years", YearItems, f => f.SchoolYearId, (f, v) => f.SchoolYearId = v, disabled)
                @Choice(ds, idp, "archived", "Archived", "Active and archived", ArchivedChoices, f => f.Archived, (f, v) => f.Archived = v, disabled)
            </div>,
        ExportDataset.TeacherSessions =>
            @<div class="export-filters">
                @Choice(ds, idp, "teacher", "Teacher", "All teachers", TeacherItems, f => f.TeacherId, (f, v) => f.TeacherId = v, disabled,
                    _teacherOptions.Count == 0 ? "No teachers are assigned to a class yet." : null)
                @Choice(ds, idp, "section", "Section", "All sections", SectionItems, f => f.SectionId, (f, v) => f.SectionId = v, disabled)
                @Choice(ds, idp, "subject", "Subject", "All subjects", SubjectItems, f => f.Subject, (f, v) => f.Subject = v, disabled)
                @Choice(ds, idp, "attendance", "Attendance", "All statuses", AttendanceStatuses, f => f.Status, (f, v) => f.Status = v, disabled)
            </div>,
        ExportDataset.StudentAttendance =>
            @<div class="export-filters">
                @Choice(ds, idp, "section", "Section", "All sections", SectionItems, f => f.SectionId, (f, v) => f.SectionId = v, disabled)
                @Choice(ds, idp, "student", "Student", _filters[ds].SectionId == "" ? "All students" : "All students in this section",
                    StudentItems, f => f.StudentId, (f, v) => f.StudentId = v, disabled || _loadingStudents,
                    _loadingStudents ? "Loading students…" : _studentOptions.Count == 0 ? "No students with attendance records here yet." : null)
                @Choice(ds, idp, "subject", "Subject", "All subjects", SubjectItems, f => f.Subject, (f, v) => f.Subject = v, disabled)
                @Choice(ds, idp, "attendance", "Attendance", "All statuses", AttendanceStatuses, f => f.Status, (f, v) => f.Status = v, disabled)
