            <div class="export-segmented">
                <button type="button" class="tab-btn @(IsThisMonth ? "tab-btn--active" : "")" aria-pressed="@(IsThisMonth ? "true" : "false")" @onclick="SetRangeThisMonth">This month</button>
                <button type="button" class="tab-btn @(IsLast30Days ? "tab-btn--active" : "")" aria-pressed="@(IsLast30Days ? "true" : "false")" @onclick="SetRangeLast30Days">Last 30 days</button>
                <button type="button" class="tab-btn @(!RangeSet ? "tab-btn--active" : "")" aria-pressed="@(!RangeSet ? "true" : "false")" @onclick="ClearRange">All dates</button>
            </div>
        </div>;
}
