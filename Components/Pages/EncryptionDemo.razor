@page "/admin/encryption"
@layout MainLayout
@using AttendanceUI.Data
@using AttendanceUI.Data.Entities
@inject IEncryptionDemoService DemoService
@inject IDataEncryptionService EncryptionService
@inject IRecordSealService SealService
@inject IAuthService AuthService
@implements IDisposable

<PageHeader Title="Encryption Demo" Subtitle="Encryption and hashing: what the database stores versus what the app shows" />

@if (!_authorized)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>Only the super administrator can view the encryption demo.</span>
    </div>
}
else
{
    @* ── 1. Status ── *@
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon stat-icon--purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value enc-stat-small">AES-256-GCM</span>
                <span class="stat-label">Algorithm (authenticated)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--indigo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value enc-stat-small enc-mono" title="First 8 bytes of SHA-256(key). The key itself is never shown.">@_fingerprint</span>
                <span class="stat-label">Key fingerprint · @_keySource</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--green">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@(_status?.EncryptedValues.ToString("N0") ?? "–")</span>
                <span class="stat-label">Values encrypted</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--yellow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@(_status?.PlainValues.ToString("N0") ?? "–")</span>
                <span class="stat-label">Still plain text</span>
            </div>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="error-banner enc-banner">@_error</div>
    }
    @if (_result is not null)
    {
        <div class="success-banner enc-banner">@_result</div>
    }

    @if (_status is { PlainValues: > 0 })
    {
        <div class="page-card enc-card">
            <h2 class="card-heading">Encrypt the existing records</h2>
            <p class="text-muted enc-help">
                @_status.PlainValues.ToString("N0") value@(_status.PlainValues == 1 ? " was" : "s were") saved before encryption was turned on and
                @(_status.PlainValues == 1 ? "is" : "are") still readable by anyone who opens the database. New and edited records are already encrypted.
            </p>
            @if (!_confirming)
            {
                <button class="btn btn-primary" @onclick="() => _confirming = true" disabled="@_encrypting">Encrypt existing records…</button>
            }
            else
            {
                <div class="enc-confirm" role="alert">
                    <p>
                        This rewrites @_status.PlainValues.ToString("N0") value@(_status.PlainValues == 1 ? "" : "s") in the database.
                        <strong>Back up the encryption key first</strong>: data encrypted with a lost key cannot be recovered.
                    </p>
                    <div class="enc-actions">
                        <button class="btn btn-primary" @onclick="EncryptExistingAsync" disabled="@_encrypting">
                            @if (_encrypting) { <span class="spinner-sm"></span> }
                            Yes, encrypt now
                        </button>
                        <button class="btn btn-ghost" @onclick="() => _confirming = false" disabled="@_encrypting">Cancel</button>
                    </div>
                </div>
            }
        </div>
    }

    @* ── 2. Database vs. app ── *@
    <div class="page-card enc-card">
        <div class="enc-card-head">
            <div>
                <h2 class="card-heading">Database vs. app</h2>
                <p class="text-muted enc-help">
                    The left column is read straight from the database, the way anyone with database access would see it.
                    The right column is the same value after the app decrypts it with its key.
                </p>
            </div>
            <button class="btn btn-ghost" @onclick="LoadAllAsync" disabled="@_loadingRows">
                @if (_loadingRows) { <span class="spinner-sm"></span> }
                Refresh
            </button>
        </div>

        <div class="enc-tabs" role="tablist" aria-label="Table">
            @foreach (var t in _tables)
            {
                var table = t;
                <button type="button" role="tab" aria-selected="@(table.Table == _table)"
                        class="@(table.Table == _table ? "tab-btn tab-btn--active" : "tab-btn")"
                        @onclick="() => SelectTableAsync(table.Table)">@table.DisplayName</button>
            }
        </div>

        @if (_loadingRows && _rows.Count == 0)
        {
            <div class="loading-state"><span class="spinner"></span><p>Reading the database…</p></div>
        }
        else if (_rows.Count == 0)
        {
            <p class="text-muted">No records with encrypted fields in this table yet.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="students-table enc-table">
                    <thead>
                        <tr>
                            <th>Record</th>
                            <th>Field</th>
                            <th>Stored in database</th>
                            <th>Shown in app</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _rows)
                        {
                            @for (var i = 0; i < row.Cells.Count; i++)
                            {
                                var cell = row.Cells[i];
                                <tr class="@(i == 0 ? "enc-row-first" : "")">
                                    @if (i == 0)
                                    {
                                        <td rowspan="@row.Cells.Count" class="enc-record">@row.Label</td>
                                    }
                                    <td class="enc-field">@cell.Column</td>
                                    <td>
                                        @if (cell.StoredValue != "NULL")
                                        {
                                            <span class="att-badge att-badge--sm @(cell.IsEncrypted ? "att-badge--present" : "att-badge--late")">@(cell.IsEncrypted ? "Encrypted" : "Plain text")</span>
                                        }
                                        <code class="enc-raw @(cell.IsEncrypted ? "enc-raw--cipher" : "")" title="@cell.StoredValue">@Shorten(cell.StoredValue)</code>
                                    </td>
                                    <td class="enc-plain @(cell.AppValue == DataEncryption.Unreadable ? "enc-plain--bad" : "")">@Shorten(cell.AppValue)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted enc-footnote">Showing the newest @_rows.Count record@(_rows.Count == 1 ? "" : "s"). Hover a stored value to see all of it.</p>
        }
    </div>

    @* ── 3. Try it ── *@
    <div class="page-card enc-card">
        <h2 class="card-heading">Try it yourself</h2>
        <p class="text-muted enc-help">
            Runs in memory with the app's real key. Nothing is written to the database.
        </p>

        <div class="enc-try-input">
            <label class="form-label" for="enc-input">Text to encrypt</label>
            <div class="enc-actions">
                <input id="enc-input" class="form-input" @bind="_input" @bind:event="oninput" placeholder="e.g. 09171234567" maxlength="500" />
                <button class="btn btn-primary" @onclick="EncryptSample" disabled="@string.IsNullOrEmpty(_input)">Encrypt</button>
            </div>
        </div>

        @if (_cipher is not null)
        {
            <div class="enc-steps">
                <div class="enc-step">
                    <span class="enc-step-num">1</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Encrypted value (this is what gets saved)</span>
                        <code class="enc-raw enc-raw--cipher enc-raw--full">@_cipher</code>
                        <span class="text-muted enc-step-note">
                            Format: <code>enc:v1:</code> + base64( 12-byte random nonce | ciphertext | 16-byte authentication tag )
                        </span>
                    </div>
                </div>

                <div class="enc-step">
                    <span class="enc-step-num">2</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Same text, encrypted again</span>
                        <code class="enc-raw enc-raw--cipher enc-raw--full">@_cipher2</code>
                        <span class="text-muted enc-step-note">
                            Different every time because of the random nonce, so identical values (e.g. two students on the same street)
                            can't be spotted in the database.
                        </span>
                    </div>
                </div>

                <div class="enc-step">
                    <span class="enc-step-num">3</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Decrypt it with the app's key</span>
                        <span class="text-muted enc-step-note">
                            The value from step 1 is filled in. You can also paste any <code>enc:v1:</code> value from the table above.
                        </span>
                        <div class="enc-try-input enc-decrypt-input">
                            <div class="enc-actions">
                                <input class="form-input enc-mono" aria-label="Encrypted value to decrypt" @bind="_decryptInput" @bind:event="oninput" placeholder="enc:v1:…" />
                                <button class="btn btn-primary" @onclick="DecryptSample" disabled="@string.IsNullOrWhiteSpace(_decryptInput)">Decrypt</button>
                            </div>
                        </div>
                        @if (_decryptNote is not null)
                        {
                            <span class="enc-plain enc-plain--bad">@_decryptNote</span>
                        }
                        else if (_decrypted is not null)
                        {
                            <span>Decrypts to: <span class="enc-plain enc-plain--ok">@_decrypted</span></span>
                        }
                    </div>
                </div>

                <div class="enc-step">
                    <span class="enc-step-num">4</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Tamper test</span>
                        @if (_tampered is null)
                        {
                            <span class="text-muted enc-step-note">@(_tamperNote ?? "Change a single bit of the stored value, the way an attacker editing the database might.")</span>
                            <div><button class="btn btn-ghost" @onclick="TamperSample">Flip one bit</button></div>
                        }
                        else
                        {
                            <code class="enc-raw enc-raw--cipher enc-raw--full">@_tampered</code>
                            <span class="text-muted enc-step-note">@_tamperNote</span>
                            <span>Decrypts to: <span class="enc-plain enc-plain--bad">@DataEncryption.DecryptText(_tampered)</span></span>
                            <span class="text-muted enc-step-note">
                                The authentication tag no longer matches, so the app refuses the value instead of showing altered data.
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── 4. Password hashing ── *@
    <div class="page-card enc-card">
        <h2 class="card-heading">Password hashing (PBKDF2-SHA256)</h2>
        <p class="text-muted enc-help">
            Passwords are not encrypted, they are hashed. Encryption can be undone with the key; a hash cannot be undone by anyone,
            including the app. At sign-in the typed password is hashed the same way and the two hashes are compared.
            @if (_hashes is not null)
            {
                <span>@_hashes.Hashed.ToString("N0") of @_hashes.Accounts.ToString("N0") account password@(_hashes.Accounts == 1 ? " is" : "s are") stored this way.</span>
            }
        </p>

        @if (_hashes is { Samples.Count: > 0 })
        {
            <div class="table-scroll">
                <table class="students-table enc-table">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Algorithm</th>
                            <th>Iterations</th>
                            <th>Salt</th>
                            <th>Hash</th>
                            <th>Password shown in app</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in _hashes.Samples)
                        {
                            <tr>
                                <td class="enc-record">@h.Username <span class="text-muted enc-step-note">@h.Role</span></td>
                                @if (h.IsHashed)
                                {
                                    <td><span class="att-badge att-badge--sm att-badge--present">@h.Algorithm</span></td>
                                    <td>@h.Iterations.ToString("N0")</td>
                                    <td><code class="enc-raw">@h.SaltPreview</code></td>
                                    <td><code class="enc-raw enc-raw--cipher">@h.HashPreview</code></td>
                                }
                                else
                                {
                                    <td colspan="4"><span class="att-badge att-badge--sm att-badge--late">Not a PBKDF2 hash</span></td>
                                }
                                <td class="text-muted">Never. It cannot be recovered</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted enc-footnote">
                Showing the newest @_hashes.Samples.Count account@(_hashes.Samples.Count == 1 ? "" : "s"). Salts and hashes are cut short here on purpose.
            </p>
        }
    </div>

    @* ── 5. Try hashing ── *@
    <div class="page-card enc-card">
        <h2 class="card-heading">Try hashing yourself</h2>
        <p class="text-muted enc-help">
            Runs in memory with the same code that hashes real passwords. Nothing is saved.
        </p>

        <div class="enc-try-input">
            <label class="form-label" for="hash-input">Password to hash</label>
            <div class="enc-actions">
                <input id="hash-input" class="form-input" @bind="_hashInput" @bind:event="oninput" placeholder="e.g. MyPassword123" maxlength="200" />
                <button class="btn btn-primary" @onclick="HashSample" disabled="@string.IsNullOrEmpty(_hashInput)">Hash</button>
            </div>
        </div>

        @if (_hash is not null)
        {
            <div class="enc-steps">
                <div class="enc-step">
                    <span class="enc-step-num">1</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Hashed value (this is what gets saved)</span>
                        <code class="enc-raw enc-raw--cipher enc-raw--full">@_hash</code>
                        <span class="text-muted enc-step-note">
                            Format: <code>PBKDF2</code> $ iterations $ base64( 16-byte random salt ) $ base64( 32-byte hash ).
                            The 100,000 iterations make every guess slow for an attacker.
                        </span>
                    </div>
                </div>

                <div class="enc-step">
                    <span class="enc-step-num">2</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Same password, hashed again</span>
                        <code class="enc-raw enc-raw--cipher enc-raw--full">@_hash2</code>
                        <span class="text-muted enc-step-note">
                            Different because each hash gets its own random salt, so two users with the same password
                            do not have the same hash in the database.
                        </span>
                    </div>
                </div>

                <div class="enc-step">
                    <span class="enc-step-num">3</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">Sign-in check</span>
                        <span class="text-muted enc-step-note">
                            There is no "decrypt" step. Type a password and the app hashes it with the salt from step 1 and compares.
                        </span>
                        <div class="enc-try-input">
                            <div class="enc-actions">
                                <input class="form-input" aria-label="Password to check" @bind="_verifyInput" @bind:event="oninput" placeholder="Type a password to check" maxlength="200" />
                                <button class="btn btn-ghost" @onclick="VerifySample" disabled="@string.IsNullOrEmpty(_verifyInput)">Check</button>
                            </div>
                        </div>
                        @if (_verified is not null)
                        {
                            <span class="enc-plain @(_verified == true ? "enc-plain--ok" : "enc-plain--bad")">
                                @(_verified == true ? "Match: sign-in would succeed." : "No match: sign-in would be refused.")
                            </span>
                        }
                    </div>
                </div>

                <div class="enc-step">
                    <span class="enc-step-num">4</span>
                    <div class="enc-step-body">
                        <span class="enc-step-title">One character changes everything (plain SHA-256)</span>
                        <span class="text-muted enc-step-note">SHA-256 of "@Shorten(_shaText!)"</span>
                        <code class="enc-raw enc-raw--full">@_sha</code>
                        <span class="text-muted enc-step-note">SHA-256 of "@Shorten(_shaChangedText!)"</span>
                        <code class="enc-raw enc-raw--cipher enc-raw--full">@_shaChanged</code>
                        <span class="text-muted enc-step-note">
                            @_shaBitsChanged of 256 bits differ after changing one character, so a hash gives no hint of how close a guess was.
                            SHA-256 is the building block inside PBKDF2; the app also uses it for the key fingerprint above and to stamp each attendance record.
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── 6. Record seals (HMAC) ── *@
    <div class="page-card enc-card">
        <h2 class="card-heading">Attendance record seals (HMAC-SHA256)</h2>
        <p class="text-muted enc-help">
            Every attendance record the app saves is stamped with a keyed hash of its session, student, status and who marked it.
            If someone changes a record directly in the database, the stamp no longer matches and the record is flagged here.
            Without the app's key, a matching stamp cannot be forged.
        </p>

        @if (_seals is not null)
        {
            <div class="enc-actions enc-seal-counts">
                <span class="att-badge att-badge--present">@_seals.Intact.ToString("N0") intact</span>
                <span class="att-badge @(_seals.Altered > 0 ? "att-badge--absent" : "att-badge--present")">@_seals.Altered.ToString("N0") altered outside the app</span>
                <span class="att-badge @(_seals.Unsealed > 0 ? "att-badge--late" : "att-badge--present")">@_seals.Unsealed.ToString("N0") not sealed yet</span>
            </div>

            @if (_seals.Unsealed > 0)
            {
                <p class="text-muted enc-help">
                    @_seals.Unsealed.ToString("N0") record@(_seals.Unsealed == 1 ? " was" : "s were") saved before sealing was added, so there is nothing to check
                    @(_seals.Unsealed == 1 ? "it" : "them") against. New and edited records are sealed automatically.
                </p>
                @if (!_sealConfirming)
                {
                    <div class="enc-seal-counts"><button class="btn btn-primary" @onclick="() => _sealConfirming = true" disabled="@_sealing">Seal existing records…</button></div>
                }
                else
                {
                    <div class="enc-confirm enc-seal-counts" role="alert">
                        <p>
                            This stamps @_seals.Unsealed.ToString("N0") record@(_seals.Unsealed == 1 ? "" : "s") as they are right now.
                            Only do this if you trust the current attendance data. Records already flagged as altered are not touched.
                        </p>
                        <div class="enc-actions">
                            <button class="btn btn-primary" @onclick="SealExistingAsync" disabled="@_sealing">
                                @if (_sealing) { <span class="spinner-sm"></span> }
                                Yes, seal now
                            </button>
                            <button class="btn btn-ghost" @onclick="() => _sealConfirming = false" disabled="@_sealing">Cancel</button>
                        </div>
                    </div>
                }
            }

            @if (_seals.Samples.Count == 0)
            {
                <p class="text-muted">No attendance records yet.</p>
            }
            else
            {
                <div class="table-scroll">
                    <table class="students-table enc-table">
                        <thead>
                            <tr>
                                <th>Record</th>
                                <th>Status</th>
                                <th>Seal stored in database</th>
                                <th>Check</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _seals.Samples)
                            {
                                <tr>
                                    <td class="enc-record">@s.Student <span class="text-muted enc-step-note">#@s.Id</span></td>
                                    <td>@s.Status</td>
                                    <td><code class="enc-raw @(s.State == SealState.Unsealed ? "" : "enc-raw--cipher")" title="@s.StoredSeal">@Shorten(s.StoredSeal)</code></td>
                                    <td>
                                        @switch (s.State)
                                        {
                                            case SealState.Intact:
                                                <span class="att-badge att-badge--sm att-badge--present">Intact</span>
                                                break;
                                            case SealState.Altered:
                                                <span class="att-badge att-badge--sm att-badge--absent">Altered outside the app</span>
                                                break;
                                            default:
                                                <span class="att-badge att-badge--sm att-badge--late">Not sealed</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted enc-footnote">
                    All @((_seals.Intact + _seals.Altered + _seals.Unsealed).ToString("N0")) records were checked. Showing @_seals.Samples.Count, altered ones first, then the newest.
                </p>
            }
        }
    </div>

    @* ── 7. Try the seal ── *@
    <div class="page-card enc-card">
        <h2 class="card-heading">Try the seal yourself</h2>
        <p class="text-muted enc-help">
            A made-up record, sealed in memory with the app's real key. Nothing is written to the database.
        </p>

        <div class="enc-steps">
            <div class="enc-step">
                <span class="enc-step-num">1</span>
                <div class="enc-step-body">
                    <span class="enc-step-title">The app saves a record: session @DemoSession, student @DemoStudent, marked ABSENT by user @DemoMarker</span>
                    <span class="text-muted enc-step-note">Text that gets signed: <code>@RecordSeal.Message(DemoSession, DemoStudent, "ABSENT", DemoMarker)</code></span>
                    <code class="enc-raw enc-raw--cipher enc-raw--full">@_demoSeal</code>
                    <span class="text-muted enc-step-note">
                        Format: <code>hmac:v1:</code> + HMAC-SHA256( secret key, signed text ). The key is derived from the app's data key and never stored in the database.
                    </span>
                </div>
            </div>

            <div class="enc-step">
                <span class="enc-step-num">2</span>
                <div class="enc-step-body">
                    <span class="enc-step-title">Someone edits the status directly in the database</span>
                    <div class="enc-try-input">
                        <div class="enc-actions">
                            <select class="form-input" aria-label="Status now in the database" @bind="_demoStatus">
                                @foreach (var status in DemoStatuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                    </div>
                    <span class="text-muted enc-step-note">Seal the app expects for "@_demoStatus":</span>
                    <code class="enc-raw enc-raw--full">@RecordSeal.Compute(DemoSession, DemoStudent, _demoStatus, DemoMarker)</code>
                    @if (RecordSeal.Check(DemoSession, DemoStudent, _demoStatus, DemoMarker, _demoSeal) == SealState.Intact)
                    {
                        <span class="enc-plain enc-plain--ok">Matches the stored seal: the record is intact.</span>
                    }
                    else
                    {
                        <span class="enc-plain enc-plain--bad">Does not match the stored seal: the record is flagged as altered.</span>
                    }
                </div>
            </div>

            <div class="enc-step">
                <span class="enc-step-num">3</span>
                <div class="enc-step-body">
                    <span class="enc-step-title">Why a plain hash is not enough</span>
                    <span class="text-muted enc-step-note">Plain SHA-256 of the same text, which anyone can calculate:</span>
                    <code class="enc-raw enc-raw--full">@PlainSha(RecordSeal.Message(DemoSession, DemoStudent, _demoStatus, DemoMarker))</code>
                    <span class="text-muted enc-step-note">
                        With a plain hash, whoever edits the status can simply recalculate the hash and store that too.
                        HMAC mixes in a secret key, so only the app can produce a seal that passes the check.
                    </span>
                </div>
            </div>
        </div>
    </div>
}

@code {
