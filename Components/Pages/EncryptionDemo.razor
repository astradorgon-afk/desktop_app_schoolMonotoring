    private void EncryptSample()
    {
        if (string.IsNullOrEmpty(_input)) return;
        _cipher = DataEncryption.EncryptText(_input);
        _cipher2 = DataEncryption.EncryptText(_input);
        _tampered = null;
        _tamperNote = null;
        _decryptInput = _cipher;
        _decrypted = null;
        _decryptNote = null;
    }

    private string _decryptInput = "";
    private string? _decrypted;
    private string? _decryptNote;

    private void DecryptSample()
    {
        var value = _decryptInput.Trim();
        _decrypted = null;
        _decryptNote = null;

        if (!DataEncryption.IsEncrypted(value))
        {
            _decryptNote = "That is not an encrypted value: it does not start with enc:v1:.";
            return;
        }

        var plain = DataEncryption.DecryptText(value);
        if (plain == DataEncryption.Unreadable)
            _decryptNote = "Could not decrypt: the value was changed or was encrypted with a different key.";
        else
            _decrypted = plain;
    }

    // Flips the lowest bit of the first ciphertext byte (just after the 12-byte nonce),
    // or of the tag when the input was too short to have ciphertext bytes.
    private void TamperSample()
    {
        if (_cipher is null) return;

        byte[] bytes;
        try
        {
            bytes = Convert.FromBase64String(_cipher[DataEncryption.TextPrefix.Length..]);
        }
        catch (FormatException)
        {
            // The typed text already looked like "enc:v1:…" so it was kept as-is.
            _tamperNote = "Type ordinary text to run the tamper test.";
            return;
        }
        if (bytes.Length == 0) return;

        var index = bytes.Length > 12 + 16 ? 12 : bytes.Length - 1;
        var before = bytes[index];
        bytes[index] ^= 0x01;

        _tampered = DataEncryption.TextPrefix + Convert.ToBase64String(bytes);
        _tamperNote = $"Byte {index} changed from 0x{before:X2} to 0x{bytes[index]:X2}: one bit out of {bytes.Length * 8:N0}.";
    }

