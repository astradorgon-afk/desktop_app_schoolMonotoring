    private static string PlainSha(string text) =>
        Convert.ToHexStringLower(System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(text)));

    private void HashSample()
    {
        if (string.IsNullOrEmpty(_hashInput)) return;
        _hash = PasswordHelper.Hash(_hashInput);
        _hash2 = PasswordHelper.Hash(_hashInput);
        _verifyInput = "";
        _verified = null;

        // Same text with its last character nudged to the next one.
        _shaText = _hashInput;
        _shaChangedText = _hashInput[..^1] + (char)(_hashInput[^1] == 'z' ? 'y' : _hashInput[^1] + 1);
        var a = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(_shaText));
        var b = System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(_shaChangedText));
        _sha = Convert.ToHexStringLower(a);
        _shaChanged = Convert.ToHexStringLower(b);
        _shaBitsChanged = a.Zip(b, (x, y) => System.Numerics.BitOperations.PopCount((uint)(x ^ y))).Sum();
    }

    private void VerifySample()
