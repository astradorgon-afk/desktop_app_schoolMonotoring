@page "/teacher/notifications"
@layout MainLayout
@using AttendanceUI.Data.Entities
@implements IAsyncDisposable
@inject ITeacherSessionService SessionService
@inject ITeacherService TeacherService
@inject IUserService UserService
@inject IStudentPortalService StudentPortalService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageHeader Title="Notifications" Subtitle="Stay updated with your classes and attendance activity">
</PageHeader>

@if (_loading)
{
    <div style="display:flex;align-items:center;justify-content:center;padding:80px 0;">
        <div class="spinner" style="width:32px;height:32px;"></div>
    </div>
}
else if (_error is not null)
{
    <div style="padding:0 32px;">
        <div class="error-banner">@_error</div>
    </div>
}
else if (_items.Count == 0)
{
    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 32px;">
        <div style="width:80px;height:80px;border-radius:50%;background:var(--clr-surface-alt);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="1.5">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
        </div>
        <h3 style="font-size:18px;font-weight:700;color:var(--clr-text);margin:0 0 4px;">@_emptyTitle</h3>
        <p style="font-size:13px;color:var(--clr-text-muted);margin:0;">@_emptyMessage</p>
    </div>
}
else
{
    <div style="padding:0 32px;">
        <div style="display:flex;flex-direction:column;gap:6px;">
            @foreach (var n in _items)
            {
                <div style="display:flex;align-items:flex-start;gap:14px;padding:16px 20px;background:var(--clr-surface);border:1px solid var(--clr-border);border-radius:12px;box-shadow:var(--shadow-card);">
                    <div style="width:36px;height:36px;border-radius:50%;background:@n.IconBg;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@n.IconColor" stroke-width="2">@((MarkupString)n.IconPath)</svg>
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div style="font-size:14px;font-weight:600;color:var(--clr-text);">@n.Title</div>
                        <div style="font-size:13px;color:var(--clr-text-secondary);margin-top:2px;">@n.Body</div>
                        <div style="font-size:11px;color:var(--clr-text-muted);margin-top:6px;">@n.Time</div>
                    </div>
                    @if (!n.Read)
                    {
                        <span style="width:8px;height:8px;border-radius:50%;background:var(--clr-accent);flex-shrink:0;margin-top:6px;"></span>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .spinner {
        display: inline-block;
        border: 2px solid var(--clr-border);
        border-top-color: var(--clr-accent);
        border-radius: 50%;
        animation: _spin 0.6s linear infinite;
    }
    @@keyframes _spin { to { transform: rotate(360deg); } }
</style>

@code {
    private List<NotificationItem> _items = [];
    private bool _loading = true;
    private string? _error;
    private string _emptyTitle = "All caught up!";
    private string _emptyMessage = "No notifications yet. They'll appear here when there's activity.";
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        if (session is null) { Navigation.NavigateTo("/login"); return; }
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null) return;

            var user = await UserService.GetByIdAsync(session.UserId, _cts.Token);

            if (user?.Role == UserRole.TEACHER)
            {
                var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
                if (teacher is null) { _error = "Teacher profile not found."; return; }

                var history = await SessionService.GetAttendanceHistoryAsync(teacher.Id, null, null, _cts.Token);

                _items = [];
                foreach (var h in history.Take(20))
                {
                    _items.Add(new NotificationItem
                    {
                        Title = $"{h.SectionName} — {h.SubjectName}",
                        Body = $"{h.Present} present, {h.Late} late, {h.Absent} absent · {h.AttendanceRate}% rate",
                        Time = h.SessionDate.ToLocalTime().ToString("MMM dd, yyyy · h:mm tt"),
                        Read = true,
                        IconBg = "rgba(99,102,241,0.12)",
                        IconColor = "var(--clr-accent)",
                        IconPath = "<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\"/>"
                    });
                }
            }
            else if (user?.Role == UserRole.STUDENT)
            {
                var student = await StudentPortalService.GetStudentByUserIdAsync(session.UserId, _cts.Token);
                if (student is null) { _error = "Student profile not found."; return; }

                var history = await StudentPortalService.GetAttendanceHistoryAsync(student.Id, _cts.Token);

                _items = [];
                foreach (var h in history.Take(20))
                {
                    _items.Add(new NotificationItem
                    {
                        Title = $"{h.Subject}",
                        Body = $"Status: {h.Status}",
                        Time = h.Date.ToLocalTime().ToString("MMM dd, yyyy · h:mm tt"),
                        Read = true,
                        IconBg = h.Status switch
                        {
                            "PRESENT" => "rgba(34,197,94,0.12)",
                            "LATE" => "rgba(234,179,8,0.12)",
                            "EXCUSED" => "rgba(59,130,246,0.12)",
                            _ => "rgba(239,68,68,0.12)"
                        },
                        IconColor = h.Status switch
                        {
                            "PRESENT" => "rgb(34,197,94)",
                            "LATE" => "rgb(202,138,4)",
                            "EXCUSED" => "rgb(59,130,246)",
                            _ => "rgb(239,68,68)"
                        },
                        IconPath = "<path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/>"
                    });
                }
            }
            else
            {
                _emptyTitle = "No admin notifications";
                _emptyMessage = "Notifications are available for teacher and student accounts.";
            }
        }
        catch (Exception ex) { _error = $"Failed to load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private sealed class NotificationItem
    {
        public string Title { get; set; } = "";
        public string Body { get; set; } = "";
        public string Time { get; set; } = "";
        public bool Read { get; set; }
        public string IconBg { get; set; } = "";
        public string IconColor { get; set; } = "";
        public string IconPath { get; set; } = "";
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}