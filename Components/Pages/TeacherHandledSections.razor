@page "/teacher/handled-sections"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject ITeacherService TeacherService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageHeader Title="My Handled Sections" Subtitle="View your assigned sections, students, and class schedules">
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading your sections...</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else if (_sections.Count == 0)
{
    <div style="padding:0 32px;">
        <div class="page-card" style="text-align:center;padding:64px 32px;">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:16px;color:var(--clr-text-muted);">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
            <h3 style="color:var(--clr-text-secondary);margin-bottom:8px;">No Sections Assigned</h3>
            <p class="text-muted">You haven't been assigned to any sections yet. Contact your administrator.</p>
        </div>
    </div>
}
else
{
    <div style="padding:0 32px;">
        <div class="stats-grid" style="margin-bottom:24px;">
            @foreach (var section in _sections)
            {
                var isSelected = _selectedSection?.SectionId == section.SectionId;
                <div class="stat-card @(isSelected ? "stat-card--selected" : "")"
                     @onclick="() => SelectSection(section)">
                    <div class="stat-info">
                        <span class="stat-value" style="font-size:18px;">@section.SectionName</span>
                        <span class="stat-label">@section.GradeLevel</span>
                        @if (section.Subjects.Count > 0)
                        {
                            <div style="font-size:12px;color:var(--clr-text-muted);margin-top:4px;">@string.Join(", ", section.Subjects)</div>
                        }
                        <div style="margin-top:8px;display:flex;align-items:center;gap:4px;font-size:13px;color:#818cf8;font-weight:500;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            <span>@section.StudentCount students</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_selectedSection is not null)
        {
            <div class="content-grid" style="grid-template-columns:1fr 1fr;">
                <div class="page-card">
                    <h2 class="card-heading">Students</h2>
                    <p class="text-muted" style="margin-bottom:12px;margin-top:4px;">@_selectedSection.SectionName — @_students.Count enrolled</p>

                    @if (_studentsLoading)
                    {
                        <div style="text-align:center;padding:32px 0;">
                            <span class="spinner-sm"></span>
                        </div>
                    }
                    else if (_students.Count == 0)
                    {
                        <div style="text-align:center;padding:32px 0;color:var(--clr-text-muted);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:8px;">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                            </svg>
                            <p>No enrolled students found.</p>
                        </div>
                    }
                    else
                    {
                        <div class="students-table-wrapper" style="max-height:400px;overflow-y:auto;">
                            <table class="students-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Student Name</th>
                                        <th>LRN</th>
                                        <th>Student No.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var idx = 1;
                                    }
                                    @foreach (var s in _students)
                                    {
                                        <tr>
                                            <td style="color:var(--clr-text-muted);font-size:13px;">@idx</td>
                                            <td>
                                                <div class="student-info-cell">
                                                    <div class="student-avatar" style="width:28px;height:28px;font-size:11px;">@s.FullName[..1].ToUpper()</div>
                                                    <div class="student-name" style="font-size:13px;">@s.FullName</div>
                                                </div>
                                            </td>
                                            <td style="font-size:13px;color:var(--clr-text-secondary);">@s.Lrn</td>
                                            <td style="font-size:13px;color:var(--clr-text-secondary);">@s.StudentNumber</td>
                                        </tr>
                                        idx++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="page-card">
                    <h2 class="card-heading">Weekly Schedule</h2>
                    <p class="text-muted" style="margin-bottom:12px;margin-top:4px;">@_selectedSection.SectionName</p>

                    @if (_selectedSection.Schedules.Count == 0)
                    {
                        <div style="text-align:center;padding:32px 0;color:var(--clr-text-muted);">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:8px;">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            <p>No schedule set for this section.</p>
                        </div>
                    }
                    else
                    {
                        var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday" };
                        var grouped = _selectedSection.Schedules
                            .GroupBy(s => s.Day)
                            .ToDictionary(g => g.Key, g => g.ToList());

                        <div class="cal-week">
                            @foreach (var day in days)
                            {
                                var dayScheds = grouped.GetValueOrDefault(day, []);
                                <div class="cal-day">
                                    <div class="cal-day-header">@day.Substring(0, 3)</div>
                                    <div class="cal-day-body">
                                        @if (dayScheds.Count == 0)
                                        {
                                            <div class="cal-empty">—</div>
                                        }
                                        else
                                        {
                                            @foreach (var sched in dayScheds)
                                            {
                                                <div class="cal-card">
                                                    <div class="cal-time">@sched.StartTime</div>
                                                    <div class="cal-subject">@sched.Subject</div>
                                                    <div class="cal-meta">@(!string.IsNullOrEmpty(sched.Room) ? sched.Room : "")</div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--clr-border);">
                            <p style="font-size:13px;color:var(--clr-text-secondary);font-weight:600;margin-bottom:8px;">All Schedules</p>
                            @foreach (var sched in _selectedSection.Schedules)
                            {
                                <div style="display:flex;align-items:center;gap:8px;padding:6px 0;font-size:13px;border-bottom:1px solid var(--clr-border);">
                                    <span style="font-weight:500;color:var(--clr-text-secondary);min-width:68px;">@sched.Day</span>
                                    <span style="color:var(--clr-text-secondary);min-width:80px;">@sched.StartTime - @sched.EndTime</span>
                                    <span style="font-weight:500;color:var(--clr-text);">@sched.Subject</span>
                                    @if (!string.IsNullOrEmpty(sched.Room))
                                    {
                                        <span style="color:var(--clr-text-muted);">· @sched.Room</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div style="text-align:center;padding:64px 32px;color:var(--clr-text-muted);">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px;">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
                <p>Select a section above to view its students and schedule.</p>
            </div>
        }
    </div>
}

@code {
    private List<TeacherSectionView> _sections = [];
    private TeacherSectionView? _selectedSection;
    private List<SectionEnrolledStudent> _students = [];
    private bool _isLoading = true;
    private bool _studentsLoading;
    private string? _error;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSectionsAsync();
    }

    private async Task LoadSectionsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
            if (teacher is null)
            {
                _error = "Teacher profile not found for your account.";
                return;
            }

            _sections = await TeacherService.GetHandledSectionsAsync(teacher.Id, _cts.Token);

            if (_sections.Count > 0)
            {
                await SelectSection(_sections[0]);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load sections: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectSection(TeacherSectionView section)
    {
        _selectedSection = section;
        _studentsLoading = true;

        try
        {
            _students = await TeacherService.GetSectionStudentsAsync(section.SectionId, _cts.Token);
        }
        catch
        {
            _students = [];
        }
        finally
        {
            _studentsLoading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
