@page "/qr-codes"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using AttendanceUI.Models.Auth
@using AttendanceUI.Services
@inject IQrCodeService QrCodeService
@inject IStudentService StudentService
@inject IRoomService RoomService
@inject IAuthService AuthService
@inject IJSRuntime JS
@implements IDisposable

<PageHeader Title="QR Codes" Subtitle="Generate, print, reissue and verify student and room QR codes">
    <div class="header-actions">
        @if (_authorized && !_isLoading)
        {
            @if (MissingCount > 0)
            {
                <button class="action-btn action-btn--green" @onclick="GenerateMissingAsync" disabled="@_busy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <span>Generate Missing (@MissingCount)</span>
                </button>
            }
            <button class="action-btn action-btn--purple" @onclick="PrintAsync" disabled="@(_busy || PrintCount == 0)">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                <span>@(SelectedCount > 0 ? $"Print Selected ({PrintCount})" : $"Print All Shown ({PrintCount})")</span>
            </button>
        }
        <span class="header-date">@DateTime.Now.ToString("MMM dd, yyyy")</span>
    </div>
</PageHeader>

@if (!_authorized)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>You do not have permission to manage QR codes.</span>
    </div>
}
else if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@(_busyMessage ?? "Loading QR codes...")</p>
    </div>
}
else
{
    @if (_error is not null)
    {
        <div class="error-banner" style="margin: 0 32px 16px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span>@_error</span>
        </div>
    }
    @if (_message is not null)
    {
        <div class="success-banner" style="margin: 0 32px 16px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>@_message</span>
        </div>
    }

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon stat-icon--purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 20h3v-3"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_students.Count(s => s.QrImage is not null) / @_students.Count</span>
                <span class="stat-label">Students with QR</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--@(_students.Any(s => s.QrImage is null) ? "yellow" : "green")">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_students.Count(s => s.QrImage is null)</span>
                <span class="stat-label">Students missing QR</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--blue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_rooms.Count(r => r.QrCode is not null) / @_rooms.Count</span>
                <span class="stat-label">Rooms with QR</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon--teal">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
            <div class="stat-info">
                <span class="stat-value">@_students.Where(s => s.SectionId is not null).Select(s => s.SectionId).Distinct().Count()</span>
                <span class="stat-label">Sections enrolled</span>
            </div>
        </div>
    </div>

    <div class="qr-verify page-card">
        <div class="qr-verify-head">
            <div>
                <div class="qr-verify-title">Verify a QR code</div>
                <div class="qr-verify-sub">Scan with a USB scanner or paste the QR text to see whose code it is and whether it still works.</div>
            </div>
        </div>
        <div class="qr-verify-row">
            <input type="text" class="form-input" aria-label="QR value to verify" placeholder="e.g. ATTENDANCE:123456789012:2024-0001"
                   @bind="_lookupValue" @bind:event="oninput" @onkeydown="OnLookupKeyDown" />
            <button class="btn btn-primary" @onclick="LookupAsync" disabled="@_busy">Check</button>
        </div>
        @if (_lookupResult is not null)
        {
            <div class="qr-verify-result @(_lookupResult.IsValid ? "qr-verify-result--ok" : "qr-verify-result--bad")">
                <strong>@_lookupResult.Title</strong>
                <span>@_lookupResult.Detail</span>
            </div>
        }
    </div>

    <div class="qr-tabs-row">
        <div class="qr-tabs">
            <button type="button" class="@(_tab == Tab.Students ? "tab-btn tab-btn--active" : "tab-btn")" @onclick="() => SwitchTab(Tab.Students)">Students</button>
            <button type="button" class="@(_tab == Tab.Rooms ? "tab-btn tab-btn--active" : "tab-btn")" @onclick="() => SwitchTab(Tab.Rooms)">Rooms</button>
        </div>
    </div>

    @if (_tab == Tab.Students)
    {
        <div class="students-toolbar">
            <div class="search-wrapper">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" class="search-input" aria-label="Search students" placeholder="Search by name, LRN, or student number..." @bind="_searchTerm" @bind:after="ApplyFilter" />
            </div>
            <select class="filter-select" aria-label="Section" @bind="_sectionFilter" @bind:after="ApplyFilter">
                <option value="">All Sections</option>
                <option value="none">No section</option>
                @foreach (var section in _sectionOptions)
                {
                    <option value="@section.Id">@section.Name</option>
                }
            </select>
            <select class="filter-select" aria-label="QR status" @bind="_qrFilter" @bind:after="ApplyFilter">
                <option value="">Any QR status</option>
                <option value="has">Has QR</option>
                <option value="missing">Missing QR</option>
                <option value="reissued">Reissued</option>
            </select>
        </div>

        <div class="students-table-wrapper">
            <table class="students-table">
                <thead>
                    <tr>
                        <th class="col-check">
                            <input type="checkbox" class="select-checkbox" aria-label="Select all shown" checked="@AllStudentsSelected" @onchange="ToggleSelectAllStudents" />
                        </th>
                        <th>Student</th>
                        <th>Section</th>
                        <th>LRN</th>
                        <th>QR Code</th>
                        <th>Last Updated</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filteredStudents.Count == 0)
                    {
                        <tr><td colspan="7" class="empty-state">No students match your filters.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _filteredStudents)
                        {
                            <tr class="@(_selectedStudentIds.Contains(s.StudentId) ? "row-selected" : "")">
                                <td class="col-check">
                                    <input type="checkbox" class="select-checkbox" aria-label="Select @s.FullName" checked="@_selectedStudentIds.Contains(s.StudentId)" @onchange="() => ToggleStudent(s.StudentId)" />
                                </td>
                                <td>
                                    <div class="student-info-cell">
                                        <div class="student-avatar">@Initials(s.FirstName, s.LastName)</div>
                                        <div>
                                            <div class="student-name">@s.FullName</div>
                                            <div class="student-meta">No. @s.StudentNumber@(s.Status != "ACTIVE" ? $" · {s.Status}" : "")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@(s.SectionName ?? "—")@(s.GradeLevelName is not null ? $" · {s.GradeLevelName}" : "")</td>
                                <td><span class="code-badge">@s.Lrn</span></td>
                                <td class="col-qr">
                                    @if (s.QrImage is not null)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(s.QrImage)" alt="QR code for @s.FullName" class="qr-thumb" role="button" tabindex="0" @onclick="() => ShowPreview(s)" @onkeydown="e => { if (KeyActivation.IsActivation(e)) ShowPreview(s); }" />
                                        @if (IsReissued(s.QrContent))
                                        {
                                            <span class="qr-reissued-tag" title="This card was reissued; older printouts no longer scan.">Reissued</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">No QR code</span>
                                    }
                                </td>
                                <td class="text-muted">@(s.QrUpdatedAt.HasValue ? s.QrUpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy") : "—")</td>
                                <td style="text-align:right;white-space:nowrap;">
                                    @if (s.QrImage is not null)
                                    {
                                        <button class="btn btn-ghost btn-sm" title="Save as PNG" @onclick="() => DownloadStudentAsync(s)">PNG</button>
                                    }
                                    <button class="btn btn-ghost btn-sm" title="Issue a new QR; the old card stops working" @onclick="() => AskReissueStudent(s)" disabled="@_busy">Reissue</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="students-toolbar">
            <div class="search-wrapper">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" class="search-input" aria-label="Search rooms" placeholder="Search by room name or code..." @bind="_roomSearch" @bind:after="ApplyRoomFilter" />
            </div>
            <select class="filter-select" aria-label="QR status" @bind="_roomQrFilter" @bind:after="ApplyRoomFilter">
                <option value="">Any QR status</option>
                <option value="has">Has QR</option>
                <option value="missing">Missing QR</option>
            </select>
        </div>

        <div class="students-table-wrapper">
            <table class="students-table">
                <thead>
                    <tr>
                        <th class="col-check">
                            <input type="checkbox" class="select-checkbox" aria-label="Select all shown" checked="@AllRoomsSelected" @onchange="ToggleSelectAllRooms" />
                        </th>
                        <th>Room</th>
                        <th>Code</th>
                        <th>Status</th>
                        <th>QR Code</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_filteredRooms.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-state">No rooms match your filters.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in _filteredRooms)
                        {
                            <tr class="@(_selectedRoomIds.Contains(r.Id) ? "row-selected" : "")">
                                <td class="col-check">
                                    <input type="checkbox" class="select-checkbox" aria-label="Select @r.Name" checked="@_selectedRoomIds.Contains(r.Id)" @onchange="() => ToggleRoom(r.Id)" />
                                </td>
                                <td><div class="student-name">@r.Name</div></td>
                                <td><span class="code-badge code-badge--alt">@r.Code</span></td>
                                <td>
                                    <span class="status-badge status-badge--@(r.IsActive ? "active" : "inactive")">@(r.IsActive ? "ACTIVE" : "INACTIVE")</span>
                                </td>
                                <td class="col-qr">
                                    @if (r.QrCode is not null)
                                    {
                                        <img src="data:image/png;base64,@Convert.ToBase64String(r.QrCode.QrCode)" alt="QR code for @r.Name" class="qr-thumb" role="button" tabindex="0" @onclick="() => ShowPreview(r)" @onkeydown="e => { if (KeyActivation.IsActivation(e)) ShowPreview(r); }" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No QR code</span>
                                    }
                                </td>
                                <td style="text-align:right;white-space:nowrap;">
                                    @if (r.QrCode is not null)
                                    {
                                        <button class="btn btn-ghost btn-sm" title="Save as PNG" @onclick="() => DownloadRoomAsync(r)">PNG</button>
                                    }
                                    <button class="btn btn-ghost btn-sm" title="Issue a new QR; the old one stops working" @onclick="() => AskReissueRoom(r)" disabled="@_busy">Reissue</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (_preview is not null)
{
    <Modal Title="QR Code" ContentStyle="max-width:420px;" OnClose="() => _preview = null">
        <div class="modal-header">
            <h3>@_preview.Value.Title</h3>
            <button class="modal-close" aria-label="Close" @onclick="() => _preview = null">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body" style="text-align:center;">
            <img src="data:image/png;base64,@_preview.Value.Base64" alt="QR code" class="profile-qr-image" />
            <div class="profile-qr-content">@_preview.Value.Content</div>
        </div>
        <div class="modal-footer">
            <button class="action-btn" @onclick="() => _preview = null">Close</button>
        </div>
    </Modal>
}

@if (_reissueTarget is not null)
{
    <Modal Title="Reissue QR code" ContentStyle="max-width:460px;" OnClose="CancelReissue">
        <div class="modal-header">
            <h3>Reissue QR code?</h3>
            <button class="modal-close" aria-label="Close" @onclick="CancelReissue">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <p style="margin:0 0 10px;">A new QR code will be issued for <strong>@_reissueTarget.Value.Name</strong>.</p>
            <p class="text-muted" style="margin:0;">Any printed copy of the current code will stop working immediately. Use this when a card is lost, damaged or being shared. You'll need to print the new code.</p>
        </div>
        <div class="modal-footer">
            <button class="action-btn" @onclick="CancelReissue" disabled="@_busy">Cancel</button>
            <button class="btn btn-danger" @onclick="ConfirmReissueAsync" disabled="@_busy">
                @if (_busy) { <span class="spinner-sm"></span> }
                Reissue
            </button>
        </div>
    </Modal>
}

@code {
    private enum Tab { Students, Rooms }

    private readonly CancellationTokenSource _cts = new();

    private bool _authorized = true;
    private UserSession? _session;
    private bool _isLoading = true;
    private bool _busy;
    private string? _busyMessage;
    private string? _error;
    private string? _message;
    private Tab _tab = Tab.Students;

    private List<StudentQrRow> _students = [];
    private List<StudentQrRow> _filteredStudents = [];
    private List<(long Id, string Name)> _sectionOptions = [];
    private HashSet<long> _selectedStudentIds = [];
    private string _searchTerm = "";
    private string _sectionFilter = "";
    private string _qrFilter = "";

    private List<Room> _rooms = [];
    private List<Room> _filteredRooms = [];
    private HashSet<long> _selectedRoomIds = [];
    private string _roomSearch = "";
    private string _roomQrFilter = "";

    private string _lookupValue = "";
    private QrLookupResult? _lookupResult;

    private (string Title, string Base64, string Content)? _preview;
    private (bool IsRoom, long Id, string Name)? _reissueTarget;

    private int MissingCount => _tab == Tab.Students
        ? _students.Count(s => s.QrImage is null)
        : _rooms.Count(r => r.QrCode is null);

    private int SelectedCount => _tab == Tab.Students ? _selectedStudentIds.Count : _selectedRoomIds.Count;

    private int PrintCount => _tab == Tab.Students
        ? StudentsToPrint().Count
        : RoomsToPrint().Count;

    private bool AllStudentsSelected => _filteredStudents.Count > 0
        && _filteredStudents.All(s => _selectedStudentIds.Contains(s.StudentId));

    private bool AllRoomsSelected => _filteredRooms.Count > 0
        && _filteredRooms.All(r => _selectedRoomIds.Contains(r.Id));

    protected override async Task OnInitializedAsync()
    {
        _session = await AuthService.GetCurrentSessionAsync();
        _authorized = _session is not null && _session.Role == UserRole.SUPERADMIN;
        if (!_authorized)
        {
            _isLoading = false;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _students = await QrCodeService.GetStudentQrRowsAsync(_cts.Token);
            _rooms = (await RoomService.GetAllAsync(_cts.Token)).ToList();
            _sectionOptions = _students
                .Where(s => s.SectionId is not null)
                .Select(s => (s.SectionId!.Value, s.SectionName ?? $"Section {s.SectionId}"))
                .Distinct()
                .OrderBy(s => s.Item2)
                .ToList();
            ApplyFilter();
            ApplyRoomFilter();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to load QR codes: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            _busyMessage = null;
        }
    }

    private void SwitchTab(Tab tab)
    {
        _tab = tab;
        _message = null;
        _error = null;
    }

    private void ApplyFilter()
    {
        var query = _students.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim();
            query = query.Where(s =>
                s.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.Lrn.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.StudentNumber.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (_sectionFilter == "none")
            query = query.Where(s => s.SectionId is null);
        else if (long.TryParse(_sectionFilter, out var sectionId))
            query = query.Where(s => s.SectionId == sectionId);

        query = _qrFilter switch
        {
            "has" => query.Where(s => s.QrImage is not null),
            "missing" => query.Where(s => s.QrImage is null),
            "reissued" => query.Where(s => IsReissued(s.QrContent)),
            _ => query
        };

        _filteredStudents = query.ToList();
    }

    private void ApplyRoomFilter()
    {
        var query = _rooms.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_roomSearch))
        {
            var term = _roomSearch.Trim();
            query = query.Where(r =>
                r.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                r.Code.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        query = _roomQrFilter switch
        {
            "has" => query.Where(r => r.QrCode is not null),
            "missing" => query.Where(r => r.QrCode is null),
            _ => query
        };

        _filteredRooms = query.ToList();
    }

    private void ToggleStudent(long id)
    {
        if (!_selectedStudentIds.Remove(id))
            _selectedStudentIds.Add(id);
    }

    private void ToggleSelectAllStudents()
    {
        if (AllStudentsSelected)
            _selectedStudentIds.ExceptWith(_filteredStudents.Select(s => s.StudentId));
        else
            _selectedStudentIds.UnionWith(_filteredStudents.Select(s => s.StudentId));
    }

    private void ToggleRoom(long id)
    {
        if (!_selectedRoomIds.Remove(id))
            _selectedRoomIds.Add(id);
    }

    private void ToggleSelectAllRooms()
    {
        if (AllRoomsSelected)
            _selectedRoomIds.ExceptWith(_filteredRooms.Select(r => r.Id));
        else
            _selectedRoomIds.UnionWith(_filteredRooms.Select(r => r.Id));
    }

    private async Task GenerateMissingAsync()
    {
        _busy = true;
        _error = null;
        _message = null;
        try
        {
            if (_tab == Tab.Students)
            {
                var missing = _students.Where(s => s.QrImage is null).ToList();
                _busyMessage = $"Generating QR codes for {missing.Count} students...";
                _isLoading = true;
                StateHasChanged();

                foreach (var s in missing)
                {
                    if (_cts.IsCancellationRequested) break;
                    await StudentService.GenerateQrCodeAsync(s.StudentId, _cts.Token);
                }
                _message = $"Generated QR codes for {missing.Count} students.";
            }
            else
            {
                var missing = _rooms.Where(r => r.QrCode is null).ToList();
                await RoomService.GenerateMissingBatchAsync(missing, _cts.Token);
                _message = $"Generated QR codes for {missing.Count} rooms.";
            }

            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to generate QR codes: {ex.Message}";
            _isLoading = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private List<StudentQrRow> StudentsToPrint()
    {
        var source = _selectedStudentIds.Count > 0
            ? _students.Where(s => _selectedStudentIds.Contains(s.StudentId))
            : _filteredStudents;
        return source.Where(s => s.QrImage is not null).ToList();
    }

    private List<Room> RoomsToPrint()
    {
        var source = _selectedRoomIds.Count > 0
            ? _rooms.Where(r => _selectedRoomIds.Contains(r.Id))
            : _filteredRooms;
        return source.Where(r => r.QrCode is not null).ToList();
    }

    private async Task PrintAsync()
    {
        object groups;
        if (_tab == Tab.Students)
        {
            var rows = StudentsToPrint();
            if (rows.Count == 0) return;

            groups = rows
                .GroupBy(s => s.SectionName)
                .OrderBy(g => g.Key is null)
                .ThenBy(g => g.Key)
                .Select(g => new
                {
                    title = g.Key is null ? "No section" : $"{g.Key}{(g.First().GradeLevelName is { } grade ? $" · {grade}" : "")}",
                    cards = g.OrderBy(s => s.LastName).ThenBy(s => s.FirstName).Select(s => new
                    {
                        name = s.FullName,
                        line1 = $"LRN {s.Lrn}",
                        line2 = $"No. {s.StudentNumber}",
                        qrBase64 = Convert.ToBase64String(s.QrImage!)
                    })
                })
                .ToList();
        }
        else
        {
            var rooms = RoomsToPrint();
            if (rooms.Count == 0) return;

            groups = new[]
            {
                new
                {
                    title = "Rooms",
                    cards = rooms.Select(r => new
                    {
                        name = r.Name,
                        line1 = r.Code,
                        line2 = "",
                        qrBase64 = Convert.ToBase64String(r.QrCode!.QrCode)
                    })
                }
            };
        }

        await JS.InvokeVoidAsync("qrCodes.printCards", System.Text.Json.JsonSerializer.Serialize(groups));
    }

    private async Task DownloadStudentAsync(StudentQrRow s)
    {
        if (s.QrImage is null) return;
        var data = new
        {
            name = s.FullName,
            lrn = s.Lrn,
            studentNumber = s.StudentNumber,
            qrBase64 = Convert.ToBase64String(s.QrImage),
            fileName = $"QR_{s.LastName}_{s.FirstName}_{s.Lrn}".Replace(" ", "_")
        };
        await JS.InvokeVoidAsync("students.downloadQrAsPng", System.Text.Json.JsonSerializer.Serialize(data));
    }

    private async Task DownloadRoomAsync(Room r)
    {
        if (r.QrCode is null) return;
        var data = new
        {
            name = r.Name,
            code = r.Code,
            qrBase64 = Convert.ToBase64String(r.QrCode.QrCode),
            fileName = $"QR_{r.Name}_{r.Code}".Replace(" ", "_")
        };
        await JS.InvokeVoidAsync("rooms.downloadAsPng", System.Text.Json.JsonSerializer.Serialize(data));
    }

    private void ShowPreview(StudentQrRow s)
    {
        if (s.QrImage is null) return;
        _preview = (s.FullName, Convert.ToBase64String(s.QrImage), s.QrContent ?? "");
    }

    private void ShowPreview(Room r)
    {
        if (r.QrCode is null) return;
        _preview = ($"{r.Name} ({r.Code})", Convert.ToBase64String(r.QrCode.QrCode), r.QrCode.QrContent);
    }

    private void AskReissueStudent(StudentQrRow s) => _reissueTarget = (false, s.StudentId, s.FullName);

    private void AskReissueRoom(Room r) => _reissueTarget = (true, r.Id, $"{r.Name} ({r.Code})");

    private void CancelReissue()
    {
        if (!_busy) _reissueTarget = null;
    }

    private async Task ConfirmReissueAsync()
    {
        if (_reissueTarget is not { } target || _session is null) return;

        _busy = true;
        _error = null;
        _message = null;
        try
        {
            var role = _session.Role.ToString();
            if (target.IsRoom)
            {
                var qr = await QrCodeService.ReissueRoomQrAsync(target.Id, _session.UserId, _session.DisplayName, role, _cts.Token);
                var room = _rooms.First(r => r.Id == target.Id);
                room.QrCode = qr;
            }
            else
            {
                var qr = await QrCodeService.ReissueStudentQrAsync(target.Id, _session.UserId, _session.DisplayName, role, _cts.Token);
                var row = _students.First(s => s.StudentId == target.Id);
                row.QrContent = qr.QrContent;
                row.QrImage = qr.QrCode;
                row.QrUpdatedAt = qr.UpdatedAt;
            }
            _message = $"New QR code issued for {target.Name}. Print it to replace the old card.";
            ApplyFilter();
            ApplyRoomFilter();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to reissue QR code: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _reissueTarget = null;
        }
    }

    private async Task OnLookupKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LookupAsync();
    }

    private async Task LookupAsync()
    {
        try
        {
            _lookupResult = await QrCodeService.LookupAsync(_lookupValue, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _lookupResult = new QrLookupResult { Title = "Lookup failed", Detail = ex.Message };
        }
    }

    // Original codes are ATTENDANCE:{lrn}:{studentNo}; reissued ones carry a fourth segment.
    private static bool IsReissued(string? content)
        => content is not null && content.Split(':').Length > 3;

    private static string Initials(string first, string last)
        => $"{(first.Length > 0 ? first[0] : ' ')}{(last.Length > 0 ? last[0] : ' ')}";

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
