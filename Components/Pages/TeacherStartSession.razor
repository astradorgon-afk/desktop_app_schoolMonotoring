@page "/teacher/start-session"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ITeacherSessionService SessionService
@inject ITeacherService TeacherService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="ss-page">

    @* ── Status Bar ── *@
    <div class="ss-topbar">
        @if (_sessionId > 0)
        {
            <div class="ss-live-badge">
                <span class="ss-live-dot"></span>
                <span>Live</span>
            </div>
            <span class="ss-top-label">@_sessionState?.SectionName</span>
            <span class="ss-top-sub">· @_sessionState?.SubjectName</span>
            @if (!string.IsNullOrEmpty(_sessionState?.Room))
            {
                <span class="ss-top-sub">· Room @_sessionState.Room</span>
            }
            <div style="flex:1;"></div>
            <span class="ss-event-count">@_syncQueue events</span>
            <button class="btn btn-ghost btn-sm" @onclick="OpenScanner" title="Scan QR">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <span>Scan</span>
            </button>
            <button class="btn btn-danger btn-sm" @onclick="EndSessionAsync" disabled="@_saving">
                <span>End</span>
            </button>
        }
        else
        {
            <div class="ss-idle-badge">
                <span class="ss-idle-dot"></span>
                <span>No Session</span>
            </div>
            <span class="ss-top-sub">Scan a QR code or select a class below</span>
            <div style="flex:1;"></div>
        }
    </div>

    @if (_loading)
    {
        <div class="ss-loading">
            <div class="ss-loading-inner">
                <h2 class="ss-loading-title">Start a Session</h2>
                <p class="ss-loading-sub">Loading your classes...</p>
                <div class="ss-skeleton-list">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="ss-skeleton-card">
                            <div class="ss-skeleton-row">
                                <div>
                                    <div class="ss-skeleton-line" style="width:180px;height:15px;"></div>
                                    <div class="ss-skeleton-line" style="width:100px;height:11px;margin-top:8px;"></div>
                                </div>
                                <div style="text-align:right;">
                                    <div class="ss-skeleton-line" style="width:50px;height:15px;margin-left:auto;"></div>
                                    <div class="ss-skeleton-line" style="width:70px;height:11px;margin-top:8px;margin-left:auto;"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (_error is not null)
    {
        <div class="ss-error">
            <div class="ss-error-inner">
                <div class="error-banner">@_error</div>
                <button class="btn btn-primary" @onclick="LoadDataAsync" style="margin-top:12px;">Retry</button>
            </div>
        </div>
    }
    else
    {
        <div class="ss-main">

            @* ── Viewfinder Zone ── *@
            <div class="ss-viewfinder">
                @if (_sessionId > 0 && _showScanner)
                {
                    <div class="ss-scanner-card">
                        <div class="ss-scanner-video">
                            <div id="qr-reader" style="width:100%;height:100%;"></div>
                            <style>
                                #qr-reader video { width: 100% !important; height: 100% !important; object-fit: cover !important; }
                                #qr-reader img { display: none; }
                            </style>
                            @if (!string.IsNullOrEmpty(_cameraError))
                            {
                                <div class="ss-scanner-overlay">
                                    <p class="ss-scanner-error-text">@_cameraError</p>
                                </div>
                            }
                            else if (!_cameraStarted)
                            {
                                <div class="ss-scanner-overlay">
                                    <span class="ss-qr-placeholder-icon">◻</span>
                                </div>
                            }
                        </div>
                        <div class="ss-scanner-input-row">
                            <input class="ss-scanner-input"
                                   aria-label="Paste QR token" placeholder="Paste QR token..."
                                   @bind="_qrInput" @bind:event="oninput" />
                            <button class="btn btn-primary" @onclick="ProcessQrInput" disabled="@_saving">Go</button>
                        </div>
                        @if (!string.IsNullOrEmpty(_qrFeedback))
                        {
                            <p class="ss-scanner-feedback" style="color:@(_qrFeedback.Contains("✓") || _qrFeedback.Contains("marked") ? "#4ade80" : "#f87171");">@_qrFeedback</p>
                        }
                    </div>
                    <button class="btn ss-stop-btn" @onclick="CloseScanner">
                        Stop Camera
                    </button>
                }
                else
                {
                    <div class="ss-placeholder-card">
                        <div class="ss-placeholder-icon">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--clr-accent);opacity:0.5;">
                                <rect x="3" y="3" width="7" height="7" rx="1"/>
                                <rect x="14" y="3" width="7" height="7" rx="1"/>
                                <rect x="14" y="14" width="7" height="7" rx="1"/>
                                <rect x="3" y="14" width="7" height="7" rx="1"/>
                                <line x1="10" y1="12" x2="14" y2="12" stroke-width="1.5"/>
                                <line x1="12" y1="10" x2="12" y2="14" stroke-width="1.5"/>
                            </svg>
                        </div>
                        <p class="ss-placeholder-text">Point camera at a QR code</p>
                        <p class="ss-placeholder-hint">Scan a room QR to start, or a student QR to mark attendance</p>
                    </div>

                    <button class="btn btn-primary" @onclick="OpenScanner">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span>Scan QR Code</span>
                    </button>
                }

                @if (_sessionId == 0)
                {
                    <div class="ss-divider">
                        <div class="ss-divider-line"></div>
                        <span class="ss-divider-text">or</span>
                        <div class="ss-divider-line"></div>
                    </div>

                    <div class="ss-section-area">
                        <p class="ss-section-label">Select a section to start a class session</p>
                        @if (_sections.Count == 0)
                        {
                            <div class="ss-empty-sections">
                                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--clr-text-muted);">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                                    <line x1="9" y1="9" x2="15" y2="9"/>
                                    <line x1="9" y1="13" x2="15" y2="13"/>
                                    <line x1="9" y1="17" x2="12" y2="17"/>
                                </svg>
                                <p>No classes scheduled for today.</p>
                            </div>
                        }
                        else
                        {
                            <div class="ss-section-picker">
                                <div @ref="_triggerRef" @onclick="ToggleDropdown" class="ss-select-trigger">
                                    <span class="ss-select-label" style="color:@(_selectedOfferingId == 0 ? "var(--clr-text-muted)" : "var(--clr-text)");">
                                        @(_selectedOfferingId == 0 ? "Choose a section..." : _selectedSectionText)
                                    </span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--clr-text-muted);transition:transform .2s;transform:@(_showDropdown ? "rotate(180deg)" : "rotate(0)");">
                                        <polyline points="6 9 12 15 18 9"/>
                                    </svg>
                                </div>
                                @if (_showDropdown)
                                {
                                    <div class="ss-dropdown" style="@(_dropUp ? "bottom:calc(100% + 6px)" : "top:calc(100% + 6px)");">
                                        @{
                                            // The list arrives sorted with today's classes first, so a single
                                            // pass can drop a heading in front of each run.
                                            var todayHeaderDone = false;
                                            var otherHeaderDone = false;
                                        }
                                        @foreach (var sec in _sections)
                                        {
                                            if (sec.IsToday && !todayHeaderDone)
                                            {
                                                todayHeaderDone = true;
                                                <div class="ss-dd-group">Today · @DateTime.Now.ToString("dddd")</div>
                                            }
                                            else if (!sec.IsToday && !otherHeaderDone)
                                            {
                                                otherHeaderDone = true;
                                                <div class="ss-dd-group">Other classes</div>
                                            }

                                            var isSelected = (sec.OfferingId ?? 0) == _selectedOfferingId;
                                            <div class="@($"ss-dd-opt {(isSelected ? "ss-dd-opt-sel" : "")}")" @onclick="() => SelectSection(sec)">
                                                <div class="ss-dd-opt-info">
                                                    <span class="ss-dd-opt-name">
                                                        @sec.SectionName
                                                        @if (sec.IsToday)
                                                        {
                                                            <span class="ss-dd-today">Today</span>
                                                        }
                                                    </span>
                                                    <span class="ss-dd-opt-sub">@sec.Subject · @(sec.IsToday ? sec.TimeDisplay : "Not scheduled today")</span>
                                                </div>
                                                @if (isSelected)
                                                {
                                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--clr-accent)" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <button class="btn btn-primary" @onclick="StartFromDropdown" disabled="@_saving">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="5 12 10 17 19 8"/></svg>
                                    <span>Start</span>
                                </button>
                            </div>
                        }
                    </div>
                }

                @* Floating notifications *@
                @if (_notifications.Count > 0)
                {
                    <div class="ss-notifications">
                        @foreach (var n in _notifications)
                        {
                            <div class="ss-notification ss-notify-@n.Type">
                                <span>@n.Text</span>
                                <button class="ss-notify-dismiss" @onclick="() => DismissNotification(n)">✕</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @* ── Roster Panel ── *@
            @if (_sessionId > 0)
            {
                <div class="ss-roster">
                    <div class="ss-roster-header">
                        <div class="ss-roster-title-row">
                            <h3 class="ss-roster-title">@_sessionState?.SectionName</h3>
                            <div class="ss-roster-stats">
                                <span class="ss-stat ss-stat-present">@(_sessionState?.PresentCount ?? 0) P</span>
                                <span class="ss-stat ss-stat-late">@(_sessionState?.LateCount ?? 0) L</span>
                                <span class="ss-stat ss-stat-absent">@(_sessionState?.AbsentCount ?? 0) A</span>
                            </div>
                        </div>
                        <div class="ss-roster-search">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--clr-text-muted);flex-shrink:0;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input aria-label="Search by name or ID" placeholder="Search by name or ID..."
                                   @bind="_rosterSearch" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="ss-roster-body">
                        @if (_students.Count == 0)
                        {
                            <div class="ss-roster-empty">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:var(--clr-text-muted);">
                                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <circle cx="9" cy="7" r="4"/>
                                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </svg>
                                <p>No students found.</p>
                            </div>
                        }
                        else
                        {
                            @for (var __fi = 0; __fi < _filteredStudents.Count; __fi++)
                            {
                                var s = _filteredStudents[__fi];
                                var avatarBg = s.Status switch
                                {
                                    "PRESENT" => "#22c55e",
                                    "LATE" => "#eab308",
                                    "ABSENT" => "#ef4444",
                                    _ => "var(--clr-surface-alt)"
                                };
                                var avatarText = s.Status switch
                                {
                                    "PRESENT" => "#fff",
                                    "LATE" => "#fff",
                                    "ABSENT" => "#fff",
                                    _ => "var(--clr-text-muted)"
                                };

                                <div class="ss-roster-item" style="--i: @__fi">
                                    <div class="ss-avatar" style="background:@avatarBg;color:@avatarText;">
                                        @s.FullName[..1].ToUpper()
                                    </div>
                                    <div class="ss-student-info">
                                        <div class="ss-student-name">@s.FullName</div>
                                        <div class="ss-student-id">@s.StudentNumber</div>
                                    </div>
                                    @if (s.Status is not null)
                                    {
                                        var badgeBg = s.Status == "PRESENT" ? "rgba(34,197,94,0.15)" : s.Status == "LATE" ? "rgba(234,179,8,0.15)" : "rgba(239,68,68,0.15)";
                                        var badgeText = s.Status == "PRESENT" ? "#4ade80" : s.Status == "LATE" ? "#facc15" : "#f87171";
                                        var badgeTime = s.ScannedAt.HasValue ? s.ScannedAt.Value.ToString("h:mm tt") : "";
                                        <span class="ss-badge ss-badge-@s.Status.ToLower()" @onclick="() => UndoMarkAsync(s.StudentId)" title="Click to undo">
                                            @s.Status @badgeTime
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="ss-mark-btn" @onclick="() => MarkStudentAsync(s.StudentId)"
                                                disabled="@_saving" title="Mark Present">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="ss-roster-footer">
                        <span>@_filteredStudents.Count visible</span>
                        <span>@_students.Count(s => s.Status is not null) / @_students.Count marked</span>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Scanner Overlay Modal ── *@
    @if (_sessionId == 0 && _showScanner)
    {
        <div class="ss-modal-overlay">
            <div class="ss-modal-card">
                <div class="ss-modal-video">
                    <div id="qr-reader" style="width:100%;height:100%;"></div>
                    <style>
                        #qr-reader video { width: 100% !important; height: 100% !important; object-fit: cover !important; }
                        #qr-reader img { display: none; }
                    </style>
                    @if (!string.IsNullOrEmpty(_cameraError))
                    {
                        <div class="ss-modal-video-overlay">
                            <p class="ss-modal-error-text">@_cameraError</p>
                            <p class="ss-modal-error-hint">Enter token manually below</p>
                        </div>
                    }
                    else if (!_cameraStarted)
                    {
                        <div class="ss-modal-video-overlay">
                            <span class="ss-qr-placeholder-icon">◻</span>
                        </div>
                    }
                </div>
                <div class="ss-modal-body">
                    <p class="ss-modal-body-text">
                        @(_sessionId > 0 ? "Scan a student QR to mark attendance" : "Scan a room QR to start a session")
                        <span class="ss-modal-body-hint">or type it below</span>
                    </p>
                    <div class="ss-modal-input-row">
                        <input id="qrInput" class="ss-modal-input"
                               placeholder="Paste or type QR token..."
                               @bind="_qrInput" @bind:event="oninput" />
                        <button class="btn btn-primary" @onclick="ProcessQrInput" disabled="@_saving">Go</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_qrFeedback))
                    {
                        <p class="ss-modal-feedback" style="color:@(_qrFeedback.Contains("✓") || _qrFeedback.Contains("marked") ? "#22c55e" : "#ef4444");">@_qrFeedback</p>
                    }
                </div>
            </div>
            <button class="btn ss-modal-cancel" @onclick="CloseScanner">Cancel</button>
        </div>
    }
</div>

@* ── Page Styles ── *@
<style>
    /* ── Page Container ── */
    .ss-page { height:calc(100vh - 64px); display:flex; flex-direction:column; overflow:hidden; background:var(--clr-bg); animation:_fadeIn 0.3s ease; }

    /* ── Top Bar ── */
    .ss-topbar {
        display:flex; align-items:center; gap:12px; padding:10px 24px;
        background:var(--clr-surface); border-bottom:1px solid var(--clr-border);
        flex-shrink:0;
    }
    .ss-live-badge {
        display:flex; align-items:center; gap:7px; padding:4px 12px 4px 10px;
        border-radius:20px; background:rgba(34,197,94,0.12);
    }
    .ss-live-dot {
        width:7px; height:7px; border-radius:50%; background:#4ade80;
        animation:_pulse 2s infinite;
    }
    .ss-live-badge + span { font-size:13px; font-weight:600; color:var(--clr-text); }
    .ss-top-sub { font-size:13px; color:var(--clr-text-secondary); }
    .ss-idle-badge {
        display:flex; align-items:center; gap:7px; padding:4px 12px 4px 10px;
        border-radius:20px; background:var(--clr-surface-alt);
    }
    .ss-idle-dot { width:7px; height:7px; border-radius:50%; background:var(--clr-text-muted); }
    .ss-idle-badge + span { font-size:12px; font-weight:600; color:var(--clr-text-muted); text-transform:uppercase; letter-spacing:0.5px; }
    .ss-event-count {
        font-size:12px; color:var(--clr-text-muted); font-weight:500;
        padding:2px 8px; background:var(--clr-surface-alt); border-radius:4px;
    }

    /* ── Loading State ── */
    .ss-loading { flex:1; display:flex; align-items:center; justify-content:center; padding:32px; }
    .ss-loading-inner { max-width:540px; width:100%; }
    .ss-loading-title { font-size:20px; font-weight:700; color:var(--clr-text); text-align:center; margin-bottom:6px; }
    .ss-loading-sub { font-size:13px; color:var(--clr-text-secondary); text-align:center; margin-bottom:24px; }
    .ss-skeleton-list { display:flex; flex-direction:column; gap:12px; }
    .ss-skeleton-card {
        padding:16px 20px; border:1px solid var(--clr-border); border-radius:10px;
        background:var(--clr-surface);
    }
    .ss-skeleton-row { display:flex; align-items:center; justify-content:space-between; width:100%; }
    .ss-skeleton-line {
        background:linear-gradient(90deg,rgba(128,128,128,0.06) 25%,rgba(128,128,128,0.12) 50%,rgba(128,128,128,0.06) 75%);
        background-size:200% 100%; animation:_shimmer 1.5s infinite; border-radius:4px;
    }

    /* ── Error State ── */
    .ss-error { flex:1; display:flex; align-items:center; justify-content:center; padding:32px; }
    .ss-error-inner { max-width:400px; width:100%; text-align:center; }

    /* ── Main Layout ── */
    .ss-main { flex:1; display:flex; overflow:hidden; }

    /* ── Viewfinder ── */
    .ss-viewfinder {
        flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
        padding:32px; position:relative; min-width:0;
    }

    /* ── Placeholder Card ── */
    .ss-placeholder-card {
        width:320px; padding:40px 32px;
        display:flex; flex-direction:column; align-items:center; gap:16px;
        background:var(--clr-surface); border:1px solid var(--clr-border);
        border-radius:16px; box-shadow:var(--shadow-card);
        animation:_fadeUp 0.45s ease;
    }
    .ss-placeholder-icon {
        width:72px; height:72px; border-radius:16px;
        background:var(--clr-accent-bg); display:flex; align-items:center; justify-content:center;
    }
    .ss-placeholder-text { font-size:14px; font-weight:600; color:var(--clr-text); text-align:center; margin:0; }
    .ss-placeholder-hint { font-size:12px; color:var(--clr-text-muted); text-align:center; margin:0; }

    /* ── Scanner (in-page, session active) ── */
    .ss-scanner-card { width:320px; max-width:100%; animation:_fadeUp 0.35s ease; }
    .ss-scanner-video {
        width:100%; height:240px; border-radius:12px; overflow:hidden;
        background:#000; position:relative;
    }
    .ss-scanner-overlay {
        position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    }
    .ss-scanner-error-text { color:rgba(255,255,255,0.5); font-size:13px; text-align:center; padding:0 16px; }
    .ss-qr-placeholder-icon { font-size:42px; color:rgba(255,255,255,0.12); }
    .ss-scanner-input-row { display:flex; gap:8px; margin-top:10px; animation:_slideDown 0.25s ease; }
    .ss-scanner-input {
        flex:1; padding:9px 12px; border:1px solid var(--clr-border); border-radius:8px;
        font-size:13px; text-align:center; outline:none;
        background:var(--clr-surface); color:var(--clr-text);
    }
    .ss-scanner-input:focus { border-color:var(--clr-accent); box-shadow:0 0 0 3px var(--clr-accent-bg); }
    .ss-scanner-feedback { text-align:center; margin-top:6px; font-size:13px; }
    .ss-stop-btn {
        margin-top:14px; background:var(--clr-surface); color:var(--clr-text-secondary);
        border-color:var(--clr-border); position:relative; z-index:9999; pointer-events:auto;
    }

    /* ── Divider ── */
    .ss-divider {
        display:flex; align-items:center; gap:16px; margin-top:32px; width:380px;
        animation:_fadeIn 0.5s ease 0.15s both;
    }
    .ss-divider-line { flex:1; height:1px; background:linear-gradient(90deg,transparent,var(--clr-border),transparent); }
    .ss-divider-text {
        font-size:11px; color:var(--clr-text-muted); font-weight:600;
        text-transform:uppercase; letter-spacing:1.5px; flex-shrink:0;
    }

    /* ── Section Picker ── */
    .ss-section-area { margin-top:24px; text-align:center; width:100%; max-width:460px; animation:_fadeUp 0.45s ease 0.1s both; }
    .ss-section-label { font-size:13px; color:var(--clr-text-secondary); margin-bottom:14px; }
    .ss-empty-sections {
        display:flex; flex-direction:column; align-items:center; gap:10px;
        padding:24px; color:var(--clr-text-muted); font-size:13px;
    }
    .ss-empty-sections p { margin:0; }
    .ss-section-picker { display:flex; gap:10px; width:100%; position:relative; }
    .ss-select-trigger {
        flex:1; padding:10px 14px;
        border:1px solid var(--clr-border-strong); border-radius:10px;
        font-size:13px; color:var(--clr-text); background:var(--clr-surface);
        outline:none; cursor:pointer; display:flex; align-items:center;
        justify-content:space-between; user-select:none; gap:8px;
        transition:border-color .15s, box-shadow .15s;
    }
    .ss-select-trigger:hover { border-color:var(--clr-accent); }
