    .ss-roster-search:focus-within { border-color:var(--clr-accent); }
    .ss-roster-search input {
        flex:1; border:none; outline:none; background:transparent;
        font-size:13px; color:var(--clr-text);
    }
    .ss-roster-search input::placeholder { color:var(--clr-text-muted); }
    .ss-roster-body { flex:1; overflow-y:auto; }
    .ss-roster-empty {
        display:flex; flex-direction:column; align-items:center; gap:10px;
