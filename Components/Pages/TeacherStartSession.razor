    .ss-roster-empty p { margin:0; }
    .ss-roster-item {
        display:flex; align-items:center; gap:10px; padding:10px 16px;
        border-bottom:1px solid var(--clr-border); transition:background .12s;
        animation:_fadeUp 0.3s ease both;
        animation-delay:calc(var(--i,0) * 25ms);
    }
    .ss-roster-item:hover { background:var(--clr-surface-alt); }
    .ss-avatar {
        width:32px; height:32px; border-radius:50%;
        display:flex; align-items:center; justify-content:center;
        font-size:12px; font-weight:600; flex-shrink:0;
    }
    .ss-student-info { flex:1; min-width:0; }
    .ss-student-name { font-size:13px; font-weight:500; color:var(--clr-text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .ss-student-id { font-size:11px; color:var(--clr-text-muted); }
    .ss-badge {
        font-size:11px; font-weight:600; padding:3px 8px; border-radius:5px;
        cursor:pointer; transition:opacity .15s; white-space:nowrap;
        animation:_popIn 0.35s cubic-bezier(0.34,1.56,0.64,1);
    }
    .ss-badge:hover { opacity:0.8; }
    .ss-badge-present { background:rgba(34,197,94,0.15); color:#4ade80; }
    .ss-badge-late { background:rgba(234,179,8,0.15); color:#facc15; }
    .ss-badge-absent { background:rgba(239,68,68,0.15); color:#f87171; }
    .ss-mark-btn {
        border:2px dashed var(--clr-border-strong); border-radius:50%; width:32px; height:32px;
        padding:0; display:flex; align-items:center; justify-content:center;
        color:var(--clr-text-muted); cursor:pointer; background:transparent;
        transition:border-color .2s, color .2s, background .2s, transform .15s cubic-bezier(0.34,1.56,0.64,1);
    }
    .ss-mark-btn:hover:not(:disabled) { border-color:var(--clr-accent); color:var(--clr-accent); background:var(--clr-accent-bg); transform:scale(1.15); }
    .ss-mark-btn:active:not(:disabled) { transform:scale(0.85); }
    .ss-mark-btn:disabled { opacity:0.4; cursor:default; }
    .ss-roster-footer {
        padding:10px 16px; border-top:1px solid var(--clr-border);
        font-size:11px; color:var(--clr-text-muted); display:flex; justify-content:space-between;
    }

    /* ── Overlay Modal ── */
    .ss-modal-overlay {
        position:fixed; inset:0; background:rgba(0,0,0,0.8);
        z-index:2000; display:flex; flex-direction:column;
        align-items:center; justify-content:center; gap:20px;
        backdrop-filter:blur(4px);
        animation:_fadeIn 0.2s ease;
    }
    .ss-modal-card {
        width:340px; background:var(--clr-surface); border-radius:16px;
        overflow:hidden; box-shadow:var(--shadow-modal);
        animation:_scaleIn 0.3s ease;
    }
    .ss-modal-video {
        width:100%; height:240px; background:#000; position:relative;
    }
    .ss-modal-video-overlay {
        position:absolute; inset:0; display:flex; flex-direction:column;
        align-items:center; justify-content:center; gap:6px;
    }
    .ss-modal-error-text { color:rgba(255,255,255,0.5); font-size:13px; text-align:center; padding:0 16px; margin:0; }
    .ss-modal-error-hint { color:rgba(255,255,255,0.25); font-size:12px; margin:0; }
    .ss-modal-body { padding:16px; }
    .ss-modal-body-text {
        color:var(--clr-text-secondary); font-size:12px; text-align:center; margin:0 0 10px;
    }
    .ss-modal-body-hint { color:var(--clr-text-muted); }
    .ss-modal-input-row { display:flex; gap:8px; }
    .ss-modal-input {
        flex:1; padding:10px 14px; border:1px solid var(--clr-border); border-radius:8px;
        font-size:13px; text-align:center; outline:none; background:var(--clr-surface-alt);
        color:var(--clr-text); transition:border-color .15s;
    }
    .ss-modal-input:focus { border-color:var(--clr-accent); }
    .ss-modal-feedback { text-align:center; margin-top:8px; font-size:13px; }
    .ss-modal-cancel {
        background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.65);
        border-color:rgba(255,255,255,0.12); padding:8px 36px;
        position:relative; z-index:9999; pointer-events:auto;
        animation:_fadeUp 0.3s ease 0.1s both;
    }

    /* ── Keyframe Animations ── */
    @@keyframes _pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    @@keyframes _slideUp {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes _shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
    @@keyframes _fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes _fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes _scaleIn {
        from { opacity: 0; transform: scale(0.92); }
        to { opacity: 1; transform: scale(1); }
    }
    @@keyframes _slideInRight {
        from { transform: translateX(100%); }
        to { transform: translateX(0); }
    }
    @@keyframes _popIn {
        0% { opacity: 0; transform: scale(0.5); }
        70% { transform: scale(1.1); }
        100% { opacity: 1; transform: scale(1); }
    }
    @@keyframes _slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ── Accessibility: Reduce motion ── */
    @@media (prefers-reduced-motion: reduce) {
        .ss-page, .ss-placeholder-card, .ss-scanner-card, .ss-roster,
        .ss-roster-item, .ss-badge, .ss-modal-overlay, .ss-modal-card,
        .ss-modal-cancel, .ss-dropdown, .ss-divider, .ss-section-area,
        .ss-scanner-input-row,
        .ss-notification, .ss-skeleton-line { animation: none !important; }
        .ss-mark-btn { transform: none !important; }
        .ss-live-dot { animation: none !important; }
    }
</style>

@code {
    private enum QrScanMode { Room, Student }

    private const string StatusPresent = "PRESENT";
    private const string StatusLate = "LATE";
    private const string StatusAbsent = "ABSENT";

    private List<SectionSelectItem> _sections = [];
    private long _selectedOfferingId;
    private string _selectedSectionText = "";
    private bool _showDropdown;
    private bool _dropUp;
    private ElementReference _triggerRef;
    private List<RosterStudentItem> _students = [];
    private List<RosterStudentItem> _filteredStudents => string.IsNullOrWhiteSpace(_rosterSearch)
        ? _students
        : _students.Where(s =>
            s.FullName.Contains(_rosterSearch, StringComparison.OrdinalIgnoreCase) ||
            s.StudentNumber.Contains(_rosterSearch, StringComparison.OrdinalIgnoreCase) ||
            s.Lrn.Contains(_rosterSearch, StringComparison.OrdinalIgnoreCase)).ToList();

    private ActiveSessionState? _sessionState;
    private long _sessionId;
    private long _teacherId;
    private long _userId;
    private string _rosterSearch = "";
    private string _qrInput = "";
    private string? _qrFeedback;
    private QrScanMode _scanMode = QrScanMode.Student;
    private bool _showScanner;
    private bool _cameraStarted;
    private string? _cameraError;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private int _syncQueue;
    private DotNetObjectReference<TeacherStartSession>? _dotNetRef;

    private readonly List<NotificationCard> _notifications = [];
    private readonly CancellationTokenSource _cts = new();

    private sealed record NotificationCard(string Text, string Type, Guid Id = default)
    {
        public Guid Id { get; init; } = Id == default ? Guid.NewGuid() : Id;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var sessionTask = AuthService.GetCurrentSessionAsync();
            var timeoutTask = Task.Delay(TimeSpan.FromSeconds(20));

            var completed = await Task.WhenAny(sessionTask, timeoutTask);
            if (completed == timeoutTask)
            {
                _error = "Connection timed out. Please check your connection and try again.";
                return;
            }

            var session = await sessionTask;
            if (session is null) { Navigation.NavigateTo("/login"); return; }

            _userId = session.UserId;

            var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
            if (teacher is null) { _error = "Teacher profile not found."; return; }

            _teacherId = teacher.Id;
            _sections = await SessionService.GetTeacherSectionsAsync(teacher.Id, _cts.Token);
            await RefreshActiveSessionAsync();
        }
        catch (OperationCanceledException)
        {
            _error = "Request was cancelled.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RefreshActiveSessionAsync()
    {
        var state = await SessionService.GetActiveSessionForTeacherAsync(_teacherId, _cts.Token);
        if (state is not null)
        {
            _sessionId = state.SessionId;
            _sessionState = state;
        }
    }

    private async Task ToggleDropdown()
    {
        if (!_showDropdown)
        {
            try
            {
                var spaceBelow = await JS.InvokeAsync<double>("__dropdownSpaceBelow", _triggerRef);
                _dropUp = spaceBelow < 200;
            }
            catch { _dropUp = false; }
        }
        _showDropdown = !_showDropdown;
    }

    private void CloseDropdown() => _showDropdown = false;

    private async Task SelectSection(SectionSelectItem sec)
    {
        _selectedOfferingId = sec.OfferingId ?? 0;
        _selectedSectionText = string.IsNullOrEmpty(sec.TimeDisplay)
            ? $"{sec.SectionName} — {sec.Subject}"
            : $"{sec.SectionName} — {sec.Subject} ({sec.TimeDisplay})";
        _showDropdown = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartFromDropdown()
    {
        _showDropdown = false;
        _saving = true;
        try
        {
            _notifications.Clear();
            if (_selectedOfferingId == 0)
            {
                _notifications.Add(new NotificationCard("Choose a section first.", "error"));
                return;
            }
            var state = await SessionService.StartManualSessionAsync(_teacherId, _userId, _selectedOfferingId, _cts.Token);
            var roster = await SessionService.GetRosterAsync(state.SessionId, _cts.Token);
            _sessionId = state.SessionId;
            _sessionState = state;
            _students = roster;
            _ = PollLiveScansAsync();
        }
        catch (Exception ex)
        {
            _notifications.Add(new NotificationCard(ex.Message, "error"));
        }
        finally { _saving = false; }
    }

    private async Task MarkStudentAsync(long studentId)
    {
        _saving = true;
        try
        {
            var result = await SessionService.MarkAttendanceAsync(_sessionId, _userId, studentId, _cts.Token);
            if (result.Success)
            {
                var s = _students.First(x => x.StudentId == studentId);
                s.Status = result.Status ?? StatusPresent;
                s.ScannedAt = DateTime.Now;
                _notifications.Add(new NotificationCard(result.Message, result.Status == "LATE" ? "late" : "present"));
                _sessionState = await SessionService.GetActiveSessionAsync(_sessionId, _cts.Token);
                if (_notifications.Count > 5) _notifications.RemoveAt(0);
                _ = AutoDismissNotification();
            }
            else
            {
                _notifications.Add(new NotificationCard(result.Message, "error"));
            }
        }
        finally { _saving = false; }
    }

    private async Task UndoMarkAsync(long studentId)
    {
        _saving = true;
        try
        {
            var result = await SessionService.UndoAttendanceAsync(_sessionId, _userId, studentId, _cts.Token);
            if (result.Success)
            {
                var s = _students.First(x => x.StudentId == studentId);
                s.Status = null;
                s.ScannedAt = null;
                _sessionState = await SessionService.GetActiveSessionAsync(_sessionId, _cts.Token);
            }
        }
        finally { _saving = false; }
    }

    private async Task EndSessionAsync()
    {
        _saving = true;
        try
        {
            await SessionService.EndSessionAsync(_sessionId, userId: _userId, cancellationToken: CancellationToken.None);
            _sessionId = 0;
            _sessionState = null;
            _students = [];
            _notifications.Clear();
            _qrInput = "";
            _qrFeedback = null;
            try { await CloseScanner(); } catch { }
            try { await LoadDataAsync(); } catch { }
        }
        finally
        {
            _saving = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ProcessQrInput()
    {
        var input = _qrInput?.Trim();
        if (string.IsNullOrEmpty(input))
        {
            _qrFeedback = "Please enter a QR token.";
            return;
        }

        _saving = true;
        try
        {
            if (_scanMode == QrScanMode.Room)
            {
                var result = await SessionService.ScanRoomQrAsync(_teacherId, _userId, input, null, _cts.Token);
                _qrFeedback = result.Message;
                if (result.Success)
                {
                    _showScanner = false;
                    _qrInput = "";
                    _qrFeedback = null;
                    var state = await SessionService.GetActiveSessionForTeacherAsync(_teacherId, _cts.Token);
                    if (state is not null)
                    {
                        var roster = await SessionService.GetRosterAsync(state.SessionId, _cts.Token);
                        _sessionId = state.SessionId;
                        _sessionState = state;
                        _students = roster;
                        _ = PollLiveScansAsync();
                    }
                }
            }
            else
            {
                if (_sessionId == 0)
                {
                    _qrFeedback = "Start a session first before scanning student QR codes.";
                    return;
                }

                var result = await SessionService.ScanStudentQrAsync(_sessionId, _userId, input, _cts.Token);
                _qrFeedback = result.Message;
                    if (result.Success)
                    {
                        if (result.StudentId.HasValue)
                        {
                            var s = _students.FirstOrDefault(x => x.StudentId == result.StudentId.Value);
                            if (s is not null)
                            {
                                s.Status = result.Status ?? StatusPresent;
                                s.ScannedAt = DateTime.Now;
                            }
                        }
                        _sessionState = await SessionService.GetActiveSessionAsync(_sessionId, _cts.Token);
                        _qrInput = "";
                        _qrFeedback = null;
                        _notifications.Add(new NotificationCard(result.Message, result.Status == "LATE" ? "late" : "present"));
                        _ = AutoDismissNotification();
                        if (_sessionId == 0)
                        {
                            _showScanner = false;
                        }
                    }
            }
        }
        finally { _saving = false; }
    }

    private string QrButtonStyle(QrScanMode mode)
    {
        if (_scanMode == mode)
            return "background:var(--clr-accent);color:#fff;border-color:var(--clr-accent);";
        return "background:var(--clr-surface-alt);color:var(--clr-text-secondary);border-color:var(--clr-border);";
    }

    private void SwitchScanModeRoom()
    {
        _scanMode = QrScanMode.Room;
        _qrInput = "";
        _qrFeedback = null;
    }

    private void SwitchScanModeStudent()
    {
        _scanMode = QrScanMode.Student;
        _qrInput = "";
        _qrFeedback = null;
    }

    private async Task OpenScanner()
    {
        _showScanner = true;
        _scanMode = _sessionId > 0 ? QrScanMode.Student : QrScanMode.Room;
        _qrInput = "";
        _qrFeedback = null;
        _cameraError = null;
        _cameraStarted = false;
        _dotNetRef = DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync("qrScanner.start", _dotNetRef, "qr-reader");
            _cameraStarted = true;
        }
        catch
        {
            _cameraError = "Camera not available";
        }
        StateHasChanged();
    }

    private async Task CloseScanner()
    {
        await JS.InvokeVoidAsync("qrScanner.stop");
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        _cameraStarted = false;
        _cameraError = null;
        _showScanner = false;
        _qrInput = "";
        _qrFeedback = null;
    }

    [JSInvokable]
    public async Task OnQrCodeScanned(string decodedText)
    {
        _qrInput = decodedText;
        await ProcessQrInput();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnScannerError(string message)
    {
        _cameraError = message;
        _cameraStarted = false;
        InvokeAsync(StateHasChanged);
    }

    private void DismissNotification(NotificationCard n) => _notifications.Remove(n);

    private async Task AutoDismissNotification()
    {
        await Task.Delay(10000);
        if (_notifications.Count > 0) _notifications.RemoveAt(0);
        await InvokeAsync(StateHasChanged);
    }

    private async Task PollLiveScansAsync()
    {
        while (_sessionId > 0 && !_cts.Token.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(15000, _cts.Token);
                if (_sessionId > 0)
                {
                    _sessionState = await SessionService.GetActiveSessionAsync(_sessionId, _cts.Token);
                    var events = await SessionService.GetLiveScansAsync(_sessionId, _cts.Token);
                    _syncQueue = events.Count;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { break; }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("qrScanner.stop"); } catch { }
        _dotNetRef?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}
