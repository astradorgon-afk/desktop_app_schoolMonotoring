@page "/students"
@layout MainLayout
@using AttendanceUI.Models
@using AttendanceUI.Services
@inject IStudentService StudentService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageHeader Title="Students" Subtitle="Manage student records, view profiles, and QR codes">
    <div class="header-actions">
        <div class="search-box">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="Search students..." @bind="searchTerm" @bind:after="ApplyFilter" />
        </div>
        <span class="record-count">@filteredStudents.Count student(s)</span>

        @if (selectedIds.Count > 0)
        {
            <button class="btn btn-primary" @onclick="SaveSelected">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Save Selected (@selectedIds.Count)
            </button>
            <button class="btn btn-outline" @onclick="PrintSelected">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                Print Selected (@selectedIds.Count)
            </button>
            <button class="btn btn-outline" @onclick="ClearSelection">
                Clear
            </button>
        }
    </div>
</PageHeader>

@if (isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <span>Loading students...</span>
    </div>
}
else if (errorMessage is not null)
{
    <div class="error-banner">
        <span>@errorMessage</span>
    </div>
}
else
{
    <div class="page-card @(isPrinting ? "hidden-print" : "")">
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-check">
                            <input type="checkbox"
                                   checked="@isAllSelected"
                                   @onchange="ToggleSelectAll"
                                   class="cb-all" />
                        </th>
                        <th>Student #</th>
                        <th>LRN</th>
                        <th>Full Name</th>
                        <th>Sex</th>
                        <th>Age</th>
                        <th>Contact</th>
                        <th>Guardian</th>
                        <th>QR Code</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in filteredStudents)
                    {
                        <tr class="@(selectedIds.Contains(student.Id) ? "row-selected" : "")">
                            <td>
                                <input type="checkbox"
                                       checked="@selectedIds.Contains(student.Id)"
                                       @onchange="() => ToggleSelect(student.Id)" />
                            </td>
                            <td><span class="badge badge-info">@student.StudentNumber</span></td>
                            <td class="font-mono">@student.Lrn</td>
                            <td>
                                <div class="name-cell">
                                    <div class="avatar">@student.FirstName[0]@student.LastName[0]</div>
                                    <div>
                                        <div class="name-primary">@student.FullName</div>
                                        <div class="name-secondary">@(student.MiddleName ?? "")</div>
                                    </div>
                                </div>
                            </td>
                            <td>@student.Sex</td>
                            <td>@student.Age</td>
                            <td>
                                <div class="contact-cell">
                                    <span>@(student.ContactNo ?? "—")</span>
                                    <span class="text-muted small">@(student.Address ?? "")</span>
                                </div>
                            </td>
                            <td>
                                <div class="contact-cell">
                                    <span>@(student.GuardianName ?? "—")</span>
                                    <span class="text-muted small">@(student.GuardianContact ?? "")</span>
                                </div>
                            </td>
                            <td>
                                <div class="qr-cell">
                                    @if (student.QrCodeBase64 is not null)
                                    {
                                        <img src="data:image/png;base64,@student.QrCodeBase64"
                                             alt="QR for @student.FullName"
                                             class="qr-thumb"
                                             @onclick="() => ShowQrModal(student)" />
                                    }
                                    else
                                    {
                                        <span class="qr-generating">Generating...</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (filteredStudents.Count == 0)
        {
            <div class="empty-state">
                <p>No students found.</p>
            </div>
        }
    </div>
}

<div class="print-section @(isPrinting ? "print-visible" : "")">
    <div class="print-grid">
        @foreach (var item in printItems)
        {
            <div class="print-label">
                <img src="data:image/png;base64,@item.QrCodeBase64" alt="QR" />
                <div class="print-name">@item.FullName</div>
                <div class="print-lrn">@item.Lrn</div>
            </div>
        }
    </div>
</div>

@if (selectedStudent is not null)
{
    <div class="modal-overlay" @onclick="CloseQrModal">
        <div class="modal-content qr-modal" @onclick:stopPropagation>
            <button class="modal-close" @onclick="CloseQrModal">&times;</button>
            <h3>@selectedStudent.FullName</h3>
            <p class="text-muted">@selectedStudent.Lrn — @selectedStudent.StudentNumber</p>

            @if (selectedStudent.QrCodeBase64 is not null)
            {
                <div class="qr-large-wrapper">
                    <img src="data:image/png;base64,@selectedStudent.QrCodeBase64"
                         alt="QR Code for @selectedStudent.FullName"
                         class="qr-large" />
                </div>
                <p class="qr-hint">Scan this QR code to record attendance</p>

                <div class="qr-modal-actions">
                    <button class="btn btn-primary" @onclick="() => DownloadSingleQr(selectedStudent)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Save as PNG
                    </button>
                    <button class="btn btn-outline" @onclick="() => PrintSingleQr(selectedStudent)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                        Print
                    </button>
                </div>
            }

            <div class="modal-details">
                <div class="detail-row">
                    <span class="detail-label">Gender</span>
                    <span class="detail-value">@(selectedStudent.Sex ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Age</span>
                    <span class="detail-value">@(selectedStudent.Age?.ToString() ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Contact</span>
                    <span class="detail-value">@(selectedStudent.ContactNo ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Address</span>
                    <span class="detail-value">@(selectedStudent.Address ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Guardian</span>
                    <span class="detail-value">@(selectedStudent.GuardianName ?? "—")</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Guardian Contact</span>
                    <span class="detail-value">@(selectedStudent.GuardianContact ?? "—")</span>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StudentListItem> allStudents = [];
    private List<StudentListItem> filteredStudents = [];
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool isGenerating;
    private string? errorMessage;
    private StudentListItem? selectedStudent;
    private HashSet<long> selectedIds = [];
    private bool isPrinting;
    private List<PrintItem> printItems = [];

    private bool isAllSelected =>
        filteredStudents.Count > 0 && filteredStudents.All(s => selectedIds.Contains(s.Id));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allStudents = await StudentService.GetAllAsync();
            filteredStudents = [.. allStudents];

            var missingQr = allStudents.Where(s => !s.HasQrCode).ToList();
            if (missingQr.Count > 0)
            {
                isGenerating = true;
                _ = GenerateMissingQrCodesAsync(missingQr);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load students: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GenerateMissingQrCodesAsync(List<StudentListItem> missing)
    {
        foreach (var student in missing)
        {
            try
            {
                var base64 = await StudentService.EnsureQrCodeAsync(student.Id);
                student.QrCodeBase64 = base64;
                student.HasQrCode = true;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                var inner = ex.InnerException?.Message ?? ex.Message;
                errorMessage = $"Failed to generate QR for {student.FullName}: {inner}";
            }
        }

        isGenerating = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredStudents = [.. allStudents];
            return;
        }

        var term = searchTerm.Trim().ToLowerInvariant();
        filteredStudents = allStudents
            .Where(s =>
                s.FullName.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.Lrn.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                s.StudentNumber.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (s.ContactNo?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();
    }

    private void ToggleSelect(long id)
    {
        if (!selectedIds.Remove(id))
            selectedIds.Add(id);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        if ((bool)(e.Value ?? false))
            selectedIds = [.. filteredStudents.Select(s => s.Id)];
        else
            selectedIds.Clear();
    }

    private void ClearSelection()
    {
        selectedIds.Clear();
    }

    private void ShowQrModal(StudentListItem student)
    {
        selectedStudent = student;
    }

    private void CloseQrModal()
    {
        selectedStudent = null;
    }

    private async Task DownloadSingleQr(StudentListItem student)
    {
        if (student.QrCodeBase64 is null) return;
        await JS.InvokeVoidAsync("downloadQrPng", student.QrCodeBase64, student.FullName);
    }

    private async Task PrintSingleQr(StudentListItem student)
    {
        if (student.QrCodeBase64 is null) return;
        await StartPrint([student]);
    }

    private async Task SaveSelected()
    {
        var selected = allStudents
            .Where(s => selectedIds.Contains(s.Id) && s.QrCodeBase64 is not null)
            .ToList();

        if (selected.Count == 0) return;

        foreach (var student in selected)
        {
            await DownloadSingleQr(student);
            await Task.Delay(200);
        }
    }

    private async Task PrintSelected()
    {
        var selected = allStudents
            .Where(s => selectedIds.Contains(s.Id) && s.QrCodeBase64 is not null)
            .ToList();

        if (selected.Count == 0) return;

        await StartPrint(selected);
    }

    private async Task StartPrint(List<StudentListItem> items)
    {
        printItems = items.Select(s => new PrintItem
        {
            QrCodeBase64 = s.QrCodeBase64!,
            FullName = s.FullName,
            Lrn = s.Lrn
        }).ToList();

        isPrinting = true;
        StateHasChanged();

        await Task.Delay(100);
        await JS.InvokeVoidAsync("triggerPrint");
    }

    private class PrintItem
    {
        public string QrCodeBase64 { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Lrn { get; set; } = string.Empty;
    }
}
