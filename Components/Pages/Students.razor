@page "/students"
@layout MainLayout
@using AttendanceUI.Data.Entities
@inject IStudentService StudentService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<PageHeader Title="Students" Subtitle="Manage student records and QR codes">
    <div class="header-actions">
        @if (_selectedIds.Count > 0)
        {
            <button class="action-btn action-btn--purple" @onclick="PrintSelected">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                <span>Print Selected (@_selectedIds.Count)</span>
            </button>
            <button class="action-btn action-btn--green" @onclick="DownloadSelected">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span>Save as PNG (@_selectedIds.Count)</span>
            </button>
        }
        <span class="header-date">@DateTime.Now.ToString("MMM dd, yyyy")</span>
    </div>
</PageHeader>

@if (_isLoading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>@(!_isGenerating ? "Loading students..." : $"Generating QR codes for {_generatingCount} students...")</p>
    </div>
}
else if (_error is not null)
{
    <div class="error-banner" style="margin: 0 32px 24px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
    </div>
}
else
{
    <div class="students-toolbar">
        <div class="search-wrapper">
            <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" class="search-input" placeholder="Search by name, LRN, or student number..." @bind="_searchTerm" @bind:after="ApplyFilter" />
        </div>
        <select class="filter-select" @bind="_statusFilter" @bind:after="ApplyFilter">
            <option value="">All Status</option>
            <option value="ACTIVE">Active</option>
            <option value="INACTIVE">Inactive</option>
            <option value="LOCKED">Locked</option>
        </select>
    </div>

    <div class="students-table-wrapper">
        <table class="students-table">
            <thead>
                <tr>
                    <th class="col-check">
                        <input type="checkbox" class="select-checkbox" checked="@_allSelected" @onchange="ToggleSelectAll" />
                    </th>
                    <th>Student</th>
                    <th>LRN</th>
                    <th>Student No.</th>
                    <th>Status</th>
                    <th>QR Code</th>
                </tr>
            </thead>
            <tbody>
                @if (_filteredStudents.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-state">No students found matching your filters.</td>
                    </tr>
                }
                else
                {
                    @foreach (var student in _filteredStudents)
                    {
                        <tr class="@(_selectedIds.Contains(student.Id) ? "row-selected" : "")">
                            <td class="col-check">
                                <input type="checkbox" class="select-checkbox" checked="@_selectedIds.Contains(student.Id)" @onchange="() => ToggleSelect(student.Id)" />
                            </td>
                            <td>
                                <div class="student-info-cell" @onclick="() => ShowProfileModal(student)" style="cursor:pointer;">
                                    <div class="student-avatar">
                                        @student.FirstName[0]@student.LastName[0]
                                    </div>
                                    <div>
                                        <div class="student-name">@student.FullName</div>
                                        <div class="student-meta">@(student.Age.HasValue ? $"{student.Age} yrs" : "")@(student.Age.HasValue && student.Sex is not null ? " | " : "")@student.Sex</div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="code-badge">@student.Lrn</span></td>
                            <td><span class="code-badge code-badge--alt">@student.StudentNumber</span></td>
                            <td>
                                <span class="status-badge status-badge--@student.Status.ToLowerInvariant()">
                                    @student.Status
                                </span>
                            </td>
                            <td class="col-qr">
                                @if (student.QrCode is not null)
                                {
                                    <img src="data:image/png;base64,@Convert.ToBase64String(student.QrCode.QrCode)" alt="QR Code for @student.FullName" class="qr-thumb" @onclick="() => ShowProfileModal(student)" />
                                }
                                else
                                {
                                    <span class="text-muted">No QR code</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@if (_profileStudent is not null)
{
    <div class="modal-overlay" @onclick="CloseProfileModal">
        <div class="modal-content modal-content--wide" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>Student Profile</h3>
                <button class="modal-close" @onclick="CloseProfileModal">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="modal-body">
                <div class="profile-layout">
                    <div class="profile-info">
                        <div class="profile-header">
                            <div class="profile-avatar-large">
                                @_profileStudent.FirstName[0]@_profileStudent.LastName[0]
                            </div>
                            <div>
                                <div class="profile-name">@_profileStudent.FullName</div>
                                <div class="profile-badge-row">
                                    <span class="code-badge">@_profileStudent.Lrn</span>
                                    <span class="code-badge code-badge--alt">@_profileStudent.StudentNumber</span>
                                    <span class="status-badge status-badge--@_profileStudent.Status.ToLowerInvariant()">@_profileStudent.Status</span>
                                </div>
                            </div>
                        </div>

                        <div class="profile-details">
                            <div class="profile-section-title">Personal Information</div>
                            <div class="profile-grid">
                                <div class="profile-field">
                                    <span class="profile-label">First Name</span>
                                    <span class="profile-value">@_profileStudent.FirstName</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Middle Name</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.MiddleName) ? _profileStudent.MiddleName : "—")</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Last Name</span>
                                    <span class="profile-value">@_profileStudent.LastName</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Birthdate</span>
                                    <span class="profile-value">@(_profileStudent.Birthdate.HasValue ? _profileStudent.Birthdate.Value.ToString("MMM dd, yyyy") : "—")</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Age</span>
                                    <span class="profile-value">@(_profileStudent.Age.HasValue ? $"{_profileStudent.Age} yrs" : "—")</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Sex</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.Sex) ? _profileStudent.Sex : "—")</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Address</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.Address) ? _profileStudent.Address : "—")</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Contact No.</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.ContactNo) ? _profileStudent.ContactNo : "—")</span>
                                </div>
                            </div>

                            <div class="profile-section-title">Guardian Information</div>
                            <div class="profile-grid">
                                <div class="profile-field">
                                    <span class="profile-label">Guardian Name</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.GuardianName) ? _profileStudent.GuardianName : "—")</span>
                                </div>
                                <div class="profile-field">
                                    <span class="profile-label">Guardian Contact</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.GuardianContact) ? _profileStudent.GuardianContact : "—")</span>
                                </div>
                            </div>

                            <div class="profile-section-title">Academic</div>
                            <div class="profile-grid">
                                <div class="profile-field">
                                    <span class="profile-label">Previous School</span>
                                    <span class="profile-value">@(!string.IsNullOrEmpty(_profileStudent.PreviousSchool) ? _profileStudent.PreviousSchool : "—")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="profile-qr">
                        @if (_profileStudent.QrCode is not null)
                        {
                            <div class="profile-qr-card">
                                <div class="profile-qr-label">QR Code</div>
                                <img src="data:image/png;base64,@Convert.ToBase64String(_profileStudent.QrCode.QrCode)" alt="QR Code" class="profile-qr-image" />
                                <div class="profile-qr-content">@_profileStudent.QrCode.QrContent</div>
                                <div class="profile-qr-actions">
                                    <button class="action-btn action-btn--purple" @onclick="() => PrintSingleQr(_profileStudent)" style="flex:1;justify-content:center;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                        Print
                                    </button>
                                    <button class="action-btn action-btn--green" @onclick="() => DownloadSingleQr(_profileStudent)" style="flex:1;justify-content:center;">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        Save as PNG
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="action-btn" @onclick="CloseProfileModal">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Student> _students = [];
    private List<Student> _filteredStudents = [];
    private bool _isLoading = true;
    private bool _isGenerating;
    private int _generatingCount;
    private string? _error;
    private string _searchTerm = "";
    private string _statusFilter = "";
    private HashSet<long> _selectedIds = [];
    private bool _allSelected;
    private Student? _profileStudent;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentsAsync();
    }

    private async Task LoadStudentsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _students = (await StudentService.GetAllAsync(_cts.Token)).ToList();

            var missing = _students.Where(s => s.QrCode is null).ToList();
            if (missing.Count > 0)
            {
                _isGenerating = true;
                _generatingCount = missing.Count;

                foreach (var student in missing)
                {
                    if (_cts.IsCancellationRequested) break;
                    await StudentService.GenerateQrCodeAsync(student.Id, _cts.Token);
                }

                _students = (await StudentService.GetAllAsync(_cts.Token)).ToList();
                _isGenerating = false;
            }

            ApplyFilter();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load students: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ApplyFilter()
    {
        var query = _students.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchTerm))
        {
            var term = _searchTerm.Trim().ToLowerInvariant();
            query = query.Where(s =>
                s.FirstName.ToLowerInvariant().Contains(term) ||
                s.LastName.ToLowerInvariant().Contains(term) ||
                s.Lrn.ToLowerInvariant().Contains(term) ||
                s.StudentNumber.ToLowerInvariant().Contains(term));
        }

        if (!string.IsNullOrEmpty(_statusFilter))
        {
            query = query.Where(s => s.Status == _statusFilter);
        }

        _filteredStudents = query.ToList();
        UpdateSelectAllState();
    }

    private void ToggleSelect(long id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
        UpdateSelectAllState();
    }

    private void ToggleSelectAll()
    {
        if (_allSelected)
        {
            _selectedIds.Clear();
        }
        else
        {
            _selectedIds = [.. _filteredStudents.Select(s => s.Id)];
        }
        UpdateSelectAllState();
    }

    private void UpdateSelectAllState()
    {
        _allSelected = _filteredStudents.Count > 0
            && _filteredStudents.All(s => _selectedIds.Contains(s.Id));
    }

    private void ShowProfileModal(Student student)
    {
        _profileStudent = student;
    }

    private void CloseProfileModal()
    {
        _profileStudent = null;
    }

    private async Task PrintSelected()
    {
        var selected = _students.Where(s => _selectedIds.Contains(s.Id) && s.QrCode is not null).ToList();
        if (selected.Count == 0) return;

        var data = selected.Select(s => new
        {
            name = s.FullName,
            lrn = s.Lrn,
            studentNumber = s.StudentNumber,
            qrBase64 = Convert.ToBase64String(s.QrCode!.QrCode)
        });

        var json = System.Text.Json.JsonSerializer.Serialize(data);
        await JS.InvokeVoidAsync("students.printSelected", json);
    }

    private async Task PrintSingleQr(Student student)
    {
        if (student.QrCode is null) return;

        var data = new[]
        {
            new
            {
                name = student.FullName,
                lrn = student.Lrn,
                studentNumber = student.StudentNumber,
                qrBase64 = Convert.ToBase64String(student.QrCode.QrCode)
            }
        };

        var json = System.Text.Json.JsonSerializer.Serialize(data);
        await JS.InvokeVoidAsync("students.printSelected", json);
    }

    private async Task DownloadSelected()
    {
        var selected = _students.Where(s => _selectedIds.Contains(s.Id) && s.QrCode is not null).ToList();
        if (selected.Count == 0) return;

        if (selected.Count == 1)
        {
            await DownloadSingleQr(selected[0]);
            return;
        }

        var data = selected.Select(s => new
        {
            name = s.FullName,
            lrn = s.Lrn,
            studentNumber = s.StudentNumber,
            qrBase64 = Convert.ToBase64String(s.QrCode!.QrCode),
            fileName = $"QR_{s.LastName}_{s.FirstName}_{s.Lrn}".Replace(" ", "_")
        });

        var json = System.Text.Json.JsonSerializer.Serialize(data);
        await JS.InvokeVoidAsync("students.downloadSelectedQrs", json);
    }

    private async Task DownloadSingleQr(Student student)
    {
        if (student.QrCode is null) return;

        var data = new
        {
            name = student.FullName,
            lrn = student.Lrn,
            studentNumber = student.StudentNumber,
            qrBase64 = Convert.ToBase64String(student.QrCode.QrCode),
            fileName = $"QR_{student.LastName}_{student.FirstName}_{student.Lrn}".Replace(" ", "_")
        };

        var json = System.Text.Json.JsonSerializer.Serialize(data);
        await JS.InvokeVoidAsync("students.downloadQrAsPng", json);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
