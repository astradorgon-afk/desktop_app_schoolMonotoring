@page "/dashboard"
@layout MainLayout

<PageHeader Title="Dashboard" Subtitle="Overview of your attendance and classroom monitoring system">
    <div class="header-actions">
        <span class="header-date">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
    </div>
</PageHeader>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon stat-icon--blue">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-info">
            <span class="stat-value">156</span>
            <span class="stat-label">Total Students</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon--green">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-info">
            <span class="stat-value">142</span>
            <span class="stat-label">Present Today</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon--yellow">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-info">
            <span class="stat-value">8</span>
            <span class="stat-label">Late Arrivals</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon--red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <div class="stat-info">
            <span class="stat-value">6</span>
            <span class="stat-label">Absent Today</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon--purple">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <div class="stat-info">
            <span class="stat-value">24</span>
            <span class="stat-label">Teachers</span>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon stat-icon--teal">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <div class="stat-info">
            <span class="stat-value">3</span>
            <span class="stat-label">Pending Leave</span>
        </div>
    </div>
</div>

<div class="content-grid">
    <div class="page-card">
        <h2 class="card-heading">Today's Schedule</h2>
        <p class="text-muted" style="margin-bottom: 16px; margin-top: 4px;">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
        <div style="display: flex; flex-direction: column; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #f8fafc; border-radius: 8px; border-left: 3px solid #3b82f6;">
                <span style="font-size: 13px; color: #64748b; min-width: 72px; font-weight: 500;">08:00 AM</span>
                <div style="flex: 1;">
                    <div style="font-size: 14px; font-weight: 600; color: #1e293b;">Mathematics</div>
                    <div style="font-size: 12px; color: #94a3b8;">Mr. Johnson · Room 201</div>
                </div>
                <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: #eff6ff; color: #3b82f6; font-weight: 500; white-space: nowrap;">Ongoing</span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #f8fafc; border-radius: 8px; border-left: 3px solid #22c55e;">
                <span style="font-size: 13px; color: #64748b; min-width: 72px; font-weight: 500;">09:00 AM</span>
                <div style="flex: 1;">
                    <div style="font-size: 14px; font-weight: 600; color: #1e293b;">English Literature</div>
                    <div style="font-size: 12px; color: #94a3b8;">Ms. Williams · Room 105</div>
                </div>
                <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: #f0fdf4; color: #22c55e; font-weight: 500; white-space: nowrap;">Up Next</span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #f8fafc; border-radius: 8px; border-left: 3px solid #eab308;">
                <span style="font-size: 13px; color: #64748b; min-width: 72px; font-weight: 500;">10:00 AM</span>
                <div style="flex: 1;">
                    <div style="font-size: 14px; font-weight: 600; color: #1e293b;">Morning Break</div>
                    <div style="font-size: 12px; color: #94a3b8;">30 minutes</div>
                </div>
                <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: #fefce8; color: #eab308; font-weight: 500; white-space: nowrap;">Break</span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #f8fafc; border-radius: 8px; border-left: 3px solid #8b5cf6;">
                <span style="font-size: 13px; color: #64748b; min-width: 72px; font-weight: 500;">10:30 AM</span>
                <div style="flex: 1;">
                    <div style="font-size: 14px; font-weight: 600; color: #1e293b;">Physics</div>
                    <div style="font-size: 12px; color: #94a3b8;">Dr. Patel · Lab 3</div>
                </div>
                <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: #f5f3ff; color: #8b5cf6; font-weight: 500; white-space: nowrap;">Scheduled</span>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #f8fafc; border-radius: 8px; border-left: 3px solid #14b8a6;">
                <span style="font-size: 13px; color: #64748b; min-width: 72px; font-weight: 500;">11:30 AM</span>
                <div style="flex: 1;">
                    <div style="font-size: 14px; font-weight: 600; color: #1e293b;">History</div>
                    <div style="font-size: 12px; color: #94a3b8;">Mr. Thompson · Room 304</div>
                </div>
                <span style="font-size: 11px; padding: 2px 8px; border-radius: 4px; background: #f0fdfa; color: #14b8a6; font-weight: 500; white-space: nowrap;">Scheduled</span>
            </div>
        </div>
    </div>

    <div class="page-card">
        <h2 class="card-heading">Recent Activity</h2>
        <p class="text-muted" style="margin-bottom: 16px; margin-top: 4px;">Latest updates from the system</p>
        <div style="position: relative; padding-left: 24px;">
            <div style="position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px; background: #e2e8f0;"></div>
            <div style="position: relative; padding-bottom: 18px;">
                <div style="position: absolute; left: -20px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: #3b82f6; border: 2px solid #fff; box-shadow: 0 0 0 1px #e2e8f0;"></div>
                <div style="font-size: 14px; color: #1e293b; font-weight: 500;">John Doe marked attendance</div>
                <div style="font-size: 12px; color: #94a3b8;">Class 10-A · 2 minutes ago</div>
            </div>
            <div style="position: relative; padding-bottom: 18px;">
                <div style="position: absolute; left: -20px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: #eab308; border: 2px solid #fff; box-shadow: 0 0 0 1px #e2e8f0;"></div>
                <div style="font-size: 14px; color: #1e293b; font-weight: 500;">Sarah Smith submitted leave request</div>
                <div style="font-size: 12px; color: #94a3b8;">Personal · 15 minutes ago</div>
            </div>
            <div style="position: relative; padding-bottom: 18px;">
                <div style="position: absolute; left: -20px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: #22c55e; border: 2px solid #fff; box-shadow: 0 0 0 1px #e2e8f0;"></div>
                <div style="font-size: 14px; color: #1e293b; font-weight: 500;">New student enrolled</div>
                <div style="font-size: 12px; color: #94a3b8;">Michael Brown · Grade 9 · 1 hour ago</div>
            </div>
            <div style="position: relative; padding-bottom: 18px;">
                <div style="position: absolute; left: -20px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: #8b5cf6; border: 2px solid #fff; box-shadow: 0 0 0 1px #e2e8f0;"></div>
                <div style="font-size: 14px; color: #1e293b; font-weight: 500;">Attendance report generated</div>
                <div style="font-size: 12px; color: #94a3b8;">June 2026 · 3 hours ago</div>
            </div>
            <div style="position: relative;">
                <div style="position: absolute; left: -20px; top: 5px; width: 10px; height: 10px; border-radius: 50%; background: #14b8a6; border: 2px solid #fff; box-shadow: 0 0 0 1px #e2e8f0;"></div>
                <div style="font-size: 14px; color: #1e293b; font-weight: 500;">Parent-teacher meeting scheduled</div>
                <div style="font-size: 12px; color: #94a3b8;">July 5, 2026 · Yesterday</div>
            </div>
        </div>
    </div>
</div>

<div style="padding: 0 32px 32px;">
    <div class="page-card">
        <h2 class="card-heading" style="margin-bottom: 16px;">Quick Actions</h2>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button class="action-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                Add Student
            </button>
            <button class="action-btn action-btn--green">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
                Mark Attendance
            </button>
            <button class="action-btn action-btn--purple">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                Generate Report
            </button>
            <button class="action-btn action-btn--yellow">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                View Analytics
            </button>
        </div>
    </div>
</div>
