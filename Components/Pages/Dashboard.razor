@page "/dashboard"
@layout DashboardLayout
@inject NavigationManager Navigation
@inject IAnalyticsService AnalyticsService
@inject IRoomService RoomService
@inject IJSRuntime JS
@implements IDisposable

<div class="dash-page">
    <div class="dash-ambient dash-ambient--1"></div>
    <div class="dash-ambient dash-ambient--2"></div>
    <div class="dash-ambient dash-ambient--3"></div>

    <div class="dash-banner">
        <div class="dash-banner-bg"></div>
        <div class="dash-banner-content">
            <div class="dash-banner-left">
                <div class="dash-banner-brand">
                    <svg class="dash-banner-logo" viewBox="0 0 40 40" fill="none" aria-label="Attendance System Logo">
                        <defs>
                            <linearGradient id="logoGrad" x1="0" y1="0" x2="40" y2="40">
                                <stop stop-color="#6366f1"/>
                                <stop offset="1" stop-color="#8b5cf6"/>
                            </linearGradient>
                        </defs>
                        <rect x="8" y="6" width="24" height="30" rx="4" fill="url(#logoGrad)" stroke="rgba(255,255,255,.2)" stroke-width=".8"/>
                        <rect x="15" y="3" width="10" height="6" rx="2" fill="#fff" opacity=".9"/>
                        <path d="M14 21 L18 25 L27 15" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <div>
                        <h1 class="dash-banner-title">Administrator Dashboard</h1>
                        <p class="dash-banner-subtitle">Manage shortcuts, attendance, schedules, and configuration from one workspace.</p>
                    </div>
                </div>
            </div>
            <div class="dash-banner-right">
                <div class="dash-banner-time">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    <span>@_now.ToString("h:mm tt")</span>
                </div>
                <div class="dash-banner-row">
                    <button class="dash-theme-toggle" @onclick="ToggleTheme" title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")">
                        @if (_isDark)
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                        }
                        else
                        {
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="dash-metrics">
        <div class="dash-metric dash-metric--blue">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    Active rooms
                </div>
                <div class="dash-metric-value">@_activeRoomCount</div>
                <div class="dash-metric-desc">of @_roomCount rooms available for classes</div>
            </div>
        </div>
        <div class="dash-metric dash-metric--green">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    Teachers
                </div>
                <div class="dash-metric-value">@_teacherCount</div>
                <div class="dash-metric-desc">active teacher accounts</div>
            </div>
        </div>
        <div class="dash-metric dash-metric--purple">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    Students
                </div>
                <div class="dash-metric-value">@_studentCount</div>
                <div class="dash-metric-desc">active student records</div>
            </div>
        </div>
        <div class="dash-metric dash-metric--orange">
            <div class="dash-metric-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div class="dash-metric-body">
                <div class="dash-metric-label">
                    Attendance rate
                </div>
                <div class="dash-metric-value">@(_attendanceRate)%</div>
                <div class="dash-metric-desc">present or late, all recorded classes</div>
            </div>
        </div>
    </div>

    <div class="dash-workspace">
        <div class="dash-shortcuts-header" style="grid-column: 1 / 5; grid-row: 1;">
            <div>
                <h2 class="dash-section-title">Desktop Shortcuts</h2>
                <p class="dash-section-subtitle">Single-click a tile to open an admin module.</p>
            </div>
            <span class="dash-module-count">8 Modules</span>
        </div>

        <button class="dash-tile dash-tile--blue" style="grid-column: 1; grid-row: 2; animation-delay: 0.08s" @onclick='() => NavigateTo("/admin/analytics")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Analytics</span>
                <span class="dash-tile-desc">Live trends and breakdowns</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--emerald" style="grid-column: 2; grid-row: 2; animation-delay: 0.11s" @onclick='() => NavigateTo("/live-monitoring")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Monitoring</span>
                <span class="dash-tile-desc">Live room occupancy</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--green" style="grid-column: 3; grid-row: 2; animation-delay: 0.14s" @onclick='() => NavigateTo("/students")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Students</span>
                <span class="dash-tile-desc">Learner records and profiles</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--indigo" style="grid-column: 4; grid-row: 2; animation-delay: 0.17s" @onclick='() => NavigateTo("/admin/rooms")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Rooms</span>
                <span class="dash-tile-desc">Classrooms and room QR codes</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--purple" style="grid-column: 1; grid-row: 3; animation-delay: 0.20s" @onclick='() => NavigateTo("/accounts")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M16 21v-1a4 4 0 0 0-4-4h0a4 4 0 0 0-4 4v1"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Accounts</span>
                <span class="dash-tile-desc">Logins and access for all users</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--cyan" style="grid-column: 2; grid-row: 3; animation-delay: 0.23s" @onclick='() => NavigateTo("/teachers")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Teachers</span>
                <span class="dash-tile-desc">Browse teacher records</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--orange" style="grid-column: 3; grid-row: 3; animation-delay: 0.26s" @onclick='() => NavigateTo("/schedules")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Schedules</span>
                <span class="dash-tile-desc">Sections and class slots</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>
        <button class="dash-tile dash-tile--dark" style="grid-column: 4; grid-row: 3; animation-delay: 0.29s" @onclick='() => NavigateTo("/reports")'>
            <div class="dash-tile-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <div class="dash-tile-body">
                <span class="dash-tile-name">Reports</span>
                <span class="dash-tile-desc">Attendance reports &amp; exports</span>
            </div>
            <div class="dash-tile-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
        </button>

        <div class="dash-settings" style="grid-column: 5; grid-row: 2 / 4;">
            <button class="dash-setting-card dash-setting-card--clickable" @onclick='() => NavigateTo("/reports?tab=export")'>
                <div class="dash-setting-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                </div>
                <div class="dash-setting-card-body">
                    <div class="dash-setting-card-label">Export Data</div>
                    <div class="dash-setting-card-value">CSV or Excel files</div>
                </div>
            </button>
            <button class="dash-setting-card dash-setting-card--clickable" @onclick='() => NavigateTo("/teacher/profile")'>
                <div class="dash-setting-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </div>
                <div class="dash-setting-card-body">
                    <div class="dash-setting-card-label">Profile Settings</div>
                    <div class="dash-setting-card-value">Your account details</div>
                </div>
            </button>
            <button class="dash-setting-card dash-setting-card--danger dash-setting-card--clickable" @onclick="NavigateToLogout">
                <div class="dash-setting-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                </div>
                <div class="dash-setting-card-body">
                    <div class="dash-setting-card-label">Exit Dashboard</div>
                </div>
            </button>
        </div>
    </div>
</div>

@code {
    private int _activeRoomCount;
    private int _roomCount;
    private DateTime _now = DateTime.Now;
    private readonly CancellationTokenSource _cts = new();
    private int _teacherCount;
    private int _studentCount;
    private double _attendanceRate;
    private bool _isDark;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("window.__theme.get");
            _isDark = theme == "dark";

            var analyticsTask = AnalyticsService.GetAdminAnalyticsAsync();
            var roomsTask = RoomService.GetAllAsync();

            await Task.WhenAll(analyticsTask, roomsTask);

            var analytics = await analyticsTask;
            var rooms = await roomsTask;

            _activeRoomCount = rooms.Count(r => r.IsActive);
            _roomCount = rooms.Count;
            _teacherCount = analytics.TotalTeachers;
            _studentCount = analytics.TotalStudents;
            _attendanceRate = analytics.OverallAttendanceRate;
        }
        catch
        {
            // Metrics will remain at their default (0) values
        }

        _ = RunClockAsync();
    }

    // The banner clock used to be drawn once and never change.
    private async Task RunClockAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                var now = DateTime.Now;
                if (now.Minute == _now.Minute && now.Hour == _now.Hour) continue;
                _now = now;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task ToggleTheme()
    {
        var result = await JS.InvokeAsync<string>("window.__theme.toggle");
        _isDark = result == "dark";
    }

    private void NavigateTo(string url)
    {
        Navigation.NavigateTo(url);
    }

    private void NavigateToLogout()
    {
        Navigation.NavigateTo("/login");
    }
}
