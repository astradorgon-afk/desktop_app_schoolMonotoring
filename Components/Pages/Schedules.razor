    private string _formErrorGeneral = "";

    private void OpenCellModal(int day, TimeOnly time, TimetableBlock? block = null)
    {
        _modalDay = day;
        _modalTime = time;
        _saving = false;
        _formErrors = [];
        _formErrorGeneral = "";
        _pendingDeleteScheduleId = 0;

        if (block is not null)
        {
            _editMode = true;
            _editOfferingId = block.OfferingId;
            _editScheduleId = block.ScheduleId;
            // Pre-fill from the clicked entry
            var entry = _pageData?.Entries.FirstOrDefault(e => e.Id == block.ScheduleId);
            _formSectionId = entry?.SectionId ?? _selectedSectionId ?? 0;
            _formSectionLabel = entry is not null ? $"{entry.GradeLevel} {entry.SectionName}".Trim() : SelectedSectionLabel();
            _formSubjectId = entry?.SubjectId ?? 0;
            _formTeacherId = entry?.TeacherId ?? 0;
            _formRoom = entry?.Room ?? "";
            _formEndTime = entry?.EndTime.ToString("h\\:mm tt") ?? "";
        }
        else
        {
            _editMode = false;
            _editOfferingId = 0;
            _editScheduleId = 0;
            _formSectionId = _selectedSectionId ?? 0;
            _formSectionLabel = SelectedSectionLabel();
            _formSubjectId = 0;
            _formTeacherId = 0;
            _formRoom = "";
            _formEndTime = "";
        }

        RefreshAvailableTeachers();

        _showCellModal = true;
        StateHasChanged();
