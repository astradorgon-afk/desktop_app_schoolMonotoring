    private string SelectedSectionLabel()
    {
        if (!_selectedSectionId.HasValue) return "";
        var sec = _pageData?.Sections.FirstOrDefault(s => s.SectionId == _selectedSectionId.Value);
        return sec is not null ? $"{sec.GradeLevel} {sec.SectionName}".Trim() : "";
    }

    private string FormSectionLabel() => _formSectionLabel;

    // Teachers free at the slot's start time. In edit mode the entry's own teacher is
    // kept in the list so the current assignment stays selectable.
    private void RefreshAvailableTeachers()
    {
        if (!_modalDay.HasValue || !_modalTime.HasValue)
        {
            _availableTeachers = _teachers;
            return;
        }

        var day = _modalDay.Value;
        var time = _modalTime.Value;

        var busyTeacherIds = _pageData?.Entries
            .Where(e => e.DayOfWeek == day && e.StartTime <= time && e.EndTime > time)
            .Where(e => e.Id != _editScheduleId)
            .Select(e => e.TeacherId)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToHashSet() ?? [];

        _availableTeachers = _teachers
            .Where(t => !busyTeacherIds.Contains(t.Id) || t.Id == _formTeacherId)
            .ToList();
    }

    private void CloseCellModal()
    {
        _showCellModal = false;
        _editMode = false;
        _editOfferingId = 0;
        _editScheduleId = 0;
        _formRoom = "";
        _formEndTime = "";
        _formSectionLabel = "";
        _pendingDeleteScheduleId = 0;
    }

    @* ── Conflicts for the entry currently in the modal ── *@
    private sealed record ModalConflict(
        ScheduleViewEntry Entry, List<string> Reasons, TimeOnly OverlapStart, TimeOnly OverlapEnd);

    // The time window the modal is currently describing. Before an end time is picked,
    // fall back to the single 30-minute slot that was clicked.
    private (TimeOnly Start, TimeOnly End)? ModalWindow()
    {
        if (!_modalTime.HasValue) return null;

        var start = _modalTime.Value;
        var end = TimeOnly.TryParse(_formEndTime, out var parsed) && parsed > start
            ? parsed
            : start.AddMinutes(30);

        return (start, end);
    }

    private List<ModalConflict> GetModalConflicts()
    {
        var conflicts = new List<ModalConflict>();
        if (_pageData is null || !_modalDay.HasValue) return conflicts;

        var window = ModalWindow();
        if (window is null) return conflicts;

        var (start, end) = window.Value;

        foreach (var e in _pageData.Entries)
        {
            if (e.Id == _editScheduleId) continue;           // an entry never clashes with itself
            if (e.DayOfWeek != _modalDay.Value) continue;
            if (!(start < e.EndTime && end > e.StartTime)) continue;

            var reasons = new List<string>();
            if (_formTeacherId != 0 && e.TeacherId == _formTeacherId)
                reasons.Add("Same teacher");
            if (_formSectionId != 0 && e.SectionId == _formSectionId)
                reasons.Add("Same section");
            if (!string.IsNullOrEmpty(_formRoom) && string.Equals(e.Room, _formRoom, StringComparison.OrdinalIgnoreCase))
                reasons.Add("Same room");

            if (reasons.Count == 0) continue;

            conflicts.Add(new ModalConflict(
                e,
                reasons,
                start > e.StartTime ? start : e.StartTime,
                end < e.EndTime ? end : e.EndTime));
        }

        return conflicts.OrderBy(c => c.Entry.StartTime).ToList();
    }

    private bool IsRoomBusy(string roomCode)
    {
        if (_pageData is null || !_modalDay.HasValue || string.IsNullOrEmpty(roomCode)) return false;

        var window = ModalWindow();
        if (window is null) return false;

        var (start, end) = window.Value;

        return _pageData.Entries.Any(e =>
            e.Id != _editScheduleId
            && e.DayOfWeek == _modalDay.Value
            && start < e.EndTime && end > e.StartTime
            && string.Equals(e.Room, roomCode, StringComparison.OrdinalIgnoreCase));
    }

    // Swap the modal over to editing the conflicting entry, without leaving the dialog.
    private void EditConflictEntry(ScheduleViewEntry entry)
