@page "/schedules"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using AttendanceUI.Services
@inject IScheduleService ScheduleService
@implements IDisposable

<PageHeader Title="Schedules" Subtitle="Manage class schedules, time slots, and room assignments">
    <div class="header-actions">
        <div class="header-date">@DateTime.Now.ToString("MMMM dd, yyyy")</div>
    </div>
</PageHeader>

@if (_loading)
{
    <div class="loading-state">
        <div class="spinner"></div>
        <p>Loading schedules…</p>
    </div>
}
else
{
    @* ── Toolbar ── *@
    <div class="students-toolbar">
        <div class="search-wrapper">
            <span class="search-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </span>
            <input class="search-input" type="text" aria-label="Search section or subject" placeholder="Search section or subject…" @oninput="HandleSearch" value="@_search" />
        </div>

        <select class="filter-select" @onchange="HandleGradeFilter" value="@_gradeFilter">
            <option value="">All Grade Levels</option>
            <option value="G7">Grade 7</option>
            <option value="G8">Grade 8</option>
            <option value="G9">Grade 9</option>
            <option value="G10">Grade 10</option>
        </select>

        <select class="filter-select" @onchange="HandleStatusFilter" value="@_statusFilter">
            <option value="">All Status</option>
            <option value="ACTIVE">Active</option>
            <option value="FINALIZED">Finalized</option>
        </select>

        <button class="action-btn" @onclick="LoadDataAsync" title="Refresh">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            Refresh
        </button>
    </div>

    @* ── Conflict Alert ── *@
    @if (_conflicts.Count > 0)
    {
        <div class="conflict-alert">
            <div class="conflict-alert-head" @onclick="() => _showConflictDetails = !_showConflictDetails">
                <div class="conflict-alert-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                </div>
                <div class="conflict-alert-text">
                    <strong>@_conflicts.Count schedule conflict@(_conflicts.Count == 1 ? "" : "s") detected</strong>
                    <span>Overlapping classes share a teacher, section, or room. Click to @(_showConflictDetails ? "hide" : "review").</span>
                </div>
                <svg class="conflict-alert-chevron @(_showConflictDetails ? "open" : "")" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>

            @if (_showConflictDetails)
            {
                <div class="conflict-alert-list">
                    @foreach (var c in _conflicts)
                    {
                        <div class="conflict-item">
                            <div class="conflict-item-top">
                                <span class="conflict-kind">@c.Kind</span>
                                <span class="conflict-who">@c.Who</span>
                                <span class="conflict-when">@c.When</span>
                            </div>
                            <div class="conflict-pair">
                                <span>@c.ClassA</span>
                                <span class="conflict-vs">overlaps</span>
                                <span>@c.ClassB</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @* ── Section Cards ── *@
    <div class="section-cards-row">
        @foreach (var sec in _filteredSections)
        {
            <div class="section-card @(_selectedSectionId == sec.SectionId ? "section-card--active" : "")" @onclick="() => SelectSection(sec.SectionId)">
                @if (_conflictSectionIds.Contains(sec.SectionId))
                {
                    <span class="section-card-conflict" title="This section has a schedule conflict">!</span>
                }
                <div class="section-card-name">@sec.SectionName</div>
                <div class="section-card-grade">@sec.GradeLevel</div>
                <div class="section-card-count">@sec.StudentCount enrolled</div>
            </div>
        }
    </div>

    @* ── Weekly Timetable ── *@
    @if (_selectedSectionId is null)
    {
        <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 32px;text-align:center;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--clr-text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
            <div style="font-size:16px;font-weight:600;color:var(--clr-text-muted);margin-top:16px;">Select a section above to view its schedule</div>
            <div style="font-size:13px;color:var(--clr-text-muted);margin-top:4px;">Click on any section card to see the weekly timetable</div>
        </div>
    }
    else
    {
        <div class="timetable-wrapper">
        <div class="timetable">
            @* header row *@
            <div class="tt-header tt-timecell" style="grid-row:1;grid-column:1;"></div>
            @for (var ci = 0; ci < _days.Length; ci++)
            {
                <div class="tt-header tt-daycell" style="grid-row:1;grid-column:@(ci+2);">@_days[ci]</div>
            }
            @* body: explicitly positioned cells *@
            @for (var si = 0; si < _timeSlots.Count; si++)
            {
                var row = si + 2;
                var slot = _timeSlots[si];
                @* time label *@
                <div class="tt-timecol" style="grid-row:@row;grid-column:1;">
                    <div class="tt-timelabel">@slot.ToString("h\\:mm tt")</div>
                </div>
                @for (var di = 0; di < _dayIndices.Length; di++)
                {
                    var dayVal = _dayIndices[di];
                    var col = di + 2;
                    var block = _gridEntries.GetValueOrDefault((dayVal, slot));
                    if (block is not null)
                    {
                        var isConflict = block.ScheduleId != 0 && _conflictScheduleIds.Contains(block.ScheduleId);
                        var cellTitle = (isConflict ? "⚠ Schedule conflict\n" : "")
                            + block.Subject + "\n" + block.TeacherName + "\n" + block.SectionName + "\n" + block.Room;
                        <div class="tt-cell tt-cell--has @block.ColorClass @(isConflict ? "tt-cell--conflict" : "")"
                             style="grid-row:@row/span @block.SpanRows;grid-column:@col;"
                             @onclick="() => OpenCellModal(dayVal, slot, block)"
                             title="@cellTitle">
                            @if (isConflict)
                            {
                                <span class="tt-conflict-badge" title="Schedule conflict">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                </span>
                            }
                            <div class="tt-block-subject">@block.Subject</div>
                            <div class="tt-block-teacher">@block.TeacherName</div>
                            <div class="tt-block-room">@block.Room</div>
                        </div>
                    }
                    else
                    {
                        <div class="tt-cell tt-cell--empty" style="grid-row:@row;grid-column:@col;" @onclick="() => OpenCellModal(dayVal, slot)"></div>
                    }
                }
            }
            </div>
        </div>
    }

    @* ── Bottom panel: Form + Table ── *@
    <div class="content-grid" style="padding: 16px 32px 32px;">
        @* Left: Add/Edit Form *@
        <div class="page-card">
            <div class="card-heading" style="margin-bottom:16px;">Add / Edit Class Entry</div>
            <div class="schedule-form-grid">
                <div class="form-group">
                    <label class="form-label" for="sched-f-section">Section</label>
                    <select id="sched-f-section" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var sec in _pageData?.Sections ?? [])
                        {
                            <option value="@sec.SectionId">@sec.GradeLevel @sec.SectionName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sched-f-subject">Subject</label>
                    <select id="sched-f-subject" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var sub in _subjects)
                        {
                            <option value="@sub.Id">@sub.Title</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sched-f-teacher">Teacher</label>
                    <select id="sched-f-teacher" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var t in _teachers)
                        {
                            <option value="@t.Id">@t.LastName, @t.FirstName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sched-f-day">Day</label>
                    <select id="sched-f-day" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var d in _dayOptions)
                        {
                            <option value="@d.Key">@d.Value</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sched-f-start">Start Time</label>
                    <select id="sched-f-start" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var t in _timeOptions)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sched-f-end">End Time</label>
                    <select id="sched-f-end" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var t in _timeOptions)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label" for="sched-f-room">Room</label>
                    <select id="sched-f-room" class="filter-select" style="width:100%;">
                        <option value="">— Select —</option>
                        @foreach (var r in _rooms)
                        {
                            <option value="@r.Code">@r.Code — @r.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div style="display:flex;gap:8px;margin-top:12px;">
                <button class="action-btn action-btn--purple" style="flex:0 0 auto;">Save</button>
                <button class="action-btn" style="flex:0 0 auto;color:#ef4444;">Delete</button>
                <button class="action-btn" style="flex:0 0 auto;">Clear</button>
            </div>
        </div>

        @* Right: Current Schedule Table *@
        <div class="page-card">
            <div class="card-heading" style="margin-bottom:16px;">Current Schedule</div>
            <div class="schedule-table-wrapper" style="max-height:320px;overflow-y:auto;">
                <table class="students-table">
                    <thead>
                        <tr>
                            <th>Day</th>
                            <th>Time</th>
                            <th>Subject</th>
                            <th>Teacher</th>
                            <th>Room</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _sortedEntries)
                        {
                            <tr>
                                <td><span class="day-badge">@_days[entry.DayOfWeek - 1]</span></td>
                                <td>@entry.StartTime.ToString("h\\:mm tt") – @entry.EndTime.ToString("h\\:mm tt")</td>
                                <td>@entry.Subject</td>
                                <td>@entry.TeacherName</td>
                                <td>@(!string.IsNullOrEmpty(entry.Room) ? entry.Room : "—")</td>
                            </tr>
                        }
                        @if (_sortedEntries.Count == 0)
                        {
                            <tr><td class="empty-state" colspan="5">No schedule entries found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ── Cell Click Modal ── *@
@if (_showCellModal)
{
    var modalDayName = _modalDay.HasValue && _modalDay.Value >= 1 && _modalDay.Value <= 6 ? _days[_modalDay.Value - 1] : "";
    var modalTimeStr = _modalTime?.ToString("h\\:mm tt") ?? "";

    <Modal Title="@($"{(_editMode ? "Edit Entry" : "Quick Add")} — {modalDayName} {modalTimeStr}")" ContentClass="sched-cell-modal" OnClose="CloseCellModal">
            <div class="modal-header">
                <h3>@(_editMode ? "Edit Entry" : "Quick Add") — @modalDayName @modalTimeStr</h3>
                <button class="modal-close" @onclick="CloseCellModal">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            @if (_saving)
            {
                <div class="modal-body" style="align-items:center;gap:12px;">
                    <div class="spinner"></div>
                    <p style="font-size:14px;color:var(--clr-text-secondary);">Saving schedule…</p>
                </div>
            }
            else
            {
            <div class="modal-body" style="align-items:stretch;">

                @* Entries that clash with what's being scheduled here, plus one-click fixes *@
                @{
                    var modalConflicts = GetModalConflicts();
                }
                <div class="sched-cf-head">
                    <span class="sched-cf-title">Conflicts with this entry</span>
                    @if (modalConflicts.Count > 0)
                    {
                        <span class="sched-cf-count">@modalConflicts.Count</span>
                    }
                </div>

                @if (modalConflicts.Count == 0)
                {
                    <div class="sched-cf-clear">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span>
                            @if (string.IsNullOrEmpty(_formEndTime))
                            {
                                @:Nothing clashes at this start time. Pick an end time to check the full slot.
                            }
                            else
                            {
                                @:No clashes — the teacher, section, and room are all free for this slot.
                            }
                        </span>
                    </div>
                }
                else
                {
                    <div class="sched-cf-list">
                        @foreach (var c in modalConflicts)
                        {
                            <div class="sched-cf-row">
                                <div class="sched-cf-info">
                                    <div class="sched-cf-name">@c.Entry.Subject</div>
                                    <div class="sched-cf-meta">@($"{c.Entry.GradeLevel} {c.Entry.SectionName}".Trim()) · @c.Entry.TeacherName@(string.IsNullOrEmpty(c.Entry.Room) ? "" : $" · {c.Entry.Room}")</div>
                                    <div class="sched-cf-tags">
                                        @foreach (var reason in c.Reasons)
                                        {
                                            <span class="sched-cf-tag">@reason</span>
                                        }
                                        <span class="sched-cf-overlap">@c.Entry.StartTime.ToString("h\\:mm tt")–@c.Entry.EndTime.ToString("h\\:mm tt") · overlaps @c.OverlapStart.ToString("h\\:mm tt")–@c.OverlapEnd.ToString("h\\:mm tt")</span>
                                    </div>
                                </div>
                                <div class="sched-cf-actions">
                                    <button class="sched-cf-btn" title="Open this entry so you can change its teacher, room, or time" @onclick="() => EditConflictEntry(c.Entry)">Edit</button>
                                    @if (_pendingDeleteScheduleId == c.Entry.Id)
                                    {
                                        <button class="sched-cf-btn sched-cf-btn--danger" title="Click again to confirm" disabled="@_saving" @onclick="() => DeleteConflictEntry(c.Entry)">Confirm</button>
                                        <button class="sched-cf-btn" @onclick="() => _pendingDeleteScheduleId = 0">Keep</button>
                                    }
                                    else
                                    {
                                        <button class="sched-cf-btn sched-cf-btn--danger" title="Delete this entry to free the slot" @onclick="() => _pendingDeleteScheduleId = c.Entry.Id">Remove</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="sched-cf-hint">
                        Fix a clash by removing the entry above, editing it, or changing the teacher / room / end time below.
                    </div>
                }

                @* Quick-add / Edit form *@
                <div style="font-size:11px;font-weight:700;color:var(--clr-text-muted);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;">@(_editMode ? "Edit Entry" : "Quick Add")</div>
                <div style="display:flex;flex-direction:column;gap:10px;">
                    <div class="sched-form-row sched-form-row--2">
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--clr-text-secondary);margin-bottom:4px;">Section</div>
                            <select class="filter-select" style="width:100%;" disabled>
                                @if (_formSectionId != 0)
                                {
                                    <option value="@_formSectionId">@FormSectionLabel()</option>
                                }
                                else
                                {
                                    <option value="">— Select a section card first —</option>
                                }
                            </select>
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--clr-text-secondary);margin-bottom:4px;">Subject</div>
                            <select class="filter-select" style="width:100%;@(_formErrors.ContainsKey("subject") ? "border-color:#ef4444;" : "")" @bind="_formSubjectId">
                                <option value="0">— Select —</option>
                                @{
                                    var filteredSubjects = _selectedGradeLevelId > 0
                                        ? _subjects.Where(s => s.GradeLevelId == _selectedGradeLevelId).ToList()
                                        : _subjects;
                                }
                                @foreach (var sub in filteredSubjects)
                                {
                                    <option value="@sub.Id">@sub.Title</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue("subject", out var subjectErr))
                            {
                                <div style="font-size:11px;color:#ef4444;margin-top:2px;">@subjectErr</div>
                            }
                            @if (filteredSubjects.Count == 0 && _selectedGradeLevelId > 0)
                            {
                                <div style="font-size:11px;color:#ef4444;margin-top:2px;">No subjects for this grade level</div>
                            }
                        </div>
                    </div>
                    <div class="sched-form-row sched-form-row--3">
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--clr-text-secondary);margin-bottom:4px;">Teacher <span style="color:var(--clr-success);font-weight:400;">(@_availableTeachers.Count available)</span></div>
                            <select class="filter-select" style="width:100%;@(_formErrors.ContainsKey("teacher") ? "border-color:#ef4444;" : "")" @bind="_formTeacherId">
                                <option value="0">— Select —</option>
                                @foreach (var t in _availableTeachers)
                                {
                                    <option value="@t.Id">@t.LastName, @t.FirstName</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue("teacher", out var teacherErr))
                            {
                                <div style="font-size:11px;color:#ef4444;margin-top:2px;">@teacherErr</div>
                            }
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--clr-text-secondary);margin-bottom:4px;">Room</div>
                            <select class="filter-select" style="width:100%;@(_formErrors.ContainsKey("room") ? "border-color:#ef4444;" : "")" @bind="_formRoom">
                                <option value="">— Select —</option>
                                @foreach (var r in _rooms)
                                {
                                    <option value="@r.Code">@r.Code — @r.Name@(IsRoomBusy(r.Code) ? "  (in use)" : "")</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue("room", out var roomErr))
                            {
                                <div style="font-size:11px;color:#ef4444;margin-top:2px;">@roomErr</div>
                            }
                        </div>
                        <div>
                            <div style="font-size:12px;font-weight:600;color:var(--clr-text-secondary);margin-bottom:4px;">End Time</div>
                            <select class="filter-select" style="width:100%;@(_formErrors.ContainsKey("endTime") ? "border-color:#ef4444;" : "")" @bind="_formEndTime">
                                <option value="">— Select —</option>
                                @{
                                    var startIdx = _modalTime.HasValue ? Array.IndexOf(_timeOptions, _modalTime.Value.ToString("h\\:mm tt")) + 1 : -1;
                                }
                                @for (var ti = Math.Max(startIdx, 0); ti < _timeOptions.Length; ti++)
                                {
                                    <option value="@_timeOptions[ti]">@_timeOptions[ti]</option>
                                }
                            </select>
                            @if (_formErrors.TryGetValue("endTime", out var endTimeErr))
                            {
                                <div style="font-size:11px;color:#ef4444;margin-top:2px;">@endTimeErr</div>
                            }
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;margin-top:4px;">
                        @if (_editMode)
                        {
                            <button class="action-btn action-btn--purple" style="flex:0 0 auto;" disabled="@_saving" @onclick="UpdateCellEntry">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                Update
                            </button>
                            <button class="action-btn" style="flex:0 0 auto;color:var(--clr-danger);" disabled="@_saving" @onclick="DeleteCellEntry">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                Delete
                            </button>
                        }
                        else
                        {
                            <button class="action-btn action-btn--purple" style="flex:0 0 auto;" disabled="@_saving" @onclick="SaveCellEntry">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                                Save
                            </button>
                        }
                        <button class="action-btn" style="flex:0 0 auto;" @onclick="CloseCellModal">Cancel</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_formErrorGeneral))
                    {
                        <div style="font-size:12px;color:var(--clr-danger);padding:6px 10px;background:var(--clr-surface-alt);border:1px solid var(--clr-danger);border-radius:6px;">@_formErrorGeneral</div>
                    }
                </div>
            </div>
            }
    </Modal>
