@page "/teacher/profile"
@layout MainLayout
@using AttendanceUI.Data.Entities
@using System.Globalization
@implements IAsyncDisposable
@inject ITeacherService TeacherService
@inject IStudentPortalService StudentPortalService
@inject IStudentService StudentService
@inject IAuditService AuditService
@inject IUserService UserService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageHeader Title="Profile Settings" Subtitle="Manage your account and personal information">
</PageHeader>

@if (_loading)
{
    <div style="display:flex;align-items:center;justify-content:center;padding:80px 0;">
        <div class="spinner" style="width:32px;height:32px;"></div>
    </div>
}
else if (_error is not null)
{
    <div style="padding:0 32px;">
        <div class="error-banner">@_error</div>
    </div>
}
else if (_user is not null)
{
    <div style="padding:0 32px;display:grid;grid-template-columns:1fr 1.6fr;gap:24px;">

        @* ── Profile Card ── *@
        <div class="page-card" style="text-align:center;">
            @if (_teacher is not null)
            {
                <div style="position:relative;display:inline-block;margin:24px auto 16px;">
                    <div class="profile-pic-wrap" style="width:120px;height:120px;border-radius:50%;overflow:hidden;border:3px solid var(--clr-border);box-shadow:var(--shadow-card);">
                        @if (_teacher.ProfilePicture is not null)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(_teacher.ProfilePicture)" style="width:100%;height:100%;object-fit:cover;" alt="Profile" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;background:var(--clr-surface-alt);display:flex;align-items:center;justify-content:center;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="1.5">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                        }
                        <button class="profile-pic-overlay" @onclick="TriggerFilePicker" title="Change photo" style="position:absolute;inset:0;width:100%;height:100%;border:none;background:rgba(0,0,0,0.5);color:#fff;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s;border-radius:50%;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                            <span style="font-size:10px;margin-top:2px;">Change</span>
                        </button>
                    </div>
                </div>
                <input type="file" accept="image/*" style="display:none;" @onchange="HandleFileSelected" />

                <h2 style="font-size:20px;font-weight:700;color:var(--clr-text);margin:0 0 2px;">@_teacher.FullName</h2>
                @if (!string.IsNullOrEmpty(_teacher.EmployeeNo))
                {
                    <p style="font-size:13px;color:var(--clr-text-muted);margin:0 0 4px;">@_teacher.EmployeeNo</p>
                }
                <span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:600;background:rgba(99,102,241,0.12);color:var(--clr-accent);">@_teacher.Status</span>

                <div style="margin-top:20px;display:flex;flex-direction:column;gap:12px;text-align:left;">
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:11px;color:var(--clr-text-muted);text-transform:uppercase;letter-spacing:0.5px;">Email</div>
                            <div style="font-size:13px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.Email) ? _teacher.Email : "—")</div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:11px;color:var(--clr-text-muted);text-transform:uppercase;letter-spacing:0.5px;">Contact</div>
                            <div style="font-size:13px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.ContactNo) ? _teacher.ContactNo : "—")</div>
                        </div>
                    </div>
                </div>
            }
            else if (_student is not null)
            {
                <div style="position:relative;display:inline-block;margin:24px auto 16px;">
                    <div class="profile-pic-wrap" style="width:120px;height:120px;border-radius:50%;overflow:hidden;border:3px solid var(--clr-border);box-shadow:var(--shadow-card);">
                        @if (_student.ProfilePicture is not null)
                        {
                            <img src="data:image/jpeg;base64,@Convert.ToBase64String(_student.ProfilePicture)" style="width:100%;height:100%;object-fit:cover;" alt="Profile" />
                        }
                        else
                        {
                            <div style="width:100%;height:100%;background:var(--clr-surface-alt);display:flex;align-items:center;justify-content:center;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="1.5">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                            </div>
                        }
                        <button class="profile-pic-overlay" @onclick="TriggerStudentFilePicker" title="Change photo" style="position:absolute;inset:0;width:100%;height:100%;border:none;background:rgba(0,0,0,0.5);color:#fff;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s;border-radius:50%;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                            <span style="font-size:10px;margin-top:2px;">Change</span>
                        </button>
                    </div>
                </div>
                <input type="file" accept="image/*" style="display:none;" @onchange="HandleStudentFileSelected" />

                <h2 style="font-size:20px;font-weight:700;color:var(--clr-text);margin:0 0 2px;">@_student.FullName</h2>
                <p style="font-size:13px;color:var(--clr-text-muted);margin:0 0 4px;">@_student.Lrn</p>
                <span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:600;background:rgba(99,102,241,0.12);color:var(--clr-accent);">@_student.Status</span>

                <div style="margin-top:20px;display:flex;flex-direction:column;gap:12px;text-align:left;">
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:11px;color:var(--clr-text-muted);text-transform:uppercase;letter-spacing:0.5px;">Student No</div>
                            <div style="font-size:13px;color:var(--clr-text);">@_student.StudentNumber</div>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <div style="flex:1;min-width:0;">
                            <div style="font-size:11px;color:var(--clr-text-muted);text-transform:uppercase;letter-spacing:0.5px;">Contact</div>
                            <div style="font-size:13px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.ContactNo) ? _student.ContactNo : "—")</div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div style="margin:24px auto 16px;">
                    <div style="width:120px;height:120px;border-radius:50%;background:var(--clr-surface-alt);display:flex;align-items:center;justify-content:center;margin:0 auto;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="1.5">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                </div>
                <h2 style="font-size:20px;font-weight:700;color:var(--clr-text);margin:0 0 2px;">@_user.Name</h2>
                <span style="display:inline-block;padding:2px 10px;border-radius:6px;font-size:11px;font-weight:600;background:rgba(99,102,241,0.12);color:var(--clr-accent);">@_user.Role</span>
            }
        </div>

        @* ── Details Card ── *@
        <div class="page-card">
            @if (_success is not null)
            {
                <div style="padding:10px 14px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:8px;color:rgb(34,197,94);font-size:13px;font-weight:500;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    @_success
                </div>
            }
            @if (_teacher is not null)
            {
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
                    <h3 style="font-size:16px;font-weight:700;color:var(--clr-text);margin:0;">Personal Information</h3>
                    @if (!_isEditing)
                    {
                        <button class="page-btn page-btn-outline" @onclick="EnterEditMode" style="font-size:12px;padding:6px 14px;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:4px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                            Edit
                        </button>
                    }
                    else
                    {
                        <div style="display:flex;gap:8px;">
                            <button class="page-btn page-btn-outline" @onclick="CancelEdit" disabled="@_isSaving" style="font-size:12px;padding:6px 14px;">Cancel</button>
                            <button class="page-btn page-btn-primary" @onclick="SaveAsync" disabled="@_isSaving" style="font-size:12px;padding:6px 14px;">
                                @if (_isSaving)
                                {
                                    <span class="spinner" style="width:12px;height:12px;border-width:1.5px;display:inline-block;vertical-align:middle;margin-right:4px;"></span>
                                }
                                Save
                            </button>
                        </div>
                    }
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div>
                        <label class="field-label" for="tp-editteacher-firstname">First Name</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-firstname" @bind="_editTeacher.FirstName" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);font-weight:500;">@_teacher.FirstName</div>
                        }
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-lastname">Last Name</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-lastname" @bind="_editTeacher.LastName" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);font-weight:500;">@_teacher.LastName</div>
                        }
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-middlename">Middle Name</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-middlename" @bind="_editTeacher.MiddleName" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.MiddleName) ? _teacher.MiddleName : "—")</div>
                        }
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-employeeno">Employee No.</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-employeeno" @bind="_editTeacher.EmployeeNo" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.EmployeeNo) ? _teacher.EmployeeNo : "—")</div>
                        }
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-specialization">Specialization</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-specialization" @bind="_editTeacher.Specialization" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.Specialization) ? _teacher.Specialization : "—")</div>
                        }
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-employmentstatus">Employment Status</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-employmentstatus" @bind="_editTeacher.EmploymentStatus" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.EmploymentStatus) ? _teacher.EmploymentStatus : "—")</div>
                        }
                    </div>
                    <div>
                        <span class="field-label">Hire Date</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(_teacher.HireDate?.ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Teacher ID</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@_teacher.Id</div>
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-email">Email</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-email" @bind="_editTeacher.Email" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.Email) ? _teacher.Email : "—")</div>
                        }
                    </div>
                    <div>
                        <label class="field-label" for="tp-editteacher-contactno">Contact No.</label>
                        @if (_isEditing)
                        {
                            <input id="tp-editteacher-contactno" @bind="_editTeacher.ContactNo" class="editable-input" />
                        }
                        else
                        {
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_teacher.ContactNo) ? _teacher.ContactNo : "—")</div>
                        }
                    </div>
                </div>
            }
            else if (_student is not null)
            {
                <div style="margin-bottom:20px;">
                    <h3 style="font-size:16px;font-weight:700;color:var(--clr-text);margin:0;">Student Information</h3>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                    <div>
                        <span class="field-label">First Name</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);font-weight:500;">@_student.FirstName</div>
                    </div>
                    <div>
                        <span class="field-label">Last Name</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);font-weight:500;">@_student.LastName</div>
                    </div>
                    <div>
                        <span class="field-label">Middle Name</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.MiddleName) ? _student.MiddleName : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">LRN</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@_student.Lrn</div>
                    </div>
                    <div>
                        <span class="field-label">Sex</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.Sex) ? _student.Sex : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Birthdate</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(_student.Birthdate?.ToString("MMM dd, yyyy") ?? "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Address</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.Address) ? _student.Address : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Guardian</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.GuardianName) ? _student.GuardianName : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Guardian Contact</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.GuardianContact) ? _student.GuardianContact : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Contact No.</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.ContactNo) ? _student.ContactNo : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Previous School</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@(!string.IsNullOrEmpty(_student.PreviousSchool) ? _student.PreviousSchool : "—")</div>
                    </div>
                    <div>
                        <span class="field-label">Student ID</span>
                        <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@_student.Id</div>
                    </div>
                </div>
            }
            else
            {
                <div style="margin-bottom:20px;">
                    <h3 style="font-size:16px;font-weight:700;color:var(--clr-text);margin:0;">Administrator Account</h3>
                    <p style="font-size:13px;color:var(--clr-text-secondary);margin:8px 0 0;">You are logged in as an administrator. Profile details are managed by the system.</p>
                </div>
            }

            @if (_user is not null)
            {
                <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--clr-border);">
                    <h3 style="font-size:16px;font-weight:700;color:var(--clr-text);margin:0 0 16px;">Account</h3>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                        <div>
                            <label class="field-label" for="tp-edituser-username">Username</label>
                            @if (_isEditing && _teacher is not null)
                            {
                                <input id="tp-edituser-username" @bind="_editUser.Username" class="editable-input" />
                            }
                            else
                            {
                                <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);font-weight:500;">@_user.Username</div>
                            }
                        </div>
                        <div>
                            <span class="field-label">Role</span>
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-accent);font-weight:600;">@_user.Role</div>
                        </div>
                        <div>
                            <label class="field-label" for="tp-edituser-name">Display Name</label>
                            @if (_isEditing && _teacher is not null)
                            {
                                <input id="tp-edituser-name" @bind="_editUser.Name" class="editable-input" />
                            }
                            else
                            {
                                <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@_user.Name</div>
                            }
                        </div>
                        <div>
                            <span class="field-label">Status</span>
                            <div style="padding:10px 14px;background:var(--clr-surface-alt);border-radius:8px;font-size:14px;color:var(--clr-text);">@_user.Status</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div style="padding:24px 32px 32px;display:grid;grid-template-columns:@(_student is not null ? "1fr 1.6fr" : "1fr");gap:24px;">

        @* ── My QR Code (students) ── *@
        @if (_student is not null)
        {
            <div class="page-card" style="text-align:center;">
                <h3 style="font-size:16px;font-weight:700;color:var(--clr-text);margin:0 0 4px;text-align:left;">My QR Code</h3>
                <p style="font-size:12px;color:var(--clr-text-muted);margin:0 0 16px;text-align:left;">Show this to your teacher's scanner to mark your attendance.</p>
                @if (_studentQr is not null)
                {
                    <img src="data:image/png;base64,@Convert.ToBase64String(_studentQr.QrCode)" alt="My attendance QR code"
                         style="width:100%;max-width:220px;image-rendering:pixelated;background:#fff;padding:8px;border-radius:12px;border:1px solid var(--clr-border);" />
                    <div style="font-size:11px;color:var(--clr-text-muted);margin-top:8px;font-family:Consolas,monospace;word-break:break-all;">@_studentQr.QrContent</div>
                    <button class="page-btn page-btn-outline" style="margin-top:14px;padding:8px 16px;font-size:13px;gap:6px;" @onclick="DownloadMyQrAsync">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Save as PNG
                    </button>
                    <p style="font-size:11px;color:var(--clr-text-muted);margin:12px 0 0;">Lost your printed card? Ask the school admin to reissue it — the old card will stop working.</p>
                }
                else
                {
                    <p style="font-size:13px;color:var(--clr-text-secondary);margin:24px 0;">No QR code has been issued to you yet. Please contact the school admin.</p>
                }
            </div>
        }

        @* ── Change Password ── *@
        <div class="page-card">
            <h3 style="font-size:16px;font-weight:700;color:var(--clr-text);margin:0 0 4px;">Change Password</h3>
            <p style="font-size:12px;color:var(--clr-text-muted);margin:0 0 16px;">Use at least 8 characters. You'll keep using your current username.</p>

            @if (_pwSuccess is not null)
            {
                <div style="padding:10px 14px;background:rgba(34,197,94,0.1);border:1px solid rgba(34,197,94,0.3);border-radius:8px;color:rgb(34,197,94);font-size:13px;font-weight:500;margin-bottom:16px;">@_pwSuccess</div>
            }
            @if (_pwError is not null)
            {
                <div class="error-banner" style="margin-bottom:16px;">@_pwError</div>
            }

            <div style="display:grid;grid-template-columns:1fr;gap:12px;max-width:420px;">
                <div>
                    <label class="field-label" for="tp-pw-current">Current password</label>
                    <input id="tp-pw-current" type="password" autocomplete="current-password" class="editable-input" @bind="_pwCurrent" />
                </div>
                <div>
                    <label class="field-label" for="tp-pw-new">New password</label>
                    <input id="tp-pw-new" type="password" autocomplete="new-password" class="editable-input" @bind="_pwNew" />
                </div>
                <div>
                    <label class="field-label" for="tp-pw-confirm">Confirm new password</label>
                    <input id="tp-pw-confirm" type="password" autocomplete="new-password" class="editable-input" @bind="_pwConfirm" />
                </div>
                <div>
                    <button class="page-btn page-btn-primary" style="padding:9px 18px;font-size:13px;gap:6px;" @onclick="ChangePasswordAsync" disabled="@_pwSaving">
                        @if (_pwSaving) { <span class="spinner" style="width:14px;height:14px;"></span> }
                        Update Password
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Styles ── *@
<style>
    .spinner {
        display: inline-block;
        border: 2px solid var(--clr-border);
        border-top-color: var(--clr-accent);
        border-radius: 50%;
        animation: _spin 0.6s linear infinite;
    }
    @@keyframes _spin { to { transform: rotate(360deg); } }
    .editable-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid var(--clr-border);
        border-radius: 8px;
        font-size: 14px;
        color: var(--clr-text);
        background: var(--clr-surface);
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.15s;
    }
    .editable-input:focus {
        border-color: var(--clr-accent);
    }
    .page-btn {
        display: inline-flex;
        align-items: center;
        cursor: pointer;
        border-radius: 6px;
        font-weight: 600;
        transition: background 0.15s, border-color 0.15s, opacity 0.15s;
    }
    .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    .page-btn-outline {
        background: transparent;
        border: 1.5px solid var(--clr-border-strong);
        color: var(--clr-text);
    }
    .page-btn-outline:hover:not(:disabled) {
        background: var(--clr-surface-alt);
        border-color: var(--clr-accent);
        color: var(--clr-accent);
    }
    .page-btn-primary {
        background: var(--clr-accent);
        border: 1.5px solid var(--clr-accent);
        color: var(--clr-accent-text);
    }
    .page-btn-primary:hover:not(:disabled) {
        opacity: 0.9;
    }
    .profile-pic-wrap:hover .profile-pic-overlay {
        opacity: 1 !important;
    }
</style>

<script>
    window._clickFileInput = function () {
        const el = document.querySelector('input[type="file"][accept="image/*"]');
        if (el) { el.value = ''; el.click(); }
    };
    window._readFileAsBase64 = function () {
        const el = document.querySelector('input[type="file"][accept="image/*"]');
        const file = el?.files?.[0];
        if (!file) return null;
        return new Promise(function (resolve) {
            var reader = new FileReader();
            reader.onload = function () { resolve(reader.result); };
            reader.readAsDataURL(file);
        });
    };
</script>

@code {
    private Teacher? _teacher;
    private Student? _student;
    private User? _user;
    private bool _loading = true;
    private bool _isEditing;
    private bool _isSaving;
    private bool _isUploading;
    private string? _error;
    private string? _success;
    private Teacher _editTeacher = new();
    private User _editUser = new();
    private StudentQr? _studentQr;
    private string _pwCurrent = "";
    private string _pwNew = "";
    private string _pwConfirm = "";
    private bool _pwSaving;
    private string? _pwError;
    private string? _pwSuccess;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        if (session is null) { Navigation.NavigateTo("/login"); return; }
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var session = await AuthService.GetCurrentSessionAsync();
            if (session is null) return;
            _user = await UserService.GetByIdAsync(session.UserId, _cts.Token);

            if (_user?.Role == UserRole.TEACHER)
            {
                _teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
                if (_teacher is null) _error = "Teacher profile not found.";
            }
            else if (_user?.Role == UserRole.STUDENT)
            {
                _student = await StudentPortalService.GetStudentByUserIdAsync(session.UserId, _cts.Token);
                if (_student is null) _error = "Student profile not found.";
                else _studentQr = await StudentService.GetQrCodeAsync(_student.Id, _cts.Token);
            }
        }
        catch (Exception ex) { _error = $"Failed to load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task TriggerFilePicker()
    {
        if (_isUploading) return;
        await JS.InvokeVoidAsync("_clickFileInput");
    }

    private async Task HandleFileSelected()
    {
        var dataUrl = await JS.InvokeAsync<string>("_readFileAsBase64");
        if (string.IsNullOrEmpty(dataUrl)) return;

        var base64 = dataUrl[(dataUrl.IndexOf(',') + 1)..];
        byte[] bytes;
        try { bytes = Convert.FromBase64String(base64); }
        catch { _error = "Failed to read image file."; return; }

        if (bytes.Length > 5 * 1024 * 1024)
        {
            _error = "Image must be smaller than 5 MB.";
            return;
        }

        _isUploading = true;
        _error = null;
        _success = null;
        try
        {
            var ok = await TeacherService.UpdateProfilePictureAsync(_teacher!.Id, bytes, _cts.Token);
            if (ok)
            {
                _teacher = await TeacherService.GetByUserIdAsync(_teacher.UserId, _cts.Token);
                _success = "Profile photo updated.";
            }
            else _error = "Failed to save photo.";
        }
        catch (Exception ex) { _error = $"Failed to upload photo: {ex.Message}"; }
        finally { _isUploading = false; }
    }

    private async Task TriggerStudentFilePicker()
    {
        if (_isUploading) return;
        await JS.InvokeVoidAsync("_clickFileInput");
    }

    private async Task HandleStudentFileSelected()
    {
        var dataUrl = await JS.InvokeAsync<string>("_readFileAsBase64");
        if (string.IsNullOrEmpty(dataUrl)) return;

        var base64 = dataUrl[(dataUrl.IndexOf(',') + 1)..];
        byte[] bytes;
        try { bytes = Convert.FromBase64String(base64); }
        catch { _error = "Failed to read image file."; return; }

        if (bytes.Length > 5 * 1024 * 1024)
        {
            _error = "Image must be smaller than 5 MB.";
            return;
        }

        _isUploading = true;
        _error = null;
        _success = null;
        try
        {
            var ok = await StudentPortalService.UpdateProfilePictureAsync(_student!.Id, bytes, _cts.Token);
            if (ok)
            {
                _student = await StudentPortalService.GetStudentByUserIdAsync(_student.UserId, _cts.Token);
                _success = "Profile photo updated.";
            }
            else _error = "Failed to save photo.";
        }
        catch (Exception ex) { _error = $"Failed to upload photo: {ex.Message}"; }
        finally { _isUploading = false; }
    }

    private void EnterEditMode()
    {
        if (_teacher is null || _user is null) return;
        _editTeacher = new Teacher
        {
            Id = _teacher.Id,
            FirstName = _teacher.FirstName,
            LastName = _teacher.LastName,
            MiddleName = _teacher.MiddleName,
            EmployeeNo = _teacher.EmployeeNo,
            Email = _teacher.Email,
            ContactNo = _teacher.ContactNo,
            Specialization = _teacher.Specialization,
            EmploymentStatus = _teacher.EmploymentStatus
        };
        _editUser = new User
        {
            Id = _user.Id,
            Name = _user.Name,
            Username = _user.Username
        };
        _isEditing = true;
        _success = null;
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editTeacher = new();
        _editUser = new();
    }

    private async Task SaveAsync()
    {
        if (_teacher is null || _user is null) return;
        _isSaving = true;
        _error = null;
        _success = null;

        try
        {
            _editTeacher.Id = _teacher.Id;
            var teacherOk = await TeacherService.UpdateAsync(_editTeacher, _cts.Token);

            _editUser.Id = _user.Id;
            _editUser.Role = _user.Role;
            _editUser.Status = _user.Status;
            _editUser.CanLogin = _user.CanLogin;
            var userOk = await UserService.UpdateAsync(_editUser, cancellationToken: _cts.Token);

            if (teacherOk && userOk)
            {
                _teacher = await TeacherService.GetByUserIdAsync(_user.Id, _cts.Token);
                _user = await UserService.GetByIdAsync(_user.Id, _cts.Token);
                _isEditing = false;
                _success = "Profile updated successfully.";
            }
            else
            {
                _error = "Failed to save changes.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to save: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DownloadMyQrAsync()
    {
        if (_student is null || _studentQr is null) return;
        var data = new
        {
            name = _student.FullName,
            lrn = _student.Lrn,
            studentNumber = _student.StudentNumber,
            qrBase64 = Convert.ToBase64String(_studentQr.QrCode),
            fileName = $"QR_{_student.LastName}_{_student.FirstName}_{_student.Lrn}".Replace(" ", "_")
        };
        await JS.InvokeVoidAsync("students.downloadQrAsPng", System.Text.Json.JsonSerializer.Serialize(data));
    }

    private async Task ChangePasswordAsync()
    {
        _pwError = null;
        _pwSuccess = null;

        if (_user is null) return;
        if (string.IsNullOrEmpty(_pwCurrent) || string.IsNullOrEmpty(_pwNew))
        {
            _pwError = "Enter your current and new password.";
            return;
        }
        if (_pwNew.Length < 8)
        {
            _pwError = "New password must be at least 8 characters.";
            return;
        }
        if (_pwNew != _pwConfirm)
        {
            _pwError = "New password and confirmation do not match.";
            return;
        }
        if (_pwNew == _pwCurrent)
        {
            _pwError = "New password must be different from the current one.";
            return;
        }

        _pwSaving = true;
        try
        {
            var ok = await UserService.ChangePasswordAsync(_user.Id, _pwCurrent, _pwNew, _cts.Token);
            if (!ok)
            {
                _pwError = "Current password is incorrect.";
                return;
            }

            await AuditService.LogAsync(_user.Id, _user.Username, _user.Role.ToString(), "PasswordChange", "User", _user.Id,
                $"{_user.Username} changed their password.", ct: _cts.Token);

            _pwCurrent = _pwNew = _pwConfirm = "";
            _pwSuccess = "Password updated. Use your new password next time you sign in.";
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _pwError = $"Failed to change password: {ex.Message}";
        }
        finally
        {
            _pwSaving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}