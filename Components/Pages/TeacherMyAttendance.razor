@page "/teacher/my-attendance"
@layout MainLayout
@using System.Globalization
@implements IAsyncDisposable
@inject ITeacherSessionService SessionService
@inject ITeacherService TeacherService
@inject IAuthService AuthService
@inject NavigationManager Navigation

<div style="height:100%;display:flex;flex-direction:column;">

    @* ── Header ── *@
    <div style="background:var(--clr-surface);border-bottom:1px solid var(--clr-border);box-shadow:var(--shadow-card);padding:32px 40px 28px;flex-shrink:0;">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
            <div>
                <h1 style="font-size:26px;font-weight:700;color:var(--clr-text);margin:0 0 4px;">My Attendance</h1>
                <p style="font-size:14px;color:var(--clr-text-secondary);margin:0;">Whether you held each of your scheduled classes</p>
            </div>
            <div style="display:flex;gap:12px;align-items:center;">
                <div style="display:flex;gap:8px;align-items:center;">
                    <div style="background:var(--clr-surface-alt);border-radius:8px;padding:6px 12px;display:flex;align-items:center;gap:8px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <input aria-label="From date" type="date" style="background:transparent;border:none;color:var(--clr-text);font-size:13px;outline:none;width:120px;"
                               @bind="_fromDate" @bind:after="LoadAsync" />
                    </div>
                    <span style="color:var(--clr-text-muted);font-size:13px;">—</span>
                    <div style="background:var(--clr-surface-alt);border-radius:8px;padding:6px 12px;display:flex;align-items:center;gap:8px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <input aria-label="To date" type="date" style="background:transparent;border:none;color:var(--clr-text);font-size:13px;outline:none;width:120px;"
                               @bind="_toDate" @bind:after="LoadAsync" />
                    </div>
                </div>
                <button class="btn" @onclick="ResetFilter" style="background:var(--clr-surface-alt);color:var(--clr-text-secondary);border:1px solid var(--clr-border);padding:6px 16px;font-size:13px;border-radius:8px;">
                    Reset
                </button>
            </div>
        </div>

        @if (!_loading && _error is null)
        {
            <div style="display:flex;gap:16px;margin-top:20px;flex-wrap:wrap;">
                <div style="flex:1;min-width:160px;background:var(--clr-surface);border:1px solid var(--clr-border);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow-card);">
                    <div style="width:36px;height:36px;border-radius:8px;background:rgba(99,102,241,0.2);display:flex;align-items:center;justify-content:center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-accent-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div>
                        <span style="font-size:20px;font-weight:700;color:var(--clr-text);display:block;">@_scheduledCount</span>
                        <span style="font-size:12px;color:var(--clr-text-secondary);">Scheduled</span>
                    </div>
                </div>
                <div style="flex:1;min-width:160px;background:var(--clr-surface);border:1px solid var(--clr-border);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow-card);">
                    <div style="width:36px;height:36px;border-radius:8px;background:rgba(34,197,94,0.15);display:flex;align-items:center;justify-content:center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <div>
                        <span style="font-size:20px;font-weight:700;color:var(--clr-text);display:block;">@_presentCount</span>
                        <span style="font-size:12px;color:var(--clr-text-secondary);">Present</span>
                    </div>
                </div>
                <div style="flex:1;min-width:160px;background:var(--clr-surface);border:1px solid var(--clr-border);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow-card);">
                    <div style="width:36px;height:36px;border-radius:8px;background:rgba(239,68,68,0.15);display:flex;align-items:center;justify-content:center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    </div>
                    <div>
                        <span style="font-size:20px;font-weight:700;color:var(--clr-text);display:block;">@_absentCount</span>
                        <span style="font-size:12px;color:var(--clr-text-secondary);">Absent</span>
                    </div>
                </div>
                <div style="flex:1;min-width:160px;background:var(--clr-surface);border:1px solid var(--clr-border);border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow-card);">
                    <div style="width:36px;height:36px;border-radius:8px;background:var(--clr-surface-alt);display:flex;align-items:center;justify-content:center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>
                    </div>
                    <div>
                        <span style="font-size:20px;font-weight:700;color:var(--clr-text);display:block;">@_rate%</span>
                        <span style="font-size:12px;color:var(--clr-text-secondary);">Attendance rate</span>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ── Body ── *@
    <div style="flex:1;overflow-y:auto;background:var(--clr-bg);padding:24px 40px;">
        @if (_loading)
        {
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 0;gap:16px;">
                <div class="spinner" style="width:32px;height:32px;"></div>
                <p style="color:var(--clr-text-secondary);font-size:14px;">Loading your attendance...</p>
            </div>
        }
        else if (_error is not null)
        {
            <div class="error-banner" style="margin:0;">@_error</div>
        }
        else if (_days.Count == 0)
        {
            <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 0;gap:12px;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" style="stroke:var(--clr-text-muted)" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <p style="font-size:15px;color:var(--clr-text-muted);font-weight:500;">No scheduled classes</p>
                <p style="font-size:13px;color:var(--clr-text-muted);">You have no classes scheduled in the selected date range.</p>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:20px;">
                @foreach (var day in _days)
                {
                    <div>
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                            <span style="font-size:14px;font-weight:700;color:var(--clr-text);">@day.Date.ToString("dddd, MMM dd", CultureInfo.InvariantCulture)</span>
                            @if (day.Date == DateOnly.FromDateTime(DateTime.Today))
                            {
                                <span style="font-size:11px;font-weight:600;color:var(--clr-accent-light);background:rgba(99,102,241,0.15);padding:2px 8px;border-radius:5px;">Today</span>
                            }
                            <span style="flex:1;height:1px;background:var(--clr-border);"></span>
                        </div>

                        <div style="display:flex;flex-direction:column;gap:8px;">
                            @foreach (var cls in day.Classes)
                            {
                                var (badgeBg, badgeText, label) = StatusStyle(cls.Status);
                                <div style="display:flex;align-items:center;gap:16px;padding:14px 18px;background:var(--clr-surface);border:1px solid var(--clr-border);border-radius:10px;box-shadow:var(--shadow-card);">
                                    <div style="min-width:120px;font-size:13px;color:var(--clr-text-muted);font-weight:500;">
                                        @cls.StartTime.ToString("h\\:mm tt") – @cls.EndTime.ToString("h\\:mm tt")
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <div style="font-size:14px;font-weight:600;color:var(--clr-text);">@cls.SectionName</div>
                                        <div style="font-size:12px;color:var(--clr-text-muted);">
                                            @cls.SubjectName@(!string.IsNullOrEmpty(cls.Room) ? $" · Room {cls.Room}" : "")
                                        </div>
                                    </div>
                                    @if (cls.HeldAt is not null)
                                    {
                                        <span style="font-size:12px;color:var(--clr-text-muted);">Held @cls.HeldAt.Value.ToString("h:mm tt")</span>
                                    }
                                    <span style="display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:4px 12px;border-radius:6px;background:@badgeBg;color:@badgeText;white-space:nowrap;">@label</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .spinner {
        display: inline-block;
        border: 2px solid var(--clr-border);
        border-top-color: var(--clr-accent);
        border-radius: 50%;
        animation: _spin 0.6s linear infinite;
    }
    @@keyframes _spin { to { transform: rotate(360deg); } }
</style>

@code {
    private List<TeacherAttendanceDay> _days = [];
    private bool _loading = true;
    private string? _error;
    private long _teacherId;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private int _scheduledCount;
    private int _presentCount;
    private int _absentCount;
    private int _rate;

    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentSessionAsync();
        if (session is null) { Navigation.NavigateTo("/login"); return; }

        var teacher = await TeacherService.GetByUserIdAsync(session.UserId, _cts.Token);
        if (teacher is null) { _error = "Teacher profile not found."; _loading = false; return; }

        _teacherId = teacher.Id;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            DateOnly? from = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : null;
            DateOnly? to = _toDate.HasValue ? DateOnly.FromDateTime(_toDate.Value) : null;

            _days = await SessionService.GetTeacherAttendanceAsync(_teacherId, from, to, _cts.Token);

            var all = _days.SelectMany(d => d.Classes).ToList();
            _presentCount = all.Count(c => c.Status == "PRESENT");
            _absentCount = all.Count(c => c.Status == "ABSENT");
            // "Scheduled" counts classes whose time has passed (present + absent) — the ones that count toward the rate.
            _scheduledCount = _presentCount + _absentCount;
            _rate = _scheduledCount > 0 ? (int)Math.Round((double)_presentCount / _scheduledCount * 100) : 0;
        }
        catch (Exception ex) { _error = $"Failed to load: {ex.Message}"; }
        finally { _loading = false; }
    }

    private async Task ResetFilter()
    {
        _fromDate = null;
        _toDate = null;
        await LoadAsync();
    }

    private static (string bg, string text, string label) StatusStyle(string status) => status switch
    {
        "PRESENT" => ("rgba(34,197,94,0.15)", "#16a34a", "Present"),
        "ABSENT" => ("rgba(239,68,68,0.15)", "#dc2626", "Absent"),
        _ => ("var(--clr-surface-alt)", "var(--clr-text-muted)", "Upcoming")
    };

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        await Task.CompletedTask;
    }
}
